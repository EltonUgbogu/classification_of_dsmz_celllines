               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS)

# Legacy: Pan-cancer UMAP using joint HVG list (kept for backwards compatibility)
PAN_CANCER_UMAP_OUTDIR = os.path.join(BASE, "results", "unsupervised", "pan_cancer", "umap")

rule pan_cancer_umap_hvg:
    input:
        config = CFGFILE_ABS
    output:
        coords = os.path.join(PAN_CANCER_UMAP_OUTDIR, "pan_cancer_hvg_umap_coords.tsv"),
        plot = os.path.join(PAN_CANCER_UMAP_OUTDIR, "pan_cancer_hvg_umap_plot.pdf")
    params:
        profiles = "brca,nbl,rbl",  # Can be overridden via --config
        outdir = PAN_CANCER_UMAP_OUTDIR,
        n_pcs = 50,
        n_neighbors = 15,
        min_dist = 0.1
    log: os.path.join(BASE, "logs", "pan_cancer_umap_hvg.log")
    conda: CONDA_ENV_R
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pan_cancer_umap_hvg.R \
          --config {input.config} \
          --profiles {params.profiles} \
          --outdir {params.outdir} \
          --n_pcs {params.n_pcs} \
          --n_neighbors {params.n_neighbors} \
          --min_dist {params.min_dist} \
          > {log} 2>&1
        '''
# ==============================================================================
# DEBUG / MAINTENANCE TARGETS
# ==============================================================================

# Smoke test: minimal validation (run explicitly: ./run_pipeline.sh ... smoke_test)
rule smoke_test:
    input:
        cfg = CFGFILE_ABS
    output:
        touch(os.path.join(LOGROOT, "smoke_test.done"))
    log:
        os.path.join(LOGROOT, "smoke_test.log")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output}")" "$(dirname "{log}")"
        {
            echo "[SMOKE TEST] Pipeline root: {BASE}"
            echo "[SMOKE TEST] Profile: {profile_name}"
            echo "[SMOKE TEST] Config: {input.cfg}"
            echo "[SMOKE TEST] Log root: {LOGROOT}"
            [ -f "{input.cfg}" ] || { echo "ERROR: Config not found"; exit 1; }
            grep -q "^  {profile_name}:" "{input.cfg}" || { echo "ERROR: Profile not found"; exit 1; }
            echo "[SMOKE TEST] SUCCESS"
        } | tee "{log}"
        touch "{output}"
        '''
