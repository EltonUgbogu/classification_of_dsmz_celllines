          > {log} 2>&1
        '''

rule pan_resolve_dsmz_graph_neighbors:
    input:
        # Pan-cancer graphs: use "within" mode (same-cancer-type only) for better separation
        # Note: graph files are discovered dynamically by the script, so we don't require them all here
        graph_dummy = expand(
            os.path.join(PAN_GRAPH_ROOT, "within", "{direction}",
                        "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
            direction=PAN_CANCER_DIRECTIONS
        ),
        # Optional: winners file for cell-line-specific representation selection
        winners_frac = rules.pan_summarize_p_consensus_all.output.winners_frac,
        cfg = CFGFILE_ABS
    output:
        resolved_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "resolved_dsmz_neighbors.tsv")
    params:
        script = os.path.join(BASE, "scripts", "resolve_dsmz_graph_neighbors.R"),
        mode = "intersection",  # or "kofn" for k-of-n mode
        k = 2,  # minimum reps for kofn mode
        graph_root = os.path.join(PAN_GRAPH_ROOT, "within")  # Pan-cancer graphs: use "within" mode for same-cancer-type only
    log: os.path.join(PAN_LOGROOT, "resolve_dsmz_graph_neighbors.log")
    conda: CONDA_ENV_R
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        Rscript {params.script} \
          --config {input.cfg} \
          --profile "pan_cancer" \
          --winners_tsv {input.winners_frac} \
          --mode {params.mode} \
          --k {params.k} \
          --graph_root {params.graph_root} \
          --output_tsv {output.resolved_tsv} \
          > {log} 2>&1
        '''

rule pan_visualize_resolved_dsmz_graph:
    input:
        resolved_tsv = rules.pan_resolve_dsmz_graph_neighbors.output.resolved_tsv,
        metadata_tsv = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg = CFGFILE_ABS
    output:
        fig_png = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_dsmz_cellline_graph.png"),
        fig_pdf = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_dsmz_cellline_graph.pdf"),
        edges_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "dsmz_cellline_graph_edges.tsv"),
        node_stats_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "dsmz_cellline_graph_node_stats.tsv")
    params:
        script = os.path.join(BASE, "scripts", "visualize_resolved_dsmz_graph.py"),
        cancer_type = "Pan-Cancer"
    log: os.path.join(PAN_LOGROOT, "visualize_resolved_dsmz_graph.log")
    conda: CONDA_ENV_PY
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        # Use Python from the activated conda environment
        # $CONDA_PREFIX should be set by Snakemake's conda activation
        if [ -n "$CONDA_PREFIX" ] && [ -f "$CONDA_PREFIX/bin/python" ]; then
            PYTHON_CMD="$CONDA_PREFIX/bin/python"
        else
            PYTHON_CMD=python
        fi
        $PYTHON_CMD {params.script} \
          {input.resolved_tsv} \
          {PAN_P_CONS_ALL_DIR}/Fig_dsmz_cellline_graph \
          {params.cancer_type} \
          {input.metadata_tsv} \
          > {log} 2>&1
        '''

# Target rule for pan-cancer "like per-disease" pipeline
rule pan_cancer_like_per_disease_targets:
    input:
        # all 6 clusterings per direction
        expand(pan_agn_out("{direction}", "hc", "cell"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "hc", "tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "hc", "cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "cell"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        # consensus per direction
        expand(pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        # final p-consensus per direction
        expand(pan_tnh_final("{direction}", "rds"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_tnh_final("{direction}", "tsv"), direction=PAN_CANCER_DIRECTIONS),
        # DSMZ-DSMZ similarity graphs (both global and within modes)
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS),
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_{direction}.graphml"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS),
        # Pan-cancer final_consensus_all outputs
        rules.pan_summarize_p_consensus_all.output.fig_pdf,
        rules.pan_plot_winners_by_frac_ge_thr.output.fig_pdf,
        rules.pan_resolve_dsmz_graph_neighbors.output.resolved_tsv,
        rules.pan_visualize_resolved_dsmz_graph.output.fig_pdf

