# -----------------------------------------------------------------------------
# RULE: agnostic_cluster_all
#
# Purpose:
#   This is a collector rule. It does not perform a new analysis itself.
#   Instead, it asks Snakemake to build every clustering result that belongs to
#   the active direction set and clustering kinds.
#
# Why collector rules are useful:
#   They provide one clean target that stands for 'finish this whole stage'.
# -----------------------------------------------------------------------------
rule agnostic_cluster_all:
    """
    Convenience aggregation rule that collects all HC and k-means cluster outputs
    across every direction. Allows the full Stage 1 suite to be run independently
    via 'snakemake agnostic_cluster_all' without proceeding to consensus.
    """
    input:
        expand(os.path.join(AGN_ROOT_REL, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_DIRECTIONS, kind=HC_KINDS),
        expand(os.path.join(AGN_ROOT_REL, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_EUC_DIRECTIONS, kind=KM_KINDS)


# =============================================================================
# STAGE 2: CONSENSUS CLUSTERING
# =============================================================================

# Defines consensus output root and clustering kind identifiers.
# PCA-containing kinds are stripped when DISABLE_PCA_EVERYWHERE is set.
CONS_ROOT_REL = os.path.join(UNSUP_REL, "consensus")
CONS_ROOT     = os.path.join(UNSUP,     "consensus")
CONS_KM_KINDS = ["ccp_kmeans_expr_cell_tumour", "ccp_kmeans_pca_cell_tumour", "ccp_kmeans_expr_cell", "ccp_kmeans_pca_cell", "ccp_kmeans_expr_tumour", "ccp_kmeans_pca_tumour"]
CONS_HC_KINDS = ["ccp_hc_expr_cell_tumour", "ccp_hc_pca_cell_tumour", "ccp_hc_expr_cell", "ccp_hc_pca_cell", "ccp_hc_expr_tumour", "ccp_hc_pca_tumour"]

if DISABLE_PCA_EVERYWHERE:
    CONS_KM_KINDS = [k for k in CONS_KM_KINDS if "_pca_" not in k]
    CONS_HC_KINDS = [k for k in CONS_HC_KINDS if "_pca_" not in k]
    vprint(f"[Snakefile] Filtered PCA consensus kinds: CONS_KM_KINDS={CONS_KM_KINDS}, CONS_HC_KINDS={CONS_HC_KINDS}")

# Builds a single regex pattern covering all consensus kind identifiers for wildcard validation.
CONS_KIND_PATTERN = "|".join(map(re.escape, CONS_KM_KINDS + CONS_HC_KINDS))


def cons_outdir(direction, kind):
    """Returns the absolute output directory for a consensus direction–kind combination."""
    return os.path.join(CONS_ROOT, direction, kind)


def kind_to_mode(kind):
    """Extracts the feature mode (pca or expr) from a consensus kind identifier."""
    return "pca" if "_pca_" in kind else "expr"


def kind_to_alg(kind):
    """Extracts the clustering algorithm (hc or km) from a consensus kind identifier."""
    return "hc" if kind.startswith("ccp_hc_") else "km"


# -----------------------------------------------------------------------------
# RULE: consensus_cluster_ccp
#
# Purpose:
#   Take the clustering results from the previous stage and summarize them into
#   consensus-clustering outputs for one direction.
#
# Intuition:
#   Instead of trusting a single clustering view, consensus clustering measures
#   how stable the grouping is across related clustering runs.
# -----------------------------------------------------------------------------
rule consensus_cluster_ccp:
    """
    Runs ConsensusClusterPlus on the joint cell line and tumour expression matrix
    for a given direction and kind. Resampling-based consensus stabilises cluster
    assignments that are sensitive to initialisation in single-run methods.
    Mode (pca/expr) and algorithm (hc/km) are inferred from the kind wildcard,
    allowing a single rule to cover all twelve consensus variants per direction.
    """
    input:
        config   = CFGFILE_ABS,
        # Uses the canonical MX gene list as the HVG500 set for all consensus runs.
        hvg_list = os.path.join(FEATURESETS_DIR_REL, f"genes_top{TOPN}_MX.txt")
    output:
        cluster_rds = os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds")
    params:
        outdir = lambda wc: cons_outdir(wc.direction, wc.kind),
        mode   = lambda wc: kind_to_mode(wc.kind),
        alg    = lambda wc: kind_to_alg(wc.kind)
    log: os.path.join(LOGROOT, "consensus_cluster_{direction}_{kind}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction=CONS_DIRECTION_PATTERN,
        kind=CONS_KIND_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/consensus_ccp_cell_tumour.R \
          --config {input.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --hvg_list {input.hvg_list} \
          --kind {wildcards.kind} \
          --mode {params.mode} \
          --alg {params.alg} \
          --outdir {params.outdir} \
          --cluster_rds {output.cluster_rds} > {log} 2>&1
        '''


# -----------------------------------------------------------------------------
# RULE: consensus_cluster_all
#
# Purpose:
#   Another collector rule. It makes Snakemake build all consensus outputs across
#   the configured directions for the active profile.
# -----------------------------------------------------------------------------
rule consensus_cluster_all:
    """
    Convenience aggregation rule that collects all consensus cluster outputs
    across every direction and kind. HC kinds run on all directions; k-means
    kinds are constrained to Euclidean directions only.
    """
    input:
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_DIRECTIONS, kind=CONS_HC_KINDS),
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_EUC_DIRECTIONS, kind=CONS_KM_KINDS)


# =============================================================================
# STAGE 3: TUMOUR NEIGHBOURHOOD INPUT CONSTRUCTION
# =============================================================================

TUMOUR_NH_ROOT     = os.path.join(UNSUP_REL, "tumour_neighbourhoods")
# Absolute counterpart used in shell find commands to ensure correctness on HPC
# nodes where the job working directory may differ from PIPE_ROOT.
TUMOUR_NH_ROOT_ABS = os.path.join(UNSUP,     "tumour_neighbourhoods")

# Resolves HVG neighbourhood input paths (absolute; always present).
TUMOUR_NH_EXPR_HVG    = os.path.join(TUMOUR_NH_INPUT_ROOT, "expr_hvg.rds")
TUMOUR_NH_MAP_RDS_HVG = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_hvg.rds")

# Resolves PAM50 neighbourhood input paths (absolute; conditional on use_pam50).
if USE_PAM50:
    TUMOUR_NH_EXPR_PAM50    = os.path.join(TUMOUR_NH_INPUT_ROOT, "expr_pam50.rds")
    TUMOUR_NH_MAP_RDS_PAM50 = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_pam50.rds")
else:
    TUMOUR_NH_EXPR_PAM50    = None
# Beginner note:
# This section shifts from clustering to tumour-neighbourhood analysis.
# Upstream clustering results are now treated as evidence that helps define
# neighbourhood relationships between cell lines and tumours.

    TUMOUR_NH_MAP_RDS_PAM50 = None


def nh_expr_rds(direction):
    """
    Returns the absolute path to the expression submatrix RDS for a direction.
    Routes PAM50 directions to their dedicated matrix, HVG/MX directions to the
    canonical HVG expression file, and all other feature-set directions to their
    method-specific submatrix in the featuresets staging directory.
    """
    feature = dir_to_feature(direction)
    if feature == "pam50":
        if TUMOUR_NH_EXPR_PAM50:
            return TUMOUR_NH_EXPR_PAM50
        raise ValueError("PAM50 expression path missing while use_pam50 is enabled")
    elif feature == "hvg":
        return TUMOUR_NH_EXPR_HVG
    else:
        return os.path.join(FEATURE_METHOD_OUTDIR, feature, "expr_submatrix.rds")


def nh_map_rds(direction):
    """
    Returns the absolute path to the cell-line-to-sample-ID mapping RDS for a direction.
    Mapping files associate DSMZ cell line identifiers with the original VST sample IDs
    used in the tumour neighbourhood computation.
    """
    feature = dir_to_feature(direction)
    if feature == "pam50":
        if TUMOUR_NH_MAP_RDS_PAM50:
            return TUMOUR_NH_MAP_RDS_PAM50
        raise ValueError("PAM50 map path missing while use_pam50 is enabled")
    elif feature == "hvg":
        return TUMOUR_NH_MAP_RDS_HVG
    else:
        return os.path.join(TUMOUR_NH_INPUT_ROOT, f"cell_line_to_original_sample_id_{feature}.rds")


# Path helper functions for tumour neighbourhood outputs (single source of truth).
def nh_final_consensus_rds(direction):
    return os.path.join(
        TUMOUR_NH_ROOT, direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{direction}.rds"
    )

def nh_qc_dir(direction):
    return os.path.join(TUMOUR_NH_ROOT, direction, "qc")

def nh_qc_tsv(direction):
    return os.path.join(nh_qc_dir(direction), "nh_qc_summary.tsv")

def nh_umap_tsv(direction):
    return os.path.join(nh_qc_dir(direction), "nh_umap.tsv")

def nh_umap_pdf(direction):
    return os.path.join(nh_qc_dir(direction), "nh_umap.pdf")


if USE_PAM50:
    # Resolves PAM50 expression matrix paths before instantiating the rule.
    # Prefers profile-specific keys (tcga_brca_pam50_expr, dsmz_bcc_pam50_expr);
    # falls back to generic keys; raises a clear error rather than a bare KeyError
    # if neither is present — catching config omissions at parse time.
    _pam50_paths = cfg.get("paths", {})
    if "tcga_brca_pam50_expr" in _pam50_paths:
        _TCGA_PAM50_PATH = cfgabs("paths", "tcga_brca_pam50_expr")
    elif "tcga_pam50_expr" in _pam50_paths:
        _TCGA_PAM50_PATH = cfgabs("paths", "tcga_pam50_expr")
    else:
        raise ValueError(
            f"Profile '{profile_name}' has use_pam50=true but neither "
            "paths.tcga_brca_pam50_expr nor paths.tcga_pam50_expr is set in config. "
            "BRCA PAM50 tumour-neighbourhood analysis requires configured PAM50 "
            "expression matrices (paths.tcga_brca_pam50_expr or paths.tcga_pam50_expr)."
        )
    if "dsmz_bcc_pam50_expr" in _pam50_paths:
        _DSMZ_PAM50_PATH = cfgabs("paths", "dsmz_bcc_pam50_expr")
    elif "dsmz_pam50_expr" in _pam50_paths:
        _DSMZ_PAM50_PATH = cfgabs("paths", "dsmz_pam50_expr")
    else:
# -----------------------------------------------------------------------------
# RULE: tumour_nh_build_inputs_hvg
#
# Purpose:
#   Build the expression matrix and mapping files needed for tumour-neighbourhood
#   analysis when using the canonical HVG/MX gene set.
#
# Why a separate prep rule exists:
#   The tumour-neighbourhood scripts need a very specific input format, so this
#   rule transforms the general joint VST matrix into that format.
# -----------------------------------------------------------------------------
        raise ValueError(
            f"Profile '{profile_name}' has use_pam50=true but neither "
            "paths.dsmz_bcc_pam50_expr nor paths.dsmz_pam50_expr is set in config. "
            "BRCA PAM50 tumour-neighbourhood analysis requires configured PAM50 "
            "expression matrices (paths.dsmz_bcc_pam50_expr or paths.dsmz_pam50_expr)."
        )

    rule tumour_nh_build_inputs_pam50:
        """
        Constructs the joint PAM50 expression matrix and cell-line-to-sample mapping
        file from pre-computed PAM50-scored TCGA and DSMZ expression tables.
        Only instantiated when use_pam50 is enabled for the current profile.
        """
        input:
            tcga_pam50 = _TCGA_PAM50_PATH,
            dsmz_pam50 = _DSMZ_PAM50_PATH,
            dsmz_meta  = cfgget_path_abs(cfgrel("paths", "meta_tsv"), "paths", "dsmz_meta_csv")
        output:
            expr_rds = TUMOUR_NH_EXPR_PAM50,
            map_rds  = TUMOUR_NH_MAP_RDS_PAM50
        log: os.path.join(LOGROOT, "tumour_nh_build_inputs_pam50.log")
        conda: CONDA_ENV_R
        shell:
            r'''
            mkdir -p $(dirname {output.expr_rds}) $(dirname {output.map_rds})
            Rscript {SCRIPTS_DIR}/build_dsmz_tcga_pam50matrix.R --config {CFGFILE_ABS} --profile "{profile_name}" > {log} 2>&1
            test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
            test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
            '''


rule tumour_nh_build_inputs_hvg:
    """
    Constructs the joint HVG expression submatrix and cell-line-to-sample mapping
# -----------------------------------------------------------------------------
# RULE: tumour_nh_build_inputs_featureset
#
# Purpose:
#   Same idea as the HVG input builder, but now for any feature-set direction
#   such as Variance, MAD, PCA, Entropy, Spearman, MX, or kTotal.
# -----------------------------------------------------------------------------
    from the VST-normalised joint matrix, subsetting to the canonical MX top-N gene list.
    Produces the primary input files for all HVG-direction tumour neighbourhood rules.
    """
    input:
        vst       = VST_JOINT,
        gene_list = os.path.join(FEATURESETS_DIR_REL, f"genes_top{TOPN}_MX.txt"),
        dsmz_meta = cfgget_path_abs(cfgrel("paths", "meta_tsv"), "paths", "dsmz_meta_csv"),
        cfg       = CFGFILE_ABS
    output:
        expr_rds = TUMOUR_NH_EXPR_HVG,
        map_rds  = TUMOUR_NH_MAP_RDS_HVG
    params:
        direction = "hvg"
    log: os.path.join(LOGROOT, "tumour_nh_build_inputs_hvg.log")
    conda: CONDA_ENV_R
    shell:
        r'''
        mkdir -p $(dirname {output.expr_rds})
        Rscript {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R \
          --config {input.cfg} \
          --vst {input.vst} \
          --gene-list {input.gene_list} \
          --dsmz-meta {input.dsmz_meta} \
          --expr-out {output.expr_rds} \
          --map-out {output.map_rds} \
          --direction {params.direction} > {log} 2>&1
        test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
        test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
        '''


rule tumour_nh_build_inputs_featureset:
    """
    Constructs the joint expression submatrix and cell-line-to-sample mapping for
    a given feature method, subsetting to the corresponding top-N gene list produced
    by feature_selection_unsupervised. Parameterised over the feature wildcard to
    cover all eight methods without duplication. Uses the explicit conda Rscript
    binary to avoid environment PATH ambiguity on HPC nodes.
    """
    input:
        vst       = VST_JOINT,
        gene_list = lambda wc: os.path.join(FEATURESETS_DIR_REL, f"genes_top{method_topn(wc.feature)}_{wc.feature}.txt"),
        dsmz_meta = cfgget_path_abs(cfgrel("paths", "meta_tsv"), "paths", "dsmz_meta_csv"),
        cfg       = CFGFILE_ABS
    output:
# -----------------------------------------------------------------------------
# RULE: tumour_nh_hc_hvg
#
# Purpose:
#   Run tumour-neighbourhood analysis for HVG-based directions using hierarchical
#   clustering outputs as explicit upstream dependencies.
#
# Interpretation:
#   This stage asks which tumours repeatedly appear near a given cell line under
#   one clustering direction.
# -----------------------------------------------------------------------------
        expr_rds = os.path.join(FEATURE_METHOD_OUTDIR, "{feature}", "expr_submatrix.rds"),
        map_rds  = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_{feature}.rds")
    log: os.path.join(LOGROOT, "tumour_nh_build_inputs_{feature}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        feature="|".join(map(re.escape, FEATURE_METHODS))
    shell:
        r'''
        mkdir -p $(dirname {output.expr_rds}) $(dirname {output.map_rds})
        echo "[DEBUG] CONDA_PREFIX=${{CONDA_PREFIX:-NA}}" >> {log} 2>&1
        which Rscript >> {log} 2>&1
        Rscript --version >> {log} 2>&1
        echo "[DEBUG] Script path: {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R" >> {log} 2>&1
        ls -lh {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R >> {log} 2>&1
        "${{CONDA_PREFIX}}/bin/Rscript" --vanilla {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R \
          --config {input.cfg} \
          --vst {input.vst} \
          --gene-list {input.gene_list} \
          --dsmz-meta {input.dsmz_meta} \
          --expr-out {output.expr_rds} \
          --map-out {output.map_rds} \
          --direction {wildcards.feature} >> {log} 2>&1
        test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
        test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
        '''


# =============================================================================
# STAGE 4: TUMOUR NEIGHBOURHOOD ANALYSIS
# =============================================================================

rule tumour_nh_hc_hvg:
    """
    Computes per-cell-line tumour neighbourhoods for HVG directions using
    hierarchical nearest-neighbour ranking. Produces Top_m_long_*.csv files
    encoding ranked tumour proximity scores for each DSMZ cell line.
    A sentinel .done file is written only after output validation, preventing
    downstream consensus rules from proceeding on empty or truncated results.
    Constrained to hvg_euc and hvg_corr to avoid DAG ambiguity with the
    PAM50 and feature-set neighbourhood rules.
    """
    input:
        expr_rds    = TUMOUR_NH_EXPR_HVG,
        map_rds     = TUMOUR_NH_MAP_RDS_HVG,
        cfg_file    = CFGFILE_ABS,
        cluster_rds = lambda wc: expand(
            os.path.join(CONS_ROOT, wc.direction, "{kind}", "{kind}_clusters_optimal.rds"),
            kind=CONS_HC_KINDS
        )
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
    params:
        script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R")
    log: os.path.join(LOGROOT, "tumour_nh_hc_{direction}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction="hvg_euc|hvg_corr"
    shell:
        r'''
        mkdir -p $(dirname {output.done})
        Rscript {params.script} \
          --config "{input.cfg_file}" \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --expr-rds {input.expr_rds} \
          --mapping-rds {input.map_rds} \
          > {log} 2>&1
        test $(find {TUMOUR_NH_ROOT_ABS}/{wildcards.direction} -maxdepth 2 -type f -name "Top_m_long_*.csv" | wc -l) -gt 0 || (echo "ERROR: No Top_m_long_*.csv" >&2 && exit 1)
        touch {output.done}
        '''


# -----------------------------------------------------------------------------
# RULE: tumour_nh_hc_featureset
#
# Purpose:
#   Run tumour-neighbourhood analysis for non-HVG feature-set directions using
#   hierarchical clustering outputs for the same direction.
# -----------------------------------------------------------------------------
if USE_PAM50:
    rule tumour_nh_hc_pam50:
        """
        Computes per-cell-line tumour neighbourhoods for PAM50 directions.
        Constrained to pam50_euc and pam50_corr wildcards to avoid DAG ambiguity
        with the HVG and feature-set neighbourhood rules. Only instantiated
        when use_pam50 is enabled.
        """
        input:
            expr_rds    = TUMOUR_NH_EXPR_PAM50,
            map_rds     = TUMOUR_NH_MAP_RDS_PAM50,
            cfg_file    = CFGFILE_ABS,
            cluster_rds = lambda wc: expand(
                os.path.join(CONS_ROOT, wc.direction, "{kind}", "{kind}_clusters_optimal.rds"),
                kind=CONS_HC_KINDS
            )
        output:
            done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
        params:
            script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R")
        log: os.path.join(LOGROOT, "tumour_nh_hc_{direction}.log")
        conda: CONDA_ENV_R
        wildcard_constraints:
            direction="pam50_euc|pam50_corr"
        shell:
            r'''
            mkdir -p $(dirname {output.done})
            Rscript {params.script} \
              --config "{input.cfg_file}" \
              --profile "{profile_name}" \
              --direction {wildcards.direction} \
              --expr-rds {input.expr_rds} \
              --mapping-rds {input.map_rds} \
              > {log} 2>&1
# -----------------------------------------------------------------------------
# RULE: tumour_nh_km_euc
#
# Purpose:
#   Run tumour-neighbourhood analysis based on Euclidean k-means directions.
#
# Important detail:
#   Only Euclidean directions are used here because this rule is constrained to
#   the consensus Euclidean direction pattern.
# -----------------------------------------------------------------------------
            test $(find {TUMOUR_NH_ROOT_ABS}/{wildcards.direction} -maxdepth 2 -type f -name "Top_m_long_*.csv" | wc -l) -gt 0 || (echo "ERROR: No Top_m_long_*.csv" >&2 && exit 1)
            touch {output.done}
            '''


rule tumour_nh_hc_featureset:
    """
    Computes per-cell-line tumour neighbourhoods for all non-HVG, non-PAM50
    feature-set directions. Uses lambda inputs to resolve direction-specific
    expression and mapping paths at DAG evaluation time. Constrained to the
    FEATURE_SET_DIR_PATTERN regex to avoid overlap with HVG and PAM50 rules.
    """
    input:
        expr_rds    = lambda wc: nh_expr_rds(wc.direction),
        map_rds     = lambda wc: nh_map_rds(wc.direction),
        cfg_file    = CFGFILE_ABS,
        cluster_rds = lambda wc: expand(
            os.path.join(CONS_ROOT, wc.direction, "{kind}", "{kind}_clusters_optimal.rds"),
            kind=CONS_HC_KINDS
        )
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
    params:
        script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R")
    log: os.path.join(LOGROOT, "tumour_nh_hc_{direction}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction=FEATURE_SET_DIR_PATTERN
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output.rds}")"

        Rscript "{SCRIPTS_DIR}/tumour_neighbourhood_p_consensus.R" \
          --config "{input.cfg}" \
          --profile "{profile_name}" \
          --direction "{wildcards.direction}" \
          --workdir "{BASE}" \
          --ccp_hc_rds "{input.ccp_hc}" \
          --ccp_kmeans_rds "{input.ccp_km}" \
          --meta_tsv "{input.meta}" \
          --out_rds "{output.rds}" \
          --out_tsv "{output.tsv}" \
          2>&1 | tee "{log}"
        '''

rule tumour_nh_km_euc:
    """
    Extends the tumour neighbourhood analysis to include k-means cluster-based
    neighbourhoods for Euclidean directions. Depends on the HC sentinel file to
    ensure HC-based neighbourhood files are present before the k-means pass runs,
    as both passes write into the same direction output directory. Constrained to
    Euclidean directions only, consistent with the k-means distance restriction
    applied throughout Stage 1.
    """
    input:
        hc_done     = os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"),
        expr_rds    = lambda wc: nh_expr_rds(wc.direction),
        map_rds     = lambda wc: nh_map_rds(wc.direction),
        cfg_file    = CFGFILE_ABS,
        cluster_rds = lambda wc: expand(
            os.path.join(CONS_ROOT, wc.direction, "{kind}", "{kind}_clusters_optimal.rds"),
            kind=CONS_KM_KINDS
        )
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_km_done"))
    params:
        script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R")
    log: os.path.join(LOGROOT, "tumour_nh_km_euc_{direction}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction=CONS_EUC_PATTERN
    shell:
        r'''
        Rscript {params.script} \
          --config "{input.cfg_file}" \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --expr-rds {input.expr_rds} \
          --mapping-rds {input.map_rds} \
          > {log} 2>&1
        touch {output.done}
        '''


# =============================================================================
# STAGE 4 (CONTINUED): PROBABILISTIC NEIGHBOURHOOD CONSENSUS
# =============================================================================

rule tumour_nh_consensus_hvg:
    """
    Aggregates per-cell-line tumour neighbourhood rankings across all clustering
    solutions for HVG directions into a single probabilistic consensus assignment.
    Output RDS and TSV files encode the final consensus neighbourhood per cell line,
    consumed by scoring and visualisation rules. Constrained to hvg_euc and hvg_corr.
    """
    input:
        hc_done = os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done")
    output:
        consensus_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.rds"),
        consensus_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.tsv")
    params:
        script = os.path.join(BASE, "scripts", "tumour_neighbourhood_p_consensus.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(LOGROOT, "tumour_nh_consensus_{direction}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction="hvg_euc|hvg_corr"
    shell:
        r'''
        mkdir -p $(dirname {output.consensus_rds})
        Rscript {params.script} \
          --config {params.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --workdir {BASE} \
          > {log} 2>&1
        '''


if USE_PAM50:
    rule tumour_nh_consensus_pam50:
        """
        Aggregates tumour neighbourhood rankings for PAM50 directions into a
        probabilistic consensus assignment. Passes explicit output paths to the
        R script rather than relying on workdir inference. Only instantiated
        when use_pam50 is enabled.
        """
        input:
            hc_done = os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done")
        output:
            consensus_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.rds"),
            consensus_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.tsv")
        params:
            script = os.path.join(BASE, "scripts", "tumour_neighbourhood_p_consensus.R"),
            config = os.path.join(BASE, "config", "config.yaml")
        log: os.path.join(LOGROOT, "tumour_nh_consensus_{direction}.log")
        conda: CONDA_ENV_R
        wildcard_constraints:
            direction="pam50_euc|pam50_corr"
        shell:
            r'''
            mkdir -p $(dirname {output.consensus_rds})
            Rscript {params.script} \
              --config {params.config} \
              --profile "{profile_name}" \
              --direction {wildcards.direction} \
              --out_rds {output.consensus_rds} \
              --out_tsv {output.consensus_tsv} \
              > {log} 2>&1
            '''


rule tumour_nh_consensus_featureset:
    """
    Aggregates tumour neighbourhood rankings for all non-HVG, non-PAM50 feature-set
    directions into a probabilistic consensus assignment. Constrained to
    FEATURE_SET_DIR_PATTERN to prevent DAG ambiguity with the HVG and PAM50
    consensus rules that share the same output path template.
    """
    input:
        hc_done = os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done")
    output:
        consensus_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.rds"),
        consensus_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.tsv")
    params:
        script = os.path.join(BASE, "scripts", "tumour_neighbourhood_p_consensus.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(LOGROOT, "tumour_nh_consensus_{direction}.log")
    conda: CONDA_ENV_R
    wildcard_constraints:
        direction=FEATURE_SET_DIR_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.consensus_rds})
        Rscript {params.script} \
          --config {params.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --workdir {BASE} \
          > {log} 2>&1
        '''

