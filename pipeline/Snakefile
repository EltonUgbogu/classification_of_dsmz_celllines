        umap_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "qc", "nh_umap.tsv"),
        umap_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "qc", "nh_umap.pdf")
    log: "logs/tumour_neighbourhood_qc_umap_{direction}.log"
    wildcard_constraints:
        direction="|".join(["|".join([f"{m}_{d}" for d in DISTANCES]) for m in FEATURE_METHODS])
    conda: "/home/chu25/dsmz/pipeline/pipeline/unsupervised/envs/tumour_nh_qc.yaml"
    shell:
        r'''
        set -euo pipefail
        mkdir -p $(dirname {output.qc_tsv})
        Rscript /home/chu25/dsmz/pipeline/pipeline/unsupervised/scripts/tumour_neighbourhood_qc_umap.R \
          --config /home/chu25/dsmz/pipeline/pipeline/unsupervised/config/config.yaml \
          --direction {wildcards.direction} \
          --consensus_rds {input.consensus_rds} \
          --expr_rds {input.expr_rds} \
          --map_rds {input.map_rds} \
          --qc_tsv {output.qc_tsv} \
          --umap_pdf {output.umap_pdf} \
          --umap_tsv {output.umap_tsv} \
          > {log} 2>&1
        '''

# DEFAULT TARGET

rule all:
    input:
