#!/usr/bin/env snakemake

# Unsupervised Clustering and Tumour Neighbourhood Analysis Pipeline
# Fixed: Separate map_rds files for PAM50 and HVG directions

import os
import re
from snakemake.shell import shell

configfile: "config/config.yaml"

BASE = os.path.abspath(workflow.basedir)


def abspath(p):
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(BASE, p))


def deep_merge(base, override):
    """Recursively merge two dictionaries without mutating inputs."""
    merged = dict(base)
    for k, v in override.items():
        if isinstance(v, dict) and isinstance(merged.get(k), dict):
            merged[k] = deep_merge(merged[k], v)
        else:
            merged[k] = v
    return merged


if "profiles" in config:
    profiles = config.get("profiles", {})
    profile_name = config.get("profile") or next(iter(profiles.keys()))
    if profile_name not in profiles:
        raise ValueError(f"Profile '{profile_name}' not found in config")

    default_cfg = config.get("defaults", {})
    cfg = deep_merge(default_cfg, profiles[profile_name])
    print(f"[Snakefile] Using profile: {profile_name}")
else:
    cfg = config


analysis_cfg = cfg.get("analysis", {})
USE_PAM50 = analysis_cfg.get("use_pam50", False)

FEATURE_METHODS = cfg.get("feature_sets", {}).get(
    "methods",
    cfg.get("features", {}).get(
        "methods", ["Variance", "MAD", "MeanAbsDev", "Entropy", "PCA", "Spearman", "MX", "kTotal"]
    ),
)
DISTANCES = cfg.get("feature_sets", {}).get("distances", ["euc", "corr"])
TOPN = int(cfg.get("feature_selection", {}).get("final_top", 500))


def build_directions():
    feature_dirs = [f"{m}_{d}" for m in FEATURE_METHODS for d in DISTANCES]
    pam50_dirs = ["pam50_euc", "pam50_corr"] if USE_PAM50 else []
    explicit = cfg.get("tumour_neighbourhoods", {}).get("directions")
    return explicit if explicit is not None else feature_dirs + pam50_dirs


AGN_DIRECTIONS = build_directions()

if USE_PAM50 and not cfg.get("pam50", {}).get("ensembl_gene_list") and not cfg.get("features", {}).get("pam50_ensembl_gene_list"):
    raise ValueError("use_pam50 is true, but pam50.ensembl_gene_list is not set in config.")


def cfgpath(*keys):
    d = cfg
    for k in keys:
        d = d[k]
    return abspath(d)


shell.prefix(
    "set -euo pipefail; source $HOME/miniconda3/etc/profile.d/conda.sh; conda activate tcga-r-env; "
)

UNSUP = cfgpath("paths", "unsup_root")
VST_JOINT = cfgpath("paths", "vst_joint_rds")

# PRESTEP: Feature Selection

rule feature_selection_unsupervised:
    input:
        vst = VST_JOINT,
        cfg_file = "config/config.yaml"
    output:
        scores = cfgpath("features", "hvg_joint_scores_tsv"),
        hvg_list = cfgpath("features", "hvg_final_gene_list"),
        # Emit all 8 feature set gene lists
        feature_lists = expand(
            os.path.join(cfgpath("features", "hvg_dir"), f"feature_sets_top{TOPN}", "genes_top{TOPN}_{{m}}.txt"),
            m=FEATURE_METHODS
        )
    log: "logs/feature_selection_unsupervised.log"
    shell:
        r'''
        mkdir -p $(dirname {output.scores}) $(dirname {output.hvg_list})
        Rscript scripts/feature_selection_unsupervised.R --config {input.cfg_file} --vst_rds {input.vst} > {log} 2>&1
        '''

# STEP 1 Config

CELL_VST = cfgpath("paths", "cell_vst_rds")
TUMOUR_VST = cfgpath("paths", "tumour_vst_rds")
AGN_ROOT = abspath(cfg["paths"].get("agnostic_cluster_root", os.path.join(UNSUP, "agnostic_clustering")))
AGN_BASE_FUN = abspath(cfg["paths"].get("agnostic_base_functions_dir", cfg["paths"].get("base_functions_dir", os.path.join(UNSUP, "base_functions"))))

AGN_CFG = cfg.get("agnostic_clustering", {})
AGN_N_PCS = AGN_CFG.get("n_pcs", 20)
AGN_MAX_K_HC = AGN_CFG.get("max_k_hc", 8)
AGN_KMIN = AGN_CFG.get("k_min", 2)
AGN_KMAX = AGN_CFG.get("k_max", 8)
AGN_SEED = AGN_CFG.get("seed", 42)

AGN_DIRECTION_PATTERN = "|".join(map(re.escape, AGN_DIRECTIONS))
AGN_EUC_DIRECTIONS = [d for d in AGN_DIRECTIONS if d.endswith("_euc")]
AGN_EUC_PATTERN = "|".join(map(re.escape, AGN_EUC_DIRECTIONS)) if AGN_EUC_DIRECTIONS else r"a^"

CONS_DIRECTIONS = cfg.get("tumour_neighbourhoods", {}).get("directions", AGN_DIRECTIONS)
CONS_DIRECTION_PATTERN = "|".join(map(re.escape, CONS_DIRECTIONS))
CONS_EUC_DIRECTIONS = [d for d in CONS_DIRECTIONS if d.endswith("_euc")]
CONS_EUC_PATTERN = "|".join(map(re.escape, CONS_EUC_DIRECTIONS)) if CONS_EUC_DIRECTIONS else r"a^"

# Legacy feature sets (for backwards compatibility)
PAM50_DIRS = [d for d in AGN_DIRECTIONS if d.startswith("pam50")]
HVG_DIRS = [d for d in AGN_DIRECTIONS if d.startswith("hvg")]

# New feature set directions (8 methods × 2 distances)
FEATURE_SET_DIRS = [d for d in AGN_DIRECTIONS if not d.startswith("pam50") and not d.startswith("hvg")]

HC_KINDS = ["pca_hc_cell", "pca_hc_tumour", "pca_hc_cell_tumour", "hc_cell", "hc_tumour", "hc_cell_tumour"]
KM_KINDS = ["pca_kmeans_cell", "pca_kmeans_tumour", "pca_kmeans_cell_tumour", "kmeans_cell", "kmeans_tumour", "kmeans_cell_tumour"]

def dir_to_feature(direction):
    """Extract feature method name from direction (e.g., 'Variance_euc' -> 'Variance')"""
    if direction.startswith("pam50"):
        return "pam50"
    elif direction.startswith("hvg"):
        return "hvg"
    else:
        # Extract feature method from direction (everything before '_euc' or '_corr')
        if direction.endswith("_euc") or direction.endswith("_corr"):
            return direction.rsplit("_", 1)[0]
        else:
            return direction

def dir_to_dist(direction):
    return "correlation" if direction.endswith("corr") else "euclidean"

def dir_to_gene_list(direction):
    """Get gene list file path for a direction"""
    feature = dir_to_feature(direction)

    if feature == "pam50":
        if "pam50" in cfg and "ensembl_gene_list" in cfg["pam50"]:
            return cfgpath("pam50", "ensembl_gene_list")
        return cfgpath("features", "pam50_ensembl_gene_list")
    elif feature == "hvg":
        return cfgpath("features", "hvg_final_gene_list")
    else:
        # For new feature sets, use the feature_sets_top{TOPN} directory
        fs_dir = cfgpath("features", "hvg_dir")
        return os.path.join(fs_dir, f"feature_sets_top{TOPN}", f"genes_top{TOPN}_{feature}.txt")

def dir_to_geneset(direction):
    """Get human-readable gene set label"""
    feature = dir_to_feature(direction)
    if feature == "pam50":
        return "PAM50"
    elif feature == "hvg":
        return "HVG500"
    else:
        return f"{feature}_top{TOPN}"

def agn_outdir_dir(direction, kind):
    return os.path.join(AGN_ROOT, direction, kind)

# STEP 1 Rules

rule build_agnostic_mats:
    input:
        cell = CELL_VST,
        tumour = TUMOUR_VST,
        genes = lambda wc: dir_to_gene_list(wc.direction)
    output:
        cell_filt = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour_filt = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    log: "logs/build_agnostic_mats_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.cell_filt}) $(dirname {output.tumour_filt})
        Rscript scripts/build_agnostic_direction_mats.R --cell_rds {input.cell} --tumour_rds {input.tumour} --genes {input.genes} --out_cell {output.cell_filt} --out_tumour {output.tumour_filt} > {log} 2>&1
        '''

rule pca_hc_cell:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_hc_cell", "pca_hc_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_hc_cell.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

