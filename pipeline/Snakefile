# Pan-cancer CCP consensus (matches per-disease consensus_ccp_cell_tumour output naming)
rule consensus_ccp_cell_tumour_pan:
    input:
        # Needs the clusterings created above
        hc = pan_agn_out("{direction}", "hc", "cell_tumour"),
        km = pan_agn_out("{direction}", "kmeans", "cell_tumour"),
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg  = CFGFILE_ABS
    output:
        # Write both consensus kinds (hc + kmeans) - one per direction
        hc_rds = pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"),
        km_rds = pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour")
    log:
        os.path.join(PAN_LOGROOT, "consensus", "{direction}", "consensus_ccp_cell_tumour.log")
    conda:
        CONDA_ENV_R
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{PAN_CONS_ROOT}/{wildcards.direction}"

        Rscript "{SCRIPTS_DIR}/pan_consensus_ccp.R" \
          --direction "{wildcards.direction}" \
          --hc_rds "{input.hc}" \
          --kmeans_rds "{input.km}" \
          --meta_tsv "{input.meta}" \
          --view "cell_tumour" \
          --out_root "{PAN_CONS_ROOT}/{wildcards.direction}" \
          > "{log}" 2>&1
        '''

# Pan-cancer tumour-neighbourhood p-consensus (matches per-disease Final_consensus_tumour_neighbourhoods_{direction} naming)
rule tumour_neighbourhood_p_consensus_pan_featureset:
    input:
        expr = pan_expr_submatrix,
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        # consensus outputs may be used as stability / ensemble signal
        ccp_hc = pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"),
        ccp_km = pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour"),
        cfg = CFGFILE_ABS
    output:
        rds = pan_tnh_final("{direction}", "rds"),
        tsv = pan_tnh_final("{direction}", "tsv")
    log:
        os.path.join(PAN_LOGROOT, "tumour_neighbourhoods", "{direction}", "p_consensus.log")
    conda:
        CONDA_ENV_R
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output.rds}")"

        Rscript "{SCRIPTS_DIR}/tumour_neighbourhood_p_consensus.R" \
          --config "{input.cfg}" \
          --profile "{profile_name}" \
          --direction "{wildcards.direction}" \
          --workdir "{BASE}" \
          --ccp_hc_rds "{input.ccp_hc}" \
          --ccp_kmeans_rds "{input.ccp_km}" \
          --meta_tsv "{input.meta}" \
          --out_rds "{output.rds}" \
          --out_tsv "{output.tsv}" \
          2>&1 | tee "{log}"
        '''

# Pan-cancer DSMZ-DSMZ graphs from p-consensus (global + within)
# Uses patched compute_dsmz_dsmz_similarity.R with pan-cancer support
def pan_pcons_tsv(wc):
    """Helper: path to pan-cancer p-consensus TSV for a direction"""
    return os.path.join(
        PAN_TNH_ROOT, wc.direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{wc.direction}.tsv"
    )

rule pan_cancer_dsmz_dsmz_graph:
    input:
        # ensures p-consensus exists first
        pcons_tsv = pan_pcons_tsv,
        # needed for disease annotations + within-mode restriction
        meta_tsv  = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg       = CFGFILE_ABS
    output:
        # script writes many files into this directory; declare a few key "targets"
        edges_tsv   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
        nodes_tsv   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_node_annotations_{direction}.tsv"),
        graphml     = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_{direction}.graphml"),
        sim_pairs   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_similarity_pairs_{direction}.tsv")
    params:
        pan_outdir = PAN_OUTDIR,
        cross_thr  = float(PAN_CFG.get("dsmz_cross_disease_threshold", 0.85))
    log:
        os.path.join(PAN_GRAPH_LOGROOT, "dsmz_dsmz_{mode}_{direction}.log")
    conda:
        CONDA_ENV_R
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname "{output.edges_tsv}")" "$(dirname "{log}")"

        Rscript "{SCRIPTS_DIR}/compute_dsmz_dsmz_similarity.R" \
          --config "{input.cfg}" \
          --profile "{profile_name}" \
          --direction "{wildcards.direction}" \
          --meta_tsv "{input.meta_tsv}" \
          --mode "{wildcards.mode}" \
          --cross_threshold {params.cross_thr} \
          --pan_outdir "{params.pan_outdir}" \
          > "{log}" 2>&1

        # Sanity checks: fail if expected outputs weren't produced
        test -s "{output.edges_tsv}"
        test -s "{output.nodes_tsv}"
        test -s "{output.graphml}"
        test -s "{output.sim_pairs}"
        """

