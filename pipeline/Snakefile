# Helper functions for pan-cancer direction parsing
def pan_parse_direction(direction: str):
    """
    direction like: 'MAD_euc' or 'Spearman_corr'
    Returns: (method, dist)
    """
    parts = direction.split("_")
    if len(parts) < 2:
        raise ValueError(f"Bad pan-cancer direction: {direction}")
    dist = parts[-1]
    method = "_".join(parts[:-1])
    return method, dist

def pan_featureset_rds(wildcards):
    method, _ = pan_parse_direction(wildcards.direction)
    return os.path.join(PAN_OUTDIR, "featuresets", method, "expr_submatrix.rds")

def pan_expr_submatrix(wc):
    """Alias for pan_featureset_rds (for consistency)"""
    return pan_featureset_rds(wc)

def pan_agn_out(direction, kind, view):
    """Pan-cancer agnostic clustering output path (matches per-disease naming)"""
    return os.path.join(PAN_AGN_ROOT, direction, f"{kind}_{view}", f"{kind}_{view}_clusters_optimal.rds")

def pan_cons_out(direction, cons_kind):
    """Pan-cancer consensus output path (matches per-disease naming)"""
    return os.path.join(PAN_CONS_ROOT, direction, cons_kind, f"{cons_kind}_clusters_optimal.rds")

def pan_tnh_final(direction, ext):
    """Pan-cancer tumour neighbourhood final consensus path (matches per-disease naming)"""
    return os.path.join(
        PAN_TNH_ROOT, direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{direction}.{ext}"
    )

# Inputs: each profile's joint VST matrix
PAN_VST_INPUTS = [profile_vst_joint_abs(p) for p in PAN_PROFILES]

rule pan_cancer_joint_benchmark:
    input:
        vst_list = PAN_VST_INPUTS,
        cfg = CFGFILE_ABS
    output:
        summary = os.path.join(PAN_OUTDIR, "benchmarks", "summary.tsv"),
        joint_matrix = os.path.join(PAN_OUTDIR, "inputs", "joint_expr_matrix.rds"),
        joint_meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        manifest = os.path.join(PAN_OUTDIR, "feature_sets_manifest.tsv"),
        # Gene lists and submatrices (one per feature method)
        gene_lists = expand(
            os.path.join(PAN_OUTDIR, "feature_sets_top{n_genes}", "genes_top{n_genes}_{method}.txt"),
            n_genes=[PAN_N_GENES],
            method=PAN_FEATURE_METHODS_LIST
        ),
        submatrices = expand(
            os.path.join(PAN_OUTDIR, "featuresets", "{method}", "expr_submatrix.rds"),
            method=PAN_FEATURE_METHODS_LIST
        )
    params:
        outdir = PAN_OUTDIR,
        profiles = ",".join(PAN_PROFILES),
        feature_methods = PAN_FEATURE_METHODS,    # comma-separated
        dist_metrics = PAN_DIST_METRICS,          # comma-separated
        n_genes = PAN_N_GENES,
        n_neighbors = PAN_N_NEIGHBORS,
        min_dist = PAN_MIN_DIST,
        eval_k = PAN_EVAL_K,
        max_samples = PAN_MAX_SAMPLES,
        # Used only for safe mkdir loops (space-separated for shell)
        feature_methods_list = " ".join(PAN_FEATURE_METHODS_LIST),
        # Rscript currently takes a single string; keep as space-joined unless you change the R parser
        vst_list_str = " ".join(PAN_VST_INPUTS)
    log:
        os.path.join(PAN_LOGROOT, "pan_cancer_joint_benchmark.log")
    conda:
        CONDA_ENV_R
    shell:
        r'''
        set -euo pipefail

        # Core dirs
        mkdir -p \
          "{params.outdir}/inputs" \
          "{params.outdir}/benchmarks" \
          "{params.outdir}/feature_sets_top{params.n_genes}" \
          "{params.outdir}/featuresets" \
          "{PAN_LOGROOT}"

        # Ensure per-method dirs exist (so submatrices have a home)
        for m in {params.feature_methods_list}; do
          mkdir -p "{params.outdir}/featuresets/${{m}}"
        done

        Rscript "{SCRIPTS_DIR}/pan_cancer_joint_benchmark.R" \
          --pipe_root "{PIPE_ROOT}" \
          --outdir "{params.outdir}" \
          --profiles "{params.profiles}" \
          --vst_list "{params.vst_list_str}" \
          --feature_methods "{params.feature_methods}" \
          --dist_metrics "{params.dist_metrics}" \
          --n_genes {params.n_genes} \
          --n_neighbors {params.n_neighbors} \
          --min_dist {params.min_dist} \
          --eval_k {params.eval_k} \
          --max_samples {params.max_samples} \
          > "{log}" 2>&1
        '''

