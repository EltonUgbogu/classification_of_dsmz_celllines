         > "{log} 2>&1"
        '''

rule preprocess_integrate_nbl:
    input:
        tumour_rds = config["profiles"]["nbl"]["tumour_rds"],
        dsmz_rds = config["profiles"]["nbl"]["dsmz_rds"],
        dsmz_meta_csv = config["profiles"]["nbl"]["dsmz_meta_csv"],


rule preprocess_integrate_nbl:
    input:
        tumour_rds = config["profiles"]["nbl"]["tumour_rds"],
        dsmz_rds = config["profiles"]["nbl"]["dsmz_rds"],
        dsmz_meta_csv = config["profiles"]["nbl"]["dsmz_meta_csv"],
    output:
        tumour_counts_rds = "results/nbl/preprocess/tumour_counts.rds",
        dsmz_counts_rds = "results/nbl/preprocess/dsmz_nbl_counts.rds",
        merged_counts_rds = "results/nbl/preprocess/merged_counts_raw.rds",
        coldata_tsv = "results/nbl/preprocess/coldata.tsv",
        batch_corrected_counts_rds = "results/nbl/preprocess/merged_counts_batch_corrected.rds",
        tumour_vst_rds = "results/nbl/preprocess/tumour_vst_pre_bc.rds",
        dsmz_vst_rds = "results/nbl/preprocess/dsmz_vst_pre_bc.rds",
        joint_vst_pre_bc_rds = "results/nbl/preprocess/joint_vst_pre_bc.rds",
        joint_vst_post_bc_rds = "results/nbl/preprocess/joint_vst_post_bc.rds",
        tumour_vst_post_bc_rds = "results/nbl/preprocess/tumour_vst_post_bc.rds",
        dsmz_vst_post_bc_rds = "results/nbl/preprocess/dsmz_vst_post_bc.rds",
        pca_pre_pdf = "results/nbl/preprocess/pca_pre_BC.pdf",
        pca_post_pdf = "results/nbl/preprocess/pca_post_BC.pdf",
        umap_pre_pdf = "results/nbl/preprocess/umap_pre_BC.pdf",
        umap_post_pdf = "results/nbl/preprocess/umap_post_BC.pdf",
        tumour_qc_pdf = "results/nbl/preprocess/qc_tumour_vst.pdf",
        dsmz_qc_pdf = "results/nbl/preprocess/qc_dsmz_vst.pdf",
    params:
        min_shared = config["profiles"]["nbl"].get("min_shared_genes", 5000),
        tumour_label = config["profiles"]["nbl"].get("tumour_label", "NBL_TUMOUR"),
        dsmz_label = config["profiles"]["nbl"].get("dsmz_label", "DSMZ_NBL"),
        dsmz_sample_col = config["profiles"]["nbl"].get("dsmz_sample_col", "sample_name"),
        dsmz_cellline_col = config["profiles"]["nbl"].get("dsmz_cellline_col", "Cell_Line"),
        dsmz_filter_col = config["profiles"]["nbl"].get("dsmz_filter_col", "Primary_Tissue"),
        dsmz_filter_values = config["profiles"]["nbl"].get("dsmz_filter_values", ["Neuroblastoma"]),
        subtype_metadata = config["profiles"]["nbl"].get("subtype_metadata", ""),
        subtype_sample_col = config["profiles"]["nbl"].get("subtype_sample_col", "sample"),
        subtype_col = config["profiles"]["nbl"].get("subtype_col", "subtype"),
    log:
        "logs/nbl/preprocess_integrate_nbl.log"
    conda:
        "envs/r_nbl_preprocess.yaml"
    script:
        "scripts/R/nbl_preprocess_snakemake.R"


rule nbl_all:
    input:
        rules.preprocess_integrate_nbl.output
