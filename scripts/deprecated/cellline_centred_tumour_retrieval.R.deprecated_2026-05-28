# Determine the directory of this script to locate the active implementation
this_script <- normalizePath(sys.frame(0)$ofile, mustWork = FALSE)
if (is.na(this_script) || !nzchar(this_script)) {
  # Fallback: assume scripts/ directory relative to working directory
  this_script <- file.path(getwd(), "scripts", "cellline_centred_tumour_retrieval.R")
}
scripts_dir  <- dirname(this_script)
active_script <- file.path(scripts_dir, "cellline_centred_precision_at_k.R")

if (!file.exists(active_script)) {
  stop(
    "[cellline_centred_tumour_retrieval.R] Deprecation wrapper: cannot locate ",
    "active script at: ", active_script, "\n",
    "Ensure cellline_centred_precision_at_k.R is present in the same directory.",
    call. = FALSE
  )
}

message("[cellline_centred_tumour_retrieval.R] DEPRECATED: forwarding to cellline_centred_precision_at_k.R")
