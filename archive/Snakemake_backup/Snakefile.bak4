#!/usr/bin/env snakemake

# Unsupervised Clustering and Tumour Neighbourhood Analysis Pipeline
# Fixed: Separate map_rds files for PAM50 and HVG directions

import os
import re
from pathlib import Path
from snakemake.shell import shell
from snakemake.io import expand

# -----------------------------------------------------------------------------
# PATHS / PROFILE SETUP (MUST BE DEFINED BEFORE RULES)
# -----------------------------------------------------------------------------

# Repo root = directory containing this Snakefile
BASE = str(Path(__file__).resolve().parent)
SCRIPTS_DIR = os.path.join(BASE, "scripts")
PIPE_ROOT = os.path.abspath(workflow.basedir)

# Absolute config path (so Snakemake works regardless of cwd)
CFGFILE_ABS = os.path.join(PIPE_ROOT, "config", "config.yaml")

# Tell Snakemake to load config from the absolute path
configfile: CFGFILE_ABS

# Verbose mode: set --config verbose=1 to enable debug prints
VERBOSE = bool(int(config.get("verbose", 0)))

def vprint(*args):
    """Print only if VERBOSE is enabled."""
    if VERBOSE:
        print(*args)

# Profile name: prefer CLI --config pipeline_profile=..., fallback to config, then default
# This is a temporary default - will be overwritten after profile validation
profile_name = config.get("pipeline_profile") or config.get("profile") or "default"

# Log root (profile-scoped) - temporary default
LOGROOT = os.path.join(PIPE_ROOT, "logs", profile_name)

# Define a safe default for PIPELINE_TARGET so parsing never fails.
# (Later in the Snakefile this will be overwritten with real profile-specific targets.)
PIPELINE_TARGET = []

# -----------------------------------------------------------------------------
# DEFAULT TARGET (FIRST RULE)
# -----------------------------------------------------------------------------

rule all:
    input:
        lambda wc: PIPELINE_TARGET,  # Lazy evaluation - defined after profile setup
        # Pan-cancer UMAP (optional, can be run independently)
        # Uncomment to include in default target:
        # os.path.join(BASE, "results", "unsupervised", "pan_cancer", "umap", "pan_cancer_hvg_umap_coords.tsv")


# BASE, SCRIPTS_DIR, PIPE_ROOT, CFGFILE_ABS already defined at top of file


def abspath(p):
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(BASE, p))


def deep_merge(base, override):
    """Recursively merge two dictionaries without mutating inputs."""
    merged = dict(base)
    for k, v in override.items():
        if isinstance(v, dict) and isinstance(merged.get(k), dict):
            merged[k] = deep_merge(merged[k], v)
        else:
            merged[k] = v
    return merged


def get_profile_cfg(profile):
    """Get merged config for a specific profile (for pan-cancer cross-profile access)."""
    default_cfg = config.get("defaults", {})
    profiles = config.get("profiles", {})
    if profile not in profiles:
        raise ValueError(f"pan_cancer profile '{profile}' not found in config.profiles")
    return deep_merge(default_cfg, profiles[profile])


def profile_vst_joint_abs(profile):
    """Get absolute path to vst_joint_rds for a specific profile."""
    cfgp = get_profile_cfg(profile)
    p = cfgp.get("paths", {}).get("vst_joint_rds")
    if not p:
        raise KeyError(f"paths.vst_joint_rds missing for profile '{profile}'")
    return abspath(p)


if "profiles" in config:
    profiles = config.get("profiles", {})
    # Read pipeline_profile from --config (MANDATORY - no fallbacks)
    profile_name = config.get("pipeline_profile")
    
    # Strict validation: pipeline_profile is REQUIRED
    if not profile_name:
        available = ", ".join(profiles.keys())
        raise ValueError(
            "Missing --config pipeline_profile=<name>. "
            f"Available profiles: {available}. "
            "Example: snakemake --config pipeline_profile=brca"
        )
    
    if profile_name not in profiles:
        available = ", ".join(profiles.keys())
        raise ValueError(
            f"Profile '{profile_name}' not found in config. "
            f"Available profiles: {available}"
        )
    
    vprint(f"[Snakefile] pipeline_profile={profile_name}")

    default_cfg = config.get("defaults", {})
    cfg = deep_merge(default_cfg, profiles[profile_name])
    vprint(f"[Snakefile] Using profile: {profile_name}")
    vprint(f"[Snakefile] profile_name={profile_name}")
    vprint(f"[Snakefile] cfg.paths.unsup_root = {cfg.get('paths', {}).get('unsup_root', 'NOT SET')}")
    vprint(f"[Snakefile] cfg.analysis.cancer_type = {cfg.get('analysis', {}).get('cancer_type', 'NOT SET')}")
    
    # Update LOGROOT with validated profile name (overwrites temporary default)
    LOGROOT = os.path.join(PIPE_ROOT, "logs", profile_name)
    os.makedirs(LOGROOT, exist_ok=True)
    vprint(f"[Snakefile] LOGROOT = {LOGROOT}")
else:
    cfg = config
    profile_name = config.get("profile", "default")


analysis_cfg = cfg.get("analysis", {})
USE_PAM50 = analysis_cfg.get("use_pam50", False)

# Pan-cancer PCA disable flag (for cross-profile pan-cancer analysis)
PAN_CFG = config.get("pan_cancer", {})
DISABLE_PCA_EVERYWHERE = bool(PAN_CFG.get("disable_pca_everywhere", False))
vprint(f"[Snakefile] DISABLE_PCA_EVERYWHERE = {DISABLE_PCA_EVERYWHERE}")

FEATURE_METHODS = cfg.get("feature_sets", {}).get(
    "methods",
    cfg.get("features", {}).get(
        "methods", ["Variance", "MAD", "MeanAbsDev", "Entropy", "PCA", "Spearman", "MX", "kTotal"]
    ),
)
DISTANCES = cfg.get("feature_sets", {}).get("distances", ["euc", "corr"])
TOPN = int(cfg.get("feature_selection", {}).get("final_top", 500))


def build_directions():
    feature_dirs = [f"{m}_{d}" for m in FEATURE_METHODS for d in DISTANCES]
    pam50_dirs = ["pam50_euc", "pam50_corr"] if USE_PAM50 else []
    explicit = cfg.get("tumour_neighbourhoods", {}).get("directions")
    if explicit is not None:
        # Filter out PAM50 directions if USE_PAM50 is False
        if not USE_PAM50:
            explicit = [d for d in explicit if not d.startswith("pam50_")]
        return explicit
    return feature_dirs + pam50_dirs


AGN_DIRECTIONS = build_directions()

# Filter function to remove PAM50 directions when use_pam50 is False
def filter_pam50(directions, use_pam50: bool):
    """Filter out PAM50 directions if use_pam50 is False"""
    if use_pam50:
        return directions
    return [d for d in directions if not str(d).startswith("pam50_")]

# Filter both direction universes to ensure PAM50 is excluded when use_pam50=False
AGN_DIRECTIONS = filter_pam50(AGN_DIRECTIONS, USE_PAM50)

# Config validation: ensure PAM50 directions are only present when use_pam50 is True
pam50_in_directions = [d for d in AGN_DIRECTIONS if d.startswith("pam50_")]
if pam50_in_directions and not USE_PAM50:
    raise ValueError(
        f"Profile '{profile_name}' has use_pam50=false but directions list contains PAM50 directions: {pam50_in_directions}. "
        "Remove PAM50 directions from tumour_neighbourhoods.directions or set use_pam50=true."
    )

if USE_PAM50 and not cfg.get("pam50", {}).get("ensembl_gene_list") and not cfg.get("features", {}).get("pam50_ensembl_gene_list"):
    raise ValueError("use_pam50 is true, but pam50.ensembl_gene_list is not set in config.")


def cfgrel(*keys):
    """Get config path as relative (keeps as-is from config). Raises KeyError if key missing.
    
    Use this for outputs to keep them relative and portable.
    """
    d = cfg
    for k in keys:
        d = d[k]
    return d


def cfgabs(*keys):
    """Get config path and convert to absolute. Raises KeyError if key missing.
    
    Use this for inputs/params that need absolute paths.
    """
    return abspath(cfgrel(*keys))


def cfgget_path_rel(default_rel, *keys):
    """Get cfg path if present (relative), otherwise use default_rel.
    
    Args:
        default_rel: Relative path to use as default
        *keys: Config keys to traverse (e.g., "paths", "tumour_nh_expr_hvg")
    
    Returns:
        Relative path from config if present, otherwise default_rel
    """
    d = cfg
    for k in keys:
        if not isinstance(d, dict) or k not in d:
            return default_rel
        d = d[k]
    return d


def cfgget_path_abs(default_rel, *keys):
    """Get cfg path if present (absolute), otherwise use absolute of default_rel.
    
    Args:
        default_rel: Relative path to use as default (will be made absolute)
        *keys: Config keys to traverse (e.g., "paths", "tumour_nh_expr_hvg")
    
    Returns:
        Absolute path from config if present, otherwise absolute path of default_rel
    """
    return abspath(cfgget_path_rel(default_rel, *keys))


shell.prefix("set -euo pipefail; export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1; ")

# --- UNSUP root (absolute for --directory compatibility) ---
# Ensure profile is in the path: results/unsupervised/{profile}
# Normalize to handle trailing slashes and ensure consistent structure
UNSUP_BASE = os.path.normpath(cfgget_path_rel("results/unsupervised", "paths", "unsup_root"))
vprint(f"[Snakefile] UNSUP_BASE (from config) = {UNSUP_BASE}")
# If UNSUP_BASE already ends with the profile, keep it; otherwise append it
if os.path.basename(UNSUP_BASE) != profile_name:
    UNSUP_REL = os.path.join(UNSUP_BASE, profile_name)
else:
    UNSUP_REL = UNSUP_BASE
# Make absolute by joining with PIPE_ROOT (for --directory compatibility)
UNSUP = os.path.join(PIPE_ROOT, UNSUP_REL) if not os.path.isabs(UNSUP_REL) else UNSUP_REL
vprint(f"[Snakefile] UNSUP (final, absolute) = {UNSUP}")

# Inputs: absolute
VST_JOINT = cfgabs("paths", "vst_joint_rds")

# Feature list files: absolute (for --directory compatibility)
FEATURESETS_DIR = os.path.join(UNSUP, "feature_selection_unsupervised", f"feature_sets_top{TOPN}")
FEATURELIST_TEMPLATE = os.path.join(FEATURESETS_DIR, f"genes_top{TOPN}" + "_{m}.txt")
FEATURELIST_FILES = expand(FEATURELIST_TEMPLATE, m=FEATURE_METHODS)

# Outputs: absolute (for --directory compatibility)
FEATURE_METHOD_OUTDIR = os.path.join(UNSUP, "feature_selection_unsupervised", "featuresets")
TUMOUR_NH_INPUT_ROOT = os.path.join(UNSUP, "tumour_neighbourhoods_input")

# Pipeline target is profile-specific (so BRCA/NBL/RBL don't share one file)
PIPELINE_TARGET = os.path.join(UNSUP, "pipeline_targets.done")

rule feature_selection_unsupervised:
    input:
        vst = VST_JOINT,
        cfg_file = CFGFILE_ABS
    output:
        # Use proper path joining: store relative paths in config, then join with UNSUP
        # If config path contains UNSUP_BASE, replace it with UNSUP; otherwise make absolute
        scores = (os.path.join(UNSUP, os.path.relpath(cfgrel("features", "hvg_joint_scores_tsv"), UNSUP_BASE)) 
                 if UNSUP_BASE in cfgrel("features", "hvg_joint_scores_tsv") 
                 else abspath(cfgrel("features", "hvg_joint_scores_tsv"))),
        hvg_list = (os.path.join(UNSUP, os.path.relpath(cfgrel("features", "hvg_final_gene_list"), UNSUP_BASE)) 
                   if UNSUP_BASE in cfgrel("features", "hvg_final_gene_list") 
                   else abspath(cfgrel("features", "hvg_final_gene_list"))),
        feature_lists = FEATURELIST_FILES  # Already absolute (FEATURESETS_DIR is absolute)
    params:
        outdir = lambda wc: abspath(os.path.dirname(cfgrel("features", "hvg_joint_scores_tsv")))  # Absolute for params
    log: os.path.join(LOGROOT, "feature_selection_unsupervised.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        mkdir -p $(dirname "{output.scores}") $(dirname "{output.hvg_list}") "{FEATURESETS_DIR}"
        Rscript "{SCRIPTS_DIR}/feature_selection_unsupervised.R" \
          --config="{CFGFILE_ABS}" \
          --profile="{profile_name}" \
          --outdir="{params.outdir}" \
          --vst_rds="{input.vst}" \
          --scripts_dir="{SCRIPTS_DIR}" \
          > "{log}" 2>&1
        '''

# STEP 1 Config

CELL_VST = cfgabs("paths", "cell_vst_rds")  # Input needs absolute
TUMOUR_VST = cfgabs("paths", "tumour_vst_rds")  # Input needs absolute

# AGN_ROOT: relative path for outputs (so Snakemake targets work with relative paths)
# Make it profile-specific: results/unsupervised/{profile}/agnostic_clustering
# Best practice: outputs should always be relative, absolute only for params/scripts
AGN_ROOT_REL = cfg["paths"].get("agnostic_cluster_root")
if AGN_ROOT_REL is None:
    # Default: use profile-specific path
    AGN_ROOT_REL = os.path.join(UNSUP, "agnostic_clustering")
else:
    # If explicitly set, ensure it includes profile if not already present
    # Use path segments, not substring matching
    parts = os.path.normpath(AGN_ROOT_REL).split(os.sep)
    if parts[-1] != profile_name and (len(parts) < 3 or parts[-2] != profile_name):
        # If it's a relative path under results/unsupervised, add profile
        if AGN_ROOT_REL.startswith("results/unsupervised/"):
            path_parts = AGN_ROOT_REL.split("/", 2)
            if len(path_parts) == 3 and path_parts[2] != profile_name:
                AGN_ROOT_REL = os.path.join("results/unsupervised", profile_name, "agnostic_clustering")
        else:
            # Otherwise, prepend profile-specific base
            AGN_ROOT_REL = os.path.join(UNSUP, "agnostic_clustering")

# Use relative for outputs (consistent DAG), absolute only when needed for params/scripts
# Ensure AGN_ROOT_REL is truly relative (not mixing with absolute UNSUP)
if os.path.isabs(AGN_ROOT_REL):
    # If it became absolute, make it relative to PIPE_ROOT
    AGN_ROOT = os.path.relpath(AGN_ROOT_REL, PIPE_ROOT)
else:
    AGN_ROOT = AGN_ROOT_REL
AGN_ROOT_ABS = abspath(AGN_ROOT)  # Absolute only for params/scripts that need it
AGN_BASE_FUN = abspath(cfg["paths"].get("agnostic_base_functions_dir", cfg["paths"].get("base_functions_dir", os.path.join(UNSUP, "base_functions"))))

AGN_CFG = cfg.get("agnostic_clustering", {})
AGN_N_PCS = AGN_CFG.get("n_pcs", 20)
AGN_MAX_K_HC = AGN_CFG.get("max_k_hc", 8)
AGN_KMIN = AGN_CFG.get("k_min", 2)
AGN_KMAX = AGN_CFG.get("k_max", 8)
AGN_SEED = AGN_CFG.get("seed", 42)

# Get CONS_DIRECTIONS and filter it too
CONS_DIRECTIONS = cfg.get("tumour_neighbourhoods", {}).get("directions", AGN_DIRECTIONS)
CONS_DIRECTIONS = filter_pam50(CONS_DIRECTIONS, USE_PAM50)

# Build patterns AFTER filtering (ensures wildcard constraints exclude PAM50 when use_pam50=False)
AGN_DIRECTION_PATTERN = "|".join(map(re.escape, AGN_DIRECTIONS))
AGN_EUC_DIRECTIONS = [d for d in AGN_DIRECTIONS if d.endswith("_euc")]
AGN_EUC_PATTERN = "|".join(map(re.escape, AGN_EUC_DIRECTIONS)) if AGN_EUC_DIRECTIONS else r"a^"

CONS_DIRECTION_PATTERN = "|".join(map(re.escape, CONS_DIRECTIONS))
CONS_EUC_DIRECTIONS = [d for d in CONS_DIRECTIONS if d.endswith("_euc")]
CONS_EUC_PATTERN = "|".join(map(re.escape, CONS_EUC_DIRECTIONS)) if CONS_EUC_DIRECTIONS else r"a^"

# Legacy feature sets (for backwards compatibility)
PAM50_DIRS = [d for d in AGN_DIRECTIONS if d.startswith("pam50")]
HVG_DIRS = [d for d in AGN_DIRECTIONS if d.startswith("hvg")]

# New feature set directions (8 methods × 2 distances)
FEATURE_SET_DIRS = [d for d in AGN_DIRECTIONS if not d.startswith("pam50") and not d.startswith("hvg")]
FEATURE_SET_DIR_PATTERN = "|".join(map(re.escape, FEATURE_SET_DIRS)) if FEATURE_SET_DIRS else r"a^"

HC_KINDS = ["pca_hc_cell", "pca_hc_tumour", "pca_hc_cell_tumour", "hc_cell", "hc_tumour", "hc_cell_tumour"]
KM_KINDS = ["pca_kmeans_cell", "pca_kmeans_tumour", "pca_kmeans_cell_tumour", "kmeans_cell", "kmeans_tumour", "kmeans_cell_tumour"]

# Filter out PCA kinds if disable_pca_everywhere is set (for pan-cancer)
if DISABLE_PCA_EVERYWHERE:
    HC_KINDS = [k for k in HC_KINDS if not k.startswith("pca_")]
    KM_KINDS = [k for k in KM_KINDS if not k.startswith("pca_")]
    vprint(f"[Snakefile] Filtered PCA kinds: HC_KINDS={HC_KINDS}, KM_KINDS={KM_KINDS}")

def dir_to_feature(direction):
    """Extract feature method name from direction (e.g., 'Variance_euc' -> 'Variance')"""
    if direction.startswith("pam50"):
        return "pam50"
    elif direction.startswith("hvg"):
        return "hvg"
    else:
        # Extract feature method from direction (everything before '_euc' or '_corr')
        if direction.endswith("_euc") or direction.endswith("_corr"):
            return direction.rsplit("_", 1)[0]
        else:
            return direction

def dir_to_dist(direction):
    return "correlation" if direction.endswith("corr") else "euclidean"

def dir_to_gene_list(direction):
    """Get gene list file path for a direction"""
    feature = dir_to_feature(direction)

    if feature == "pam50":
        if not USE_PAM50:
            raise ValueError(f"PAM50 direction requested ({direction}) but use_pam50=false for profile={profile_name}")
        if "pam50" in cfg and "ensembl_gene_list" in cfg["pam50"]:
            return cfgabs("pam50", "ensembl_gene_list")  # Input needs absolute
        return cfgabs("features", "pam50_ensembl_gene_list")  # Input needs absolute
    elif feature == "hvg":
        return rules.feature_selection_unsupervised.output.hvg_list  # Use rule output (absolute)
    else:
        # For new feature sets, use the feature_sets_top{TOPN} directory
        # Use absolute path (FEATURESETS_DIR is already absolute)
        return os.path.join(FEATURESETS_DIR, f"genes_top{TOPN}_{feature}.txt")

def dir_to_geneset(direction):
    """Get human-readable gene set label"""
    feature = dir_to_feature(direction)
    if feature == "pam50":
        return "PAM50"
    elif feature == "hvg":
        return "HVG500"
    else:
        return f"{feature}_top{TOPN}"

def agn_outdir_dir(direction, kind):
    return os.path.join(AGN_ROOT_ABS, direction, kind)  # Absolute for params (scripts need it)

# STEP 1 Rules

rule build_agnostic_mats:
    input:
        cell = CELL_VST,
        tumour = TUMOUR_VST,
        genes = lambda wc: rules.feature_selection_unsupervised.output.hvg_list if dir_to_feature(wc.direction) == "hvg" else dir_to_gene_list(wc.direction)
    output:
        cell_filt = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "cell_expr.rds"),
        tumour_filt = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "tumour_expr.rds")
    log: os.path.join(LOGROOT, "build_agnostic_mats_{direction}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.cell_filt}) $(dirname {output.tumour_filt})
        Rscript {SCRIPTS_DIR}/build_agnostic_direction_mats.R --cell_rds {input.cell} --tumour_rds {input.tumour} --genes {input.genes} --out_cell {output.cell_filt} --out_tumour {output.tumour_filt} > {log} 2>&1
        '''

rule pca_hc_cell:
    input:
        cell = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT_REL, "{direction}", "pca_hc_cell", "pca_hc_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: os.path.join(LOGROOT, "agnostic_{direction}_pca_hc_cell.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pca_hc_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_hc_tumour:
    input:
        tumour = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT_REL, "{direction}", "pca_hc_tumour", "pca_hc_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: os.path.join(LOGROOT, "agnostic_{direction}_pca_hc_tumour.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pca_hc_tumour.R --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --label TUMOUR --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_hc_cell_tumour:
    input:
        cell = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "cell_expr.rds"),
        tumour = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT_REL, "{direction}", "pca_hc_cell_tumour", "pca_hc_cell_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_cell_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: os.path.join(LOGROOT, "agnostic_{direction}_pca_hc_cell_tumour.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pca_hc_cell_tumour.R --cell_rds {input.cell} --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --cell_label CELL --tumour_label TUMOUR --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_kmeans_cell:
    input:
        cell = os.path.join(AGN_ROOT_REL, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT_REL, "{direction}", "pca_kmeans_cell", "pca_kmeans_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_kmeans_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: os.path.join(LOGROOT, "agnostic_{direction}_pca_kmeans_cell.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pca_kmeans_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --n_pcs {params.n_pcs} --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

