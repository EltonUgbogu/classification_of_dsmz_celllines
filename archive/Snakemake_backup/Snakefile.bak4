rule pan_cancer_ccp_consensus:
    input:
        clusters_dir = lambda wc: os.path.join(PAN_ENS_OUTDIR, "clusterings", wc.direction),
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg  = CFGFILE_ABS
    output:
        consensus = os.path.join(PAN_ENS_OUTDIR, "consensus", "{direction}", "ccp_consensus.tsv"),
        ccp = os.path.join(PAN_ENS_OUTDIR, "consensus", "{direction}", "ccp_matrix.rds")
    params:
        outdir = lambda wc: os.path.join(PAN_ENS_OUTDIR, "consensus", wc.direction),
        direction = "{direction}",
        kinds = ",".join(PAN_CLUSTER_KINDS),
        views = ",".join(PAN_VIEWS)
    log:
        os.path.join(PAN_ENS_LOGROOT, "ccp_consensus_{direction}.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{params.outdir}"

        Rscript "{SCRIPTS_DIR}/pan_cancer_ccp_consensus.R" \
          --clusters_dir "{input.clusters_dir}" \
          --meta_tsv "{input.meta}" \
          --direction "{params.direction}" \
          --kinds "{params.kinds}" \
          --views "{params.views}" \
          --outdir "{params.outdir}" \
          > "{log}" 2>&1
        '''

rule pan_cancer_p_consensus_per_cancer:
    input:
        consensus = os.path.join(PAN_ENS_OUTDIR, "consensus", "{direction}", "ccp_consensus.tsv"),
        expr = pan_featureset_rds,
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg  = CFGFILE_ABS
    output:
        # one output per cancer per direction
        ranked = os.path.join(PAN_PCONS_OUTDIR, "{cancer}", "{direction}", "ranked_cell_lines.tsv"),
        stats  = os.path.join(PAN_PCONS_OUTDIR, "{cancer}", "{direction}", "tumour_neighbourhood_stats.tsv")
    params:
        outdir = lambda wc: os.path.join(PAN_PCONS_OUTDIR, wc.cancer, wc.direction),
        cancer = "{cancer}",
        direction = "{direction}",
        k = int(PAN_CFG.get("p_consensus_k", 50)),
        min_purity = float(PAN_CFG.get("p_consensus_min_purity", 0.0))
    log:
        os.path.join(PAN_PCONS_LOGROOT, "pcons_{cancer}_{direction}.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{params.outdir}"

        Rscript "{SCRIPTS_DIR}/pan_cancer_p_consensus.R" \
          --cancer "{params.cancer}" \
          --direction "{params.direction}" \
          --expr_rds "{input.expr}" \
          --meta_tsv "{input.meta}" \
          --consensus_tsv "{input.consensus}" \
          --k {params.k} \
          --min_purity {params.min_purity} \
          --outdir "{params.outdir}" \
          > "{log}" 2>&1
        '''

rule pan_cancer_targets:
    input:
        # Ensure clusterings+consensus exist for every direction
        expand(
            os.path.join(PAN_ENS_OUTDIR, "consensus", "{direction}", "ccp_consensus.tsv"),
            direction=PAN_CANCER_DIRECTIONS
        ),
        # And p-consensus per cancer per direction
        expand(
            os.path.join(PAN_PCONS_OUTDIR, "{cancer}", "{direction}", "ranked_cell_lines.tsv"),
            cancer=PAN_CANCERS,
            direction=PAN_CANCER_DIRECTIONS
        )

