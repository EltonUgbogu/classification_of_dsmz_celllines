          --umap_tsv {output.umap_tsv} \
          > {log} 2>&1
        '''

# -----------------------------------------------------------------------------
# PIPELINE TARGETS AGGREGATOR
# -----------------------------------------------------------------------------
rule pipeline_targets:
    input:
        # PRESTEP: Feature Selection
        rules.feature_selection_unsupervised.output.scores,
        rules.feature_selection_unsupervised.output.hvg_list,

        # STEP 1: Agnostic Clustering
        rules.agnostic_all_directions.input,

        # STEP 2: Consensus Clustering
        rules.consensus_all_directions.input,

        # STEP 3: Tumour Neighbourhood Consensus (path-based, not rule-based)
        [nh_final_consensus_rds(d) for d in AGN_DIRECTIONS],
        [os.path.join(TUMOUR_NH_ROOT, d, "final_consensus",
                      f"Final_consensus_tumour_neighbourhoods_{d}.tsv")
         for d in AGN_DIRECTIONS],

        # STEP 4: DSMZ-DSMZ Similarity Graphs (all outputs)
        expand(rules.dsmz_dsmz_similarity_graph.output.sim_mat_rds,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.sim_pairs_tsv, direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.edges_tsv,     direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.nodes_tsv,     direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.nodes_annot,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_summary,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_table,    direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.hist_pdf,      direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.scatter_pdf,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_heatmap,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_leiden,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_louvain, direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_minimal, direction=AGN_DIRECTIONS),

        # STEP 5: Cross-Direction Summary
        rules.summarize_p_consensus_all.output,

        # STEP 6: QC and Integration UMAP
        [nh_qc_tsv(d) for d in AGN_DIRECTIONS],
        [nh_umap_tsv(d) for d in AGN_DIRECTIONS],
        [nh_umap_pdf(d) for d in AGN_DIRECTIONS]
    output:
        touch(PIPELINE_TARGET)

# ==============================================================================
# PAN-CANCER ANALYSIS
# ==============================================================================

# Pan-cancer specific log directory (separate from profile logs)
PAN_LOGROOT = os.path.join(PIPE_ROOT, "logs", "pan_cancer")
os.makedirs(PAN_LOGROOT, exist_ok=True)

# Respect "disable_pca_everywhere" for pan-cancer
PAN_DISABLE_PCA = bool(PAN_CFG.get("disable_pca_everywhere", False))

# Feature methods + distance metrics used by pan-cancer
PAN_FEATURE_METHODS_LIST = list(PAN_CFG.get("feature_methods", ["Variance", "MAD", "Entropy"]))
if PAN_DISABLE_PCA:
    PAN_FEATURE_METHODS_LIST = [m for m in PAN_FEATURE_METHODS_LIST if m.lower() != "pca"]

PAN_DIST_METRICS_LIST = list(PAN_CFG.get("dist_metrics", ["cosine", "euclidean"]))

# Strings passed into the Rscript (comma-separated = robust)
PAN_FEATURE_METHODS = ",".join(PAN_FEATURE_METHODS_LIST)
PAN_DIST_METRICS = ",".join(PAN_DIST_METRICS_LIST)

# Pan-cancer joint benchmark: joint tumour vs joint cell line
PAN_PROFILES = PAN_CFG.get("profiles", ["brca", "nbl", "rbl"])

PAN_OUTDIR_REL = PAN_CFG.get("outdir", "results/pan_cancer/joint_benchmark")
PAN_OUTDIR = os.path.join(PIPE_ROOT, PAN_OUTDIR_REL) if not os.path.isabs(PAN_OUTDIR_REL) else PAN_OUTDIR_REL

PAN_N_GENES = int(PAN_CFG.get("n_genes", 500))
PAN_N_NEIGHBORS = int(PAN_CFG.get("n_neighbors", 30))
PAN_MIN_DIST = float(PAN_CFG.get("min_dist", 0.3))
PAN_EVAL_K = int(PAN_CFG.get("eval_k", 30))
PAN_MAX_SAMPLES = int(PAN_CFG.get("max_samples", 0))

# This is what you'll use later for "pan-cancer like per-disease" directions
# (methods × distance metrics), PCA-free if disable_pca_everywhere=true
PAN_CANCER_DIRECTIONS = [
    f"{m}_{d}" for m in PAN_FEATURE_METHODS_LIST for d in PAN_DIST_METRICS_LIST
]

# Pan-cancer UNSUP root (analogous to per-disease {UNSUP})
PAN_UNSUP = os.path.join(PAN_OUTDIR, "unsupervised")   # pan-cancer analogue of {UNSUP}
PAN_AGN_ROOT = os.path.join(PAN_UNSUP, "agnostic_clustering")
PAN_CONS_ROOT = os.path.join(PAN_UNSUP, "consensus")
PAN_TNH_ROOT  = os.path.join(PAN_UNSUP, "tumour_neighbourhoods")

# Pan-cancer graphs (DSMZ-DSMZ similarity)
PAN_GRAPH_ROOT = os.path.join(PAN_OUTDIR, "graphs", "dsmz_dsmz")
PAN_GRAPH_LOGROOT = os.path.join(PAN_LOGROOT, "graphs")
os.makedirs(PAN_GRAPH_LOGROOT, exist_ok=True)
PAN_GRAPH_MODES = ["global", "within"]

# Pan-cancer ensemble directories
PAN_ENS_OUTDIR = os.path.join(PAN_OUTDIR, "ensemble")
PAN_ENS_LOGROOT = os.path.join(PAN_LOGROOT, "ensemble")
os.makedirs(PAN_ENS_LOGROOT, exist_ok=True)

# Pan-cancer p-consensus directories
PAN_CANCERS = list(PAN_CFG.get("cancers", PAN_PROFILES))  # or explicit ["brca","nbl","rbl"]
PAN_PCONS_OUTDIR = os.path.join(PAN_OUTDIR, "p_consensus")
PAN_PCONS_LOGROOT = os.path.join(PAN_LOGROOT, "p_consensus")
os.makedirs(PAN_PCONS_LOGROOT, exist_ok=True)

# Cluster kinds and views (mirrors per-disease)
PAN_CLUSTER_KINDS = ["hc", "kmeans"]
PAN_VIEWS = ["cell", "tumour", "cell_tumour"]  # mirrors per-disease

# Pan-cancer consensus kinds (start minimal: "expr cell_tumour" only)
PAN_CONS_KINDS = [
    "ccp_hc_expr_cell_tumour",
    "ccp_kmeans_expr_cell_tumour",
]

# Helper functions for pan-cancer direction parsing
def pan_parse_direction(direction: str):
    """
    direction like: 'MAD_euc' or 'Spearman_corr'
    Returns: (method, dist)
    """
    parts = direction.split("_")
    if len(parts) < 2:
        raise ValueError(f"Bad pan-cancer direction: {direction}")
    dist = parts[-1]
    method = "_".join(parts[:-1])
    return method, dist

def pan_featureset_rds(wildcards):
    method, _ = pan_parse_direction(wildcards.direction)
    return os.path.join(PAN_OUTDIR, "featuresets", method, "expr_submatrix.rds")

def pan_expr_submatrix(wc):
    """Alias for pan_featureset_rds (for consistency)"""
    return pan_featureset_rds(wc)

def pan_agn_out(direction, kind, view):
    """Pan-cancer agnostic clustering output path (matches per-disease naming)"""
    return os.path.join(PAN_AGN_ROOT, direction, f"{kind}_{view}", f"{kind}_{view}_clusters_optimal.rds")

def pan_cons_out(direction, cons_kind):
    """Pan-cancer consensus output path (matches per-disease naming)"""
    return os.path.join(PAN_CONS_ROOT, direction, cons_kind, f"{cons_kind}_clusters_optimal.rds")

def pan_tnh_final(direction, ext):
    """Pan-cancer tumour neighbourhood final consensus path (matches per-disease naming)"""
    return os.path.join(
        PAN_TNH_ROOT, direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{direction}.{ext}"
    )

# Inputs: each profile's joint VST matrix
PAN_VST_INPUTS = [profile_vst_joint_abs(p) for p in PAN_PROFILES]

rule pan_cancer_joint_benchmark:
    input:
        vst_list = PAN_VST_INPUTS,
        cfg = CFGFILE_ABS
    output:
        summary = os.path.join(PAN_OUTDIR, "benchmarks", "summary.tsv"),
        joint_matrix = os.path.join(PAN_OUTDIR, "inputs", "joint_expr_matrix.rds"),
        joint_meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        manifest = os.path.join(PAN_OUTDIR, "feature_sets_manifest.tsv"),
        # Gene lists and submatrices (one per feature method)
        gene_lists = expand(
            os.path.join(PAN_OUTDIR, "feature_sets_top{n_genes}", "genes_top{n_genes}_{method}.txt"),
            n_genes=[PAN_N_GENES],
            method=PAN_FEATURE_METHODS_LIST
        ),
        submatrices = expand(
            os.path.join(PAN_OUTDIR, "featuresets", "{method}", "expr_submatrix.rds"),
            method=PAN_FEATURE_METHODS_LIST
        )
    params:
        outdir = PAN_OUTDIR,
        profiles = ",".join(PAN_PROFILES),
        feature_methods = PAN_FEATURE_METHODS,    # comma-separated
        dist_metrics = PAN_DIST_METRICS,          # comma-separated
        n_genes = PAN_N_GENES,
        n_neighbors = PAN_N_NEIGHBORS,
        min_dist = PAN_MIN_DIST,
        eval_k = PAN_EVAL_K,
        max_samples = PAN_MAX_SAMPLES,
        # Used only for safe mkdir loops (space-separated for shell)
        feature_methods_list = " ".join(PAN_FEATURE_METHODS_LIST),
        # Rscript currently takes a single string; keep as space-joined unless you change the R parser
        vst_list_str = " ".join(PAN_VST_INPUTS)
    log:
        os.path.join(PAN_LOGROOT, "pan_cancer_joint_benchmark.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail

        # Core dirs
        mkdir -p \
          "{params.outdir}/inputs" \
          "{params.outdir}/benchmarks" \
          "{params.outdir}/feature_sets_top{params.n_genes}" \
          "{params.outdir}/featuresets" \
          "{PAN_LOGROOT}"

        # Ensure per-method dirs exist (so submatrices have a home)
        for m in {params.feature_methods_list}; do
          mkdir -p "{params.outdir}/featuresets/${{m}}"
        done

        Rscript "/work/ugbogu/pipeline/scripts/pan_cancer_joint_benchmark.R" \
          --pipe_root "{PIPE_ROOT}" \
          --outdir "{params.outdir}" \
          --profiles "{params.profiles}" \
          --vst_list "{params.vst_list_str}" \
          --feature_methods "{params.feature_methods}" \
          --dist_metrics "{params.dist_metrics}" \
          --n_genes {params.n_genes} \
          --n_neighbors {params.n_neighbors} \
          --min_dist {params.min_dist} \
          --eval_k {params.eval_k} \
          --max_samples {params.max_samples} \
          > "{log}" 2>&1
        '''

