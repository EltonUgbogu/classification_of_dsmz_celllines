# STEP 4: DSMZ-DSMZ Similarity Graph

rule dsmz_dsmz_similarity_graph:
    input:
        consensus_rds = lambda wc: nh_final_consensus_rds(wc.direction)
    output:
        sim_mat_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_matrix_{direction}.rds"),
        sim_pairs_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_pairs_{direction}.tsv"),
        edges_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
        nodes_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_summary_{direction}.tsv"),
        nodes_annot = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_annotations_{direction}.tsv"),
        comm_summary = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_community_summary_{direction}.tsv"),
        comm_table = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_Louvain_vs_Leiden_community_table_{direction}.tsv"),
        hist_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_similarity_histogram_{direction}.pdf"),
        scatter_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_p_consensus_cell_scatter_{direction}.pdf"),
        comm_heatmap = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_Louvain_vs_Leiden_heatmap_{direction}.pdf"),
        graph_leiden = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Leiden_{direction}.pdf"),
        graph_louvain = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Louvain_{direction}.pdf"),
        graph_minimal = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_minimal_{direction}.pdf")
    params:
        script = os.path.join(BASE, "scripts", "compute_cell_line_similarity.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(LOGROOT, "dsmz_dsmz_similarity_graph_{direction}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.sim_mat_rds})
        Rscript {params.script} \
          --config {params.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          > {log} 2>&1
        '''

# STEP 5: Cross-Direction Summary

P_CONS_ALL_DIR = os.path.join(TUMOUR_NH_ROOT, "final_consensus_all")

rule summarize_p_consensus_all:
    input:
        consensus_rds = [nh_final_consensus_rds(d) for d in AGN_DIRECTIONS],
        cfg = CFGFILE_ABS
    output:
        dir_summary = os.path.join(P_CONS_ALL_DIR, "p_consensus_direction_summary.tsv"),
        cell_dir_summary = os.path.join(P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.tsv"),
        winner_map = os.path.join(P_CONS_ALL_DIR, "p_consensus_winner_map_per_cell_line.tsv"),
        winners_max_p = os.path.join(P_CONS_ALL_DIR, "p_consensus_winners_by_max_p.tsv"),
        winners_frac = os.path.join(P_CONS_ALL_DIR, "p_consensus_winners_by_frac_ge_thr.tsv"),
        ranked_best = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_ranked.tsv"),
        long_tbl = os.path.join(P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.long.tsv"),
        composite_weights = os.path.join(P_CONS_ALL_DIR, "p_consensus_composite_weights.tsv"),
        top_fraction = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_fraction.tsv"),
        top_score = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_score.tsv"),
        fig_pdf = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_direction_comparison.pdf"),
        fig_scree = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_scree.pdf"),
        fig_weights = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_weights.pdf")
    params:
        script = os.path.join(BASE, "scripts", "summarize_p_consensus_all.R"),
        config = os.path.join(BASE, "config", "config.yaml"),
        threshold = lambda wc: cfg.get("tumour_neighbourhoods", {}).get("p_consensus_threshold", 0.7)
    log: os.path.join(LOGROOT, "summarize_p_consensus_all.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        mkdir -p {P_CONS_ALL_DIR}
        Rscript {params.script} \
          --config {params.config} \
          --profile "{profile_name}" \
          --threshold {params.threshold} \
          > {log} 2>&1
        '''

# ==============================================================================
# LAYER 3: CHARACTERISATION (post-hoc biological interpretation)
# ==============================================================================

# Layer 3a: Tumour cluster characterisation (via characterize_clusters.R)
# Layer 3b: Tumour-informed cell-line characterisation (built into characterize_clusters.R)
# Layer 3c: Representativeness score (derived from Layer 3b)

CHAR_ROOT = os.path.join(UNSUP, "characterization", "tumour")
CHAR_SELECTED = os.path.join(CHAR_ROOT, "SELECTED")

# Lock selected direction (creates SELECTED directory anchor)
rule lock_selected_direction:
    input:
        winner = os.path.join(TUMOUR_NH_ROOT, "final_consensus_all", "winning_direction.txt")
    output:
        sel = directory(CHAR_SELECTED)
    run:
        import os
        os.makedirs(output.sel, exist_ok=True)
        # Store the winner inside the selected directory
        with open(input.winner) as f:
            w = f.read().strip()
        with open(os.path.join(output.sel, "winning_direction.txt"), "w") as g:
            g.write(w + "\n")

# Layer 3c: Representativeness score (reads winner from SELECTED dir, stable evaluation)
rule representativeness_score:
    input:
        sel = os.path.join(CHAR_SELECTED, "winning_direction.txt")
    output:
        ranked = os.path.join(CHAR_SELECTED, "cell_line_representativeness_ranked.tsv"),
        top10_per_cluster = os.path.join(CHAR_SELECTED, "cell_line_representativeness_top10_per_cluster.tsv")
    params:
        score_mode = "pXspec"
    log:
        os.path.join(LOGROOT, "representativeness_score.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r"""
        set -euo pipefail
        WIN=$(cat {input.sel})

        CELL_CHAR="{CHAR_ROOT}/${{WIN}}/cell_line_characterisation.tsv"
        OUT_RANKED="{output.ranked}"
        OUT_TOP10="{output.top10_per_cluster}"

        if [ ! -f "$CELL_CHAR" ]; then
            echo "[ERROR] cell_line_characterisation.tsv not found: $CELL_CHAR"
            echo "[ERROR] Make sure characterize_clusters.R has been run for direction: $WIN"
            exit 1
        fi

        Rscript "{SCRIPTS_DIR}/compute_representativeness_score.R" \
          --cell_char_tsv "$CELL_CHAR" \
          --out_tsv "$OUT_RANKED" \
          --score_mode {params.score_mode} \
          > "{log}" 2>&1

        # The script writes top10_per_cluster.tsv automatically (check if it exists)
        if [ -f "$OUT_TOP10" ]; then
            echo "[INFO] Top-10 per cluster written to: $OUT_TOP10"
        fi
        """

# STEP 6: QC and Integration UMAP
# KEY FIX: map_rds now direction-aware (PAM50 vs HVG)

