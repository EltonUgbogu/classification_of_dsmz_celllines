# Pan-cancer CCP consensus (matches per-disease consensus_ccp_cell_tumour output naming)
rule consensus_ccp_cell_tumour_pan:
    input:
        # Needs the clusterings created above
        hc = pan_agn_out("{direction}", "hc", "cell_tumour"),
        km = pan_agn_out("{direction}", "kmeans", "cell_tumour"),
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg  = CFGFILE_ABS
    output:
        # Write both consensus kinds (hc + kmeans) - one per direction
        hc_rds = pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"),
        km_rds = pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour")
    log:
        os.path.join(PAN_LOGROOT, "consensus", "{direction}", "consensus_ccp_cell_tumour.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{PAN_CONS_ROOT}/{wildcards.direction}"

        Rscript "{SCRIPTS_DIR}/pan_consensus_ccp.R" \
          --direction "{wildcards.direction}" \
          --hc_rds "{input.hc}" \
          --kmeans_rds "{input.km}" \
          --meta_tsv "{input.meta}" \
          --view "cell_tumour" \
          --out_root "{PAN_CONS_ROOT}/{wildcards.direction}" \
          > "{log}" 2>&1
        '''

# Pan-cancer tumour-neighbourhood p-consensus (matches per-disease Final_consensus_tumour_neighbourhoods_{direction} naming)
rule tumour_neighbourhood_p_consensus_pan_featureset:
    input:
        expr = pan_expr_submatrix,
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        # consensus outputs may be used as stability / ensemble signal
        ccp_hc = pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"),
        ccp_km = pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour"),
        cfg = CFGFILE_ABS
    output:
        rds = pan_tnh_final("{direction}", "rds"),
        tsv = pan_tnh_final("{direction}", "tsv")
    log:
        os.path.join(PAN_LOGROOT, "tumour_neighbourhoods", "{direction}", "p_consensus.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output.rds}")"

        Rscript "{SCRIPTS_DIR}/tumour_neighbourhood_p_consensus.R" \
          --config "{input.cfg}" \
          --profile "{profile_name}" \
          --direction "{wildcards.direction}" \
          --workdir "{BASE}" \
          --ccp_hc_rds "{input.ccp_hc}" \
          --ccp_kmeans_rds "{input.ccp_km}" \
          --meta_tsv "{input.meta}" \
          --out_rds "{output.rds}" \
          --out_tsv "{output.tsv}" \
          2>&1 | tee "{log}"
        '''

# Pan-cancer DSMZ-DSMZ graphs from p-consensus (global + within)
# Uses patched compute_cell_line_similarity.R with pan-cancer support
def pan_pcons_tsv(wc):
    """Helper: path to pan-cancer p-consensus TSV for a direction"""
    return os.path.join(
        PAN_TNH_ROOT, wc.direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{wc.direction}.tsv"
    )

rule pan_cancer_dsmz_dsmz_graph:
    input:
        # ensures p-consensus exists first
        pcons_tsv = pan_pcons_tsv,
        # needed for disease annotations + within-mode restriction
        meta_tsv  = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg       = CFGFILE_ABS
    output:
        # script writes many files into this directory; declare a few key "targets"
        edges_tsv   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
        nodes_tsv   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_node_annotations_{direction}.tsv"),
        graphml     = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_graph_{direction}.graphml"),
        sim_pairs   = os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                                   "DSMZ_DSMZ_similarity_pairs_{direction}.tsv")
    params:
        pan_outdir = PAN_OUTDIR,
        cross_thr  = float(PAN_CFG.get("dsmz_cross_disease_threshold", 0.85))
    log:
        os.path.join(PAN_GRAPH_LOGROOT, "dsmz_dsmz_{mode}_{direction}.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname "{output.edges_tsv}")" "$(dirname "{log}")"

        Rscript "{SCRIPTS_DIR}/compute_cell_line_similarity.R" \
          --config "{input.cfg}" \
          --profile "{profile_name}" \
          --direction "{wildcards.direction}" \
          --meta_tsv "{input.meta_tsv}" \
          --mode "{wildcards.mode}" \
          --cross_threshold {params.cross_thr} \
          --pan_outdir "{params.pan_outdir}" \
          > "{log}" 2>&1

        # Sanity checks: fail if expected outputs weren't produced
        test -s "{output.edges_tsv}"
        test -s "{output.nodes_tsv}"
        test -s "{output.graphml}"
        test -s "{output.sim_pairs}"
        """

# ==============================================================================
# PAN-CANCER FINAL CONSENSUS ALL (aggregation across directions)
# ==============================================================================

PAN_P_CONS_ALL_DIR = os.path.join(PAN_TNH_ROOT, "final_consensus_all")

rule pan_summarize_p_consensus_all:
    input:
        consensus_rds = [pan_tnh_final(d, "rds") for d in PAN_CANCER_DIRECTIONS],
        cfg = CFGFILE_ABS
    output:
        dir_summary = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_direction_summary.tsv"),
        cell_dir_summary = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.tsv"),
        winner_map = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_winner_map_per_cell_line.tsv"),
        winners_max_p = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_winners_by_max_p.tsv"),
        winners_frac = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_winners_by_frac_ge_thr.tsv"),
        ranked_best = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_best_cell_lines_ranked.tsv"),
        long_tbl = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.long.tsv"),
        composite_weights = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_composite_weights.tsv"),
        top_fraction = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_fraction.tsv"),
        top_score = os.path.join(PAN_P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_score.tsv"),
        fig_pdf = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_p_consensus_direction_comparison.pdf"),
        fig_scree = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_scree.pdf"),
        fig_weights = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_weights.pdf")
    params:
        script = os.path.join(BASE, "scripts", "summarize_p_consensus_all.R"),
        config = os.path.join(BASE, "config", "config.yaml"),
        threshold = lambda wc: PAN_CFG.get("tumour_neighbourhoods", {}).get("p_consensus_threshold", 0.7)
    log: os.path.join(PAN_LOGROOT, "summarize_p_consensus_all.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        Rscript {params.script} \
          --config {params.config} \
          --profile "pan_cancer" \
          --threshold {params.threshold} \
          > {log} 2>&1
        '''

rule pan_plot_winners_by_frac_ge_thr:
    input:
        winners_frac = rules.pan_summarize_p_consensus_all.output.winners_frac,
        cfg = CFGFILE_ABS
    output:
        fig_pdf = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_p_consensus_winners_by_frac_ge_thr.pdf"),
        fig_png = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_p_consensus_winners_by_frac_ge_thr.png")
    params:
        script = os.path.join(BASE, "scripts", "plot_winners_by_frac_ge_thr.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(PAN_LOGROOT, "plot_winners_by_frac_ge_thr.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        Rscript {params.script} \
          --config {params.config} \
          --profile "pan_cancer" \
          --winners_tsv {input.winners_frac} \
          --output_prefix {PAN_P_CONS_ALL_DIR}/Fig_p_consensus_winners_by_frac_ge_thr \
          > {log} 2>&1
        '''

rule pan_resolve_dsmz_graph_neighbors:
    input:
        # Pan-cancer graphs: use "within" mode (same-cancer-type only) for better separation
        # Note: graph files are discovered dynamically by the script, so we don't require them all here
        graph_dummy = expand(
            os.path.join(PAN_GRAPH_ROOT, "within", "{direction}",
                        "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
            direction=PAN_CANCER_DIRECTIONS
        ),
        # Optional: winners file for cell-line-specific representation selection
        winners_frac = rules.pan_summarize_p_consensus_all.output.winners_frac,
        cfg = CFGFILE_ABS
    output:
        resolved_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "resolved_dsmz_neighbors.tsv")
    params:
        script = os.path.join(BASE, "scripts", "resolve_dsmz_graph_neighbors.R"),
        mode = "intersection",  # or "kofn" for k-of-n mode
        k = 2,  # minimum reps for kofn mode
        graph_root = os.path.join(PAN_GRAPH_ROOT, "within")  # Pan-cancer graphs: use "within" mode for same-cancer-type only
    log: os.path.join(PAN_LOGROOT, "resolve_dsmz_graph_neighbors.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        Rscript {params.script} \
          --config {input.cfg} \
          --profile "pan_cancer" \
          --winners_tsv {input.winners_frac} \
          --mode {params.mode} \
          --k {params.k} \
          --graph_root {params.graph_root} \
          --output_tsv {output.resolved_tsv} \
          > {log} 2>&1
        '''

rule pan_visualize_resolved_dsmz_graph:
    input:
        resolved_tsv = rules.pan_resolve_dsmz_graph_neighbors.output.resolved_tsv,
        metadata_tsv = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg = CFGFILE_ABS
    output:
        fig_png = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_dsmz_cellline_graph.png"),
        fig_pdf = os.path.join(PAN_P_CONS_ALL_DIR, "Fig_dsmz_cellline_graph.pdf"),
        edges_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "dsmz_cellline_graph_edges.tsv"),
        node_stats_tsv = os.path.join(PAN_P_CONS_ALL_DIR, "dsmz_cellline_graph_node_stats.tsv")
    params:
        script = os.path.join(BASE, "scripts", "visualize_resolved_dsmz_graph.py"),
        cancer_type = "Pan-Cancer"
    log: os.path.join(PAN_LOGROOT, "visualize_resolved_dsmz_graph.log")
    conda: os.path.join(BASE, "envs", "python-graph-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p {PAN_P_CONS_ALL_DIR}
        # Use Python from the activated conda environment
        # $CONDA_PREFIX should be set by Snakemake's conda activation
        if [ -n "$CONDA_PREFIX" ] && [ -f "$CONDA_PREFIX/bin/python" ]; then
            PYTHON_CMD="$CONDA_PREFIX/bin/python"
        else
            PYTHON_CMD=python
        fi
        $PYTHON_CMD {params.script} \
          {input.resolved_tsv} \
          {PAN_P_CONS_ALL_DIR}/Fig_dsmz_cellline_graph \
          {params.cancer_type} \
          {input.metadata_tsv} \
          > {log} 2>&1
        '''

# Target rule for pan-cancer "like per-disease" pipeline
rule pan_cancer_like_per_disease_targets:
    input:
        # all 6 clusterings per direction
        expand(pan_agn_out("{direction}", "hc", "cell"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "hc", "tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "hc", "cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "cell"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_agn_out("{direction}", "kmeans", "cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        # consensus per direction
        expand(pan_cons_out("{direction}", "ccp_hc_expr_cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_cons_out("{direction}", "ccp_kmeans_expr_cell_tumour"), direction=PAN_CANCER_DIRECTIONS),
        # final p-consensus per direction
        expand(pan_tnh_final("{direction}", "rds"), direction=PAN_CANCER_DIRECTIONS),
        expand(pan_tnh_final("{direction}", "tsv"), direction=PAN_CANCER_DIRECTIONS),
        # DSMZ-DSMZ similarity graphs (both global and within modes)
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS),
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_{direction}.graphml"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS),
        # Pan-cancer final_consensus_all outputs
        rules.pan_summarize_p_consensus_all.output.fig_pdf,
        rules.pan_plot_winners_by_frac_ge_thr.output.fig_pdf,
        rules.pan_resolve_dsmz_graph_neighbors.output.resolved_tsv,
        rules.pan_visualize_resolved_dsmz_graph.output.fig_pdf

# Pan-cancer graph targets (standalone rule for graph generation)
rule pan_cancer_graph_targets:
    input:
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS),
        expand(os.path.join(PAN_GRAPH_ROOT, "{mode}", "{direction}",
                            "DSMZ_DSMZ_graph_{direction}.graphml"),
               mode=PAN_GRAPH_MODES, direction=PAN_CANCER_DIRECTIONS)

# Legacy: Pan-cancer UMAP using joint HVG list (kept for backwards compatibility)
PAN_CANCER_UMAP_OUTDIR = os.path.join(BASE, "results", "unsupervised", "pan_cancer", "umap")

rule pan_cancer_umap_hvg:
    input:
        config = CFGFILE_ABS
    output:
        coords = os.path.join(PAN_CANCER_UMAP_OUTDIR, "pan_cancer_hvg_umap_coords.tsv"),
        plot = os.path.join(PAN_CANCER_UMAP_OUTDIR, "pan_cancer_hvg_umap_plot.pdf")
    params:
        profiles = "brca,nbl,rbl",  # Can be overridden via --config
        outdir = PAN_CANCER_UMAP_OUTDIR,
        n_pcs = 50,
        n_neighbors = 15,
        min_dist = 0.1
    log: os.path.join(BASE, "logs", "pan_cancer_umap_hvg.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/pan_cancer_umap_hvg.R \
          --config {input.config} \
          --profiles {params.profiles} \
          --outdir {params.outdir} \
          --n_pcs {params.n_pcs} \
          --n_neighbors {params.n_neighbors} \
          --min_dist {params.min_dist} \
          > {log} 2>&1
        '''
# ==============================================================================
# DEBUG / MAINTENANCE TARGETS
# ==============================================================================

# Smoke test: minimal validation (run explicitly: ./run_pipeline.sh ... smoke_test)
rule smoke_test:
    input:
        cfg = CFGFILE_ABS
    output:
        touch(os.path.join(LOGROOT, "smoke_test.done"))
    log:
        os.path.join(LOGROOT, "smoke_test.log")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output}")" "$(dirname "{log}")"
        {
            echo "[SMOKE TEST] Pipeline root: {BASE}"
            echo "[SMOKE TEST] Profile: {profile_name}"
            echo "[SMOKE TEST] Config: {input.cfg}"
            echo "[SMOKE TEST] Log root: {LOGROOT}"
            [ -f "{input.cfg}" ] || { echo "ERROR: Config not found"; exit 1; }
            grep -q "^  {profile_name}:" "{input.cfg}" || { echo "ERROR: Profile not found"; exit 1; }
            echo "[SMOKE TEST] SUCCESS"
        } | tee "{log}"
        touch "{output}"
        '''
