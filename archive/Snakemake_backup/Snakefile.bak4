        '''

rule agnostic_all_directions:
    input:
        expand(os.path.join(AGN_ROOT_REL, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_DIRECTIONS, kind=HC_KINDS),
        expand(os.path.join(AGN_ROOT_REL, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_EUC_DIRECTIONS, kind=KM_KINDS)

# STEP 2: Consensus Clustering

CONS_ROOT = os.path.join(UNSUP, "consensus")
CONS_KM_KINDS = ["ccp_kmeans_expr_cell_tumour", "ccp_kmeans_pca_cell_tumour", "ccp_kmeans_expr_cell", "ccp_kmeans_pca_cell", "ccp_kmeans_expr_tumour", "ccp_kmeans_pca_tumour"]
CONS_HC_KINDS = ["ccp_hc_expr_cell_tumour", "ccp_hc_pca_cell_tumour", "ccp_hc_expr_cell", "ccp_hc_pca_cell", "ccp_hc_expr_tumour", "ccp_hc_pca_tumour"]

# Filter out PCA consensus kinds if disable_pca_everywhere is set (for pan-cancer)
if DISABLE_PCA_EVERYWHERE:
    CONS_KM_KINDS = [k for k in CONS_KM_KINDS if "_pca_" not in k]
    CONS_HC_KINDS = [k for k in CONS_HC_KINDS if "_pca_" not in k]
    vprint(f"[Snakefile] Filtered PCA consensus kinds: CONS_KM_KINDS={CONS_KM_KINDS}, CONS_HC_KINDS={CONS_HC_KINDS}")

# Build dynamic pattern for consensus kind wildcard constraint
CONS_KIND_PATTERN = "|".join(map(re.escape, CONS_KM_KINDS + CONS_HC_KINDS))

def cons_outdir(direction, kind):
    return os.path.join(CONS_ROOT, direction, kind)

def kind_to_mode(kind):
    return "pca" if "_pca_" in kind else "expr"

def kind_to_alg(kind):
    return "hc" if kind.startswith("ccp_hc_") else "km"

rule consensus_ccp_cell_tumour:
    input:
        config = CFGFILE_ABS,
        hvg_list = rules.feature_selection_unsupervised.output.hvg_list  # Explicit dependency on producer rule
    output:
        cluster_rds = os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds")
    params:
        outdir = lambda wc: cons_outdir(wc.direction, wc.kind),
        mode = lambda wc: kind_to_mode(wc.kind),
        alg = lambda wc: kind_to_alg(wc.kind)
    log: os.path.join(LOGROOT, "consensus_ccp_{direction}_{kind}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=CONS_DIRECTION_PATTERN,
        kind=CONS_KIND_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript {SCRIPTS_DIR}/consensus_ccp_cell_tumour.R \
          --config {input.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --hvg_list {input.hvg_list} \
          --kind {wildcards.kind} \
          --mode {params.mode} \
          --alg {params.alg} \
          --outdir {params.outdir} \
          --cluster_rds {output.cluster_rds} > {log} 2>&1
        '''

rule consensus_all_directions:
    input:
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_DIRECTIONS, kind=CONS_HC_KINDS),
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_EUC_DIRECTIONS, kind=CONS_KM_KINDS)

# STEP 3: Tumour Neighbourhood Analysis
# KEY FIX: Separate map_rds files for PAM50 and HVG

TUMOUR_NH_ROOT = os.path.join(UNSUP, "tumour_neighbourhoods")

# Always derive defaults from the profile-specific tumour_nh_input_root
# (keeps the pipeline portable; config can still override)
# Use ABSOLUTE paths for outputs (for --directory compatibility)
# HVG inputs (always present) - absolute, derived from UNSUP
TUMOUR_NH_EXPR_HVG = os.path.join(TUMOUR_NH_INPUT_ROOT, "expr_hvg.rds")
TUMOUR_NH_MAP_RDS_HVG = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_hvg.rds")

# PAM50 inputs (only if enabled) - absolute, derived from UNSUP
if USE_PAM50:
    TUMOUR_NH_EXPR_PAM50 = os.path.join(TUMOUR_NH_INPUT_ROOT, "expr_pam50.rds")
    TUMOUR_NH_MAP_RDS_PAM50 = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_pam50.rds")
else:
    TUMOUR_NH_EXPR_PAM50 = None
    TUMOUR_NH_MAP_RDS_PAM50 = None

# Helper functions for tumour neighbourhood paths
def nh_expr_rds(direction):
    """Get expression matrix RDS path for a direction (absolute for --directory compatibility)"""
    feature = dir_to_feature(direction)
    if feature == "pam50":
        if TUMOUR_NH_EXPR_PAM50:
            return TUMOUR_NH_EXPR_PAM50
        raise ValueError("PAM50 expression path missing while use_pam50 is enabled")
    elif feature == "hvg":
        return TUMOUR_NH_EXPR_HVG
    else:
        # For new feature sets, use the featuresets directory (absolute via FEATURE_METHOD_OUTDIR)
        return os.path.join(FEATURE_METHOD_OUTDIR, feature, "expr_submatrix.rds")

def nh_map_rds(direction):
    """Get mapping RDS path for a direction (absolute for --directory compatibility)"""
    feature = dir_to_feature(direction)
    if feature == "pam50":
        if TUMOUR_NH_MAP_RDS_PAM50:
            return TUMOUR_NH_MAP_RDS_PAM50
        raise ValueError("PAM50 map path missing while use_pam50 is enabled")
    elif feature == "hvg":
        return TUMOUR_NH_MAP_RDS_HVG
    else:
        # For new feature sets, create mapping file in tumour_neighbourhoods_input (absolute via TUMOUR_NH_INPUT_ROOT)
        return os.path.join(TUMOUR_NH_INPUT_ROOT, f"cell_line_to_original_sample_id_{feature}.rds")

# Canonical path helpers for tumour neighbourhood outputs (single source of truth)
def nh_final_consensus_rds(direction):
    return os.path.join(
        TUMOUR_NH_ROOT, direction, "final_consensus",
        f"Final_consensus_tumour_neighbourhoods_{direction}.rds"
    )

def nh_qc_dir(direction):
    return os.path.join(TUMOUR_NH_ROOT, direction, "qc")

def nh_qc_tsv(direction):
    return os.path.join(nh_qc_dir(direction), "nh_qc_summary.tsv")

def nh_umap_tsv(direction):
    return os.path.join(nh_qc_dir(direction), "nh_umap.tsv")

def nh_umap_pdf(direction):
    return os.path.join(nh_qc_dir(direction), "nh_umap.pdf")

if USE_PAM50:
    rule build_tumour_neighbourhood_input_pam50:
        input:
            tcga_pam50 = cfgabs("paths", "tcga_brca_pam50_expr") if "tcga_brca_pam50_expr" in cfg["paths"] else cfgabs("paths", "tcga_pam50_expr"),
            dsmz_pam50 = cfgabs("paths", "dsmz_bcc_pam50_expr") if "dsmz_bcc_pam50_expr" in cfg["paths"] else cfgabs("paths", "dsmz_pam50_expr"),
            dsmz_meta = cfgabs("paths", "dsmz_meta_csv")
        output:
            expr_rds = TUMOUR_NH_EXPR_PAM50,
            map_rds = TUMOUR_NH_MAP_RDS_PAM50
        log: os.path.join(LOGROOT, "build_tumour_neighbourhood_input_pam50.log")
        conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
        shell:
            r'''
            mkdir -p $(dirname {output.expr_rds}) $(dirname {output.map_rds})
            Rscript {SCRIPTS_DIR}/build_dsmz_tcga_pam50matrix.R --config {CFGFILE_ABS} --profile "{profile_name}" > {log} 2>&1
            test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
            test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
            '''

rule build_tumour_neighbourhood_input_hvg:
    input:
        vst = VST_JOINT,
        gene_list = rules.feature_selection_unsupervised.output.hvg_list,  # Explicit dependency on producer rule
        dsmz_meta = cfgabs("paths", "dsmz_meta_csv"),  # Input needs absolute (external file)
        cfg = CFGFILE_ABS
    output:
        expr_rds = TUMOUR_NH_EXPR_HVG,
        map_rds = TUMOUR_NH_MAP_RDS_HVG
    params:
        direction = "hvg"
    log: os.path.join(LOGROOT, "build_tumour_neighbourhood_input_hvg.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        mkdir -p $(dirname {output.expr_rds})
        Rscript {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R \
          --config {input.cfg} \
          --profile "{profile_name}" \
          --scripts_dir "{SCRIPTS_DIR}" \
          --vst {input.vst} \
          --gene-list {input.gene_list} \
          --dsmz-meta {input.dsmz_meta} \
          --expr-out {output.expr_rds} \
          --map-out {output.map_rds} \
          --direction {params.direction} > {log} 2>&1
        test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
        test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
        '''

# Generalized rule for building tumour neighbourhood inputs for new feature sets
# Uses the same parameterized builder as the HVG path to avoid hard-coding HVG logic
rule build_tumour_neighbourhood_input_featureset:
    input:
        vst = VST_JOINT,
        gene_list = lambda wc: os.path.join(FEATURESETS_DIR, f"genes_top{TOPN}_{wc.feature}.txt"),
        dsmz_meta = cfgabs("paths", "dsmz_meta_csv"),  # Input needs absolute
        cfg = CFGFILE_ABS
    output:
        expr_rds = os.path.join(FEATURE_METHOD_OUTDIR, "{feature}", "expr_submatrix.rds"),
        map_rds = os.path.join(TUMOUR_NH_INPUT_ROOT, "cell_line_to_original_sample_id_{feature}.rds")
    log: os.path.join(LOGROOT, "build_tumour_neighbourhood_input_{feature}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        feature="|".join(map(re.escape, FEATURE_METHODS))
    shell:
        r'''
        mkdir -p $(dirname {output.expr_rds}) $(dirname {output.map_rds})
        echo "[DEBUG] CONDA_PREFIX=${{CONDA_PREFIX:-NA}}" >> {log} 2>&1
        which Rscript >> {log} 2>&1
        Rscript --version >> {log} 2>&1
        echo "[DEBUG] Script path: {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R" >> {log} 2>&1
        ls -lh {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R >> {log} 2>&1
        "${{CONDA_PREFIX}}/bin/Rscript" --vanilla {SCRIPTS_DIR}/build_tumour_neighbourhood_input.R \
          --config {input.cfg} \
          --profile "{profile_name}" \
          --scripts_dir "{SCRIPTS_DIR}" \
          --vst {input.vst} \
          --gene-list {input.gene_list} \
          --dsmz-meta {input.dsmz_meta} \
          --expr-out {output.expr_rds} \
          --map-out {output.map_rds} \
          --direction {wildcards.feature} >> {log} 2>&1
        test -s {output.expr_rds} || (echo "ERROR: missing {output.expr_rds}" >&2; exit 1)
        test -s {output.map_rds}  || (echo "ERROR: missing {output.map_rds}"  >&2; exit 1)
        '''

# ---- explicit tumour neighbourhood rules (NO lambda) ----

rule tumour_neighbourhoods_hc_hvg:
    input:
        expr_rds = TUMOUR_NH_EXPR_HVG,
        map_rds = TUMOUR_NH_MAP_RDS_HVG
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
    params:
        script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(LOGROOT, "tumour_neighbourhoods_hc_{direction}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction="hvg_euc|hvg_corr"
    shell:
        r'''
        mkdir -p $(dirname {output.done})
        Rscript {params.script} \
          --config {params.config} \
          --profile "{profile_name}" \
          --direction {wildcards.direction} \
          --expr-rds {input.expr_rds} \
          --mapping-rds {input.map_rds} \
          > {log} 2>&1
        test $(find {TUMOUR_NH_ROOT}/{wildcards.direction} -maxdepth 2 -type f -name "Top_m_long_*.csv" | wc -l) -gt 0 || (echo "ERROR: No Top_m_long_*.csv" >&2 && exit 1)
        touch {output.done}
        '''

if USE_PAM50:
    rule tumour_neighbourhoods_hc_pam50:
        input:
            expr_rds = TUMOUR_NH_EXPR_PAM50,
            map_rds = TUMOUR_NH_MAP_RDS_PAM50
        output:
            done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
        params:
            script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R"),
            config = os.path.join(BASE, "config", "config.yaml")
        log: os.path.join(LOGROOT, "tumour_neighbourhoods_hc_{direction}.log")
        conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
        wildcard_constraints:
            direction="pam50_euc|pam50_corr"
        shell:
            r'''
            mkdir -p $(dirname {output.done})
            Rscript {params.script} \
              --config {params.config} \
              --profile "{profile_name}" \
              --direction {wildcards.direction} \
              --expr-rds {input.expr_rds} \
              --mapping-rds {input.map_rds} \
              > {log} 2>&1
            test $(find {TUMOUR_NH_ROOT}/{wildcards.direction} -maxdepth 2 -type f -name "Top_m_long_*.csv" | wc -l) -gt 0 || (echo "ERROR: No Top_m_long_*.csv" >&2 && exit 1)
            touch {output.done}
            '''

# Generalized rule for tumour neighbourhoods with new feature sets
rule tumour_neighbourhoods_hc_featureset:
    input:
        expr_rds = lambda wc: nh_expr_rds(wc.direction),
        map_rds = lambda wc: nh_map_rds(wc.direction)
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
    params:
        script = os.path.join(BASE, "scripts", "comp_tumour_neighbourhoods.R"),
        config = os.path.join(BASE, "config", "config.yaml")
    log: os.path.join(LOGROOT, "tumour_neighbourhoods_hc_{direction}.log")
    conda: os.path.join(BASE, "envs", "tcga-r-env.yaml")
    wildcard_constraints:
        direction=FEATURE_SET_DIR_PATTERN
