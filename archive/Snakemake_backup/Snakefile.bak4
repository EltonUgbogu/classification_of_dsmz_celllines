# Pan-cancer agnostic clustering rules (hc/kmeans × cell/tumour/cell_tumour)
# Outputs match per-disease naming exactly: {kind}_{view}_clusters_optimal.rds

rule hc_cell_pan:
    input:
        expr = pan_expr_submatrix,
        meta = os.path.join(PAN_OUTDIR, "inputs", "joint_metadata.tsv"),
        cfg  = CFGFILE_ABS
    output:
        pan_agn_out("{direction}", "hc", "cell")
    log:
        os.path.join(PAN_LOGROOT, "agnostic_clustering", "{direction}", "hc_cell.log")
    conda:
        os.path.join(BASE, "envs", "tcga-r-env.yaml")
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname "{output}")"
        Rscript "{SCRIPTS_DIR}/pan_agnostic_clustering.R" \
          --expr_rds "{input.expr}" \
          --meta_tsv "{input.meta}" \
          --direction "{wildcards.direction}" \
          --kind "hc" \
          --view "cell" \
          --out_rds "{output}" \
          > "{log}" 2>&1
        '''

