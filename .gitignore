# =========================================================

# .gitignore

# Git policy for classification_of_dsmz_celllines.

#

# GitHub tracks source code, configuration, documentation,

# selected final figures, and selected lightweight final tables.

# HPC retains raw data, references, intermediates, runtime state,

# and bulky generated outputs.

# =========================================================

# -----------------------------
# Markdown notes require explicit manual upload
# -----------------------------
*.md
*.mds

# -----------------------------

# Snakemake runtime internals

# -----------------------------

.snakemake/
**/.snakemake/

# -----------------------------

# Scheduler, runtime, and temporary logs

# -----------------------------

logs/
benchmarks/
tmp/
**/tmp/
*.out
*.err

# -----------------------------

# Raw sequencing and alignment artifacts

# -----------------------------

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.sra

# -----------------------------

# Reference genomes, indexes, and annotations

# -----------------------------

*.fa
*.fasta
*.fna
*.gtf
*.gtf.gz

data/reference/
data/HISAT2/genome/
HISAT2/genome/

# -----------------------------

# Count matrices and large analysis objects

# -----------------------------

count_data/
**/count_data/
valid_count/
**/valid_count/

*.tab
*.rds
*.Rds
*.RData
*.parquet

# -----------------------------

# Conda/runtime payloads

# -----------------------------

envs/.conda/
**/envs/.conda/
miniconda3/
.conda/
.cache/

# Keep Conda environment specification files.

!envs/*.yaml
!envs/*.yml

# -----------------------------

# Python and R runtime artifacts

# -----------------------------

**pycache**/
**/**pycache**/
*.pyc
*.pyo

.Rhistory
.RData
.Rproj.user/
.Rcache/
*.Rcheck/

# -----------------------------

# Local editor and OS artifacts

# -----------------------------

.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# -----------------------------

# Backup and obsolete files

# -----------------------------

*.bak
archive/
archives/
backup/
backups/
old/
deprecated/
*archive*
*backup*
*deprecated*

# -----------------------------

# Data directory policy

# -----------------------------

# Raw and bulky data remain on HPC.

data/

# Small curated metadata should be stored outside data/, preferably:

# resources/

# metadata/

# config/

# -----------------------------

# Results directory policy

# -----------------------------

# Full generated results remain on HPC.

results/*

# Selected final lightweight outputs may be versioned.

!results/README.md
!results/.gitkeep

!results/final_tables/
!results/final_tables/**
!results/curated/
!results/curated/**

# -----------------------------

# Figure policy

# -----------------------------

# Curated final figures are allowed in GitHub.

# Do not place bulk diagnostic plot trees in figures/.

!figures/
!figures/**

!Thesis_writeup/
!Thesis_writeup/**
!Thesis_writeup/Figures/
!Thesis_writeup/Figures/**

# -----------------------------

# Large packaged artifacts

# -----------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz

# -----------------------------

# Secrets and local credentials

# -----------------------------

.secrets/
.ssh/
*.pem
*.key
.env
.env.*

# -----------------------------
# Local home-directory artifacts accidentally copied or created locally
# -----------------------------
.Rprofile
.TinyTeX/
.bash_history
.bash_logout
.bashrc
.condarc
.config/
.codex/
.cursor/
.gh_env
.gitconfig
.ipython/
.java/
.jupyter/
.lesshst
.ncbi/
.pki/
.profile
.vscode-R/
.wget-hsts

# Markdown files require explicit force-add.
*.md
*.mds

# -----------------------------
# Generated analysis exports not tracked by default
# -----------------------------
derived_results/
exploratory_257_gene_pan_cancer_network_sensitivity/
reference_data/
supplementary_data/257/

# Markdown files require explicit force-add.
*.md
*.mds

# Supplementary generated outputs require explicit force-add.
supplementary_data/
