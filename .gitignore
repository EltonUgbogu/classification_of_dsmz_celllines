# =========================================================

# .gitignore

# Git policy for classification_of_dsmz_celllines.

#

# GitHub tracks source code, configuration, documentation,

# selected final figures, and selected lightweight final tables.

# HPC retains raw data, references, intermediates, runtime state,

# and bulky generated outputs.

# =========================================================

# -----------------------------
# Markdown notes require explicit manual upload
# -----------------------------
*.md
*.mds

# -----------------------------

# Snakemake runtime internals

# -----------------------------

.snakemake/
**/.snakemake/

# -----------------------------

# Scheduler, runtime, and temporary logs

# -----------------------------

logs/
benchmarks/
tmp/
**/tmp/
*.out
*.err

# -----------------------------

# Raw sequencing and alignment artifacts

# -----------------------------

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.sra

# -----------------------------

# Reference genomes, indexes, and annotations

# -----------------------------

*.fa
*.fasta
*.fna
*.gtf
*.gtf.gz

data/reference/
data/HISAT2/genome/
HISAT2/genome/

# -----------------------------

# Count matrices and large analysis objects

# -----------------------------

count_data/
**/count_data/
valid_count/
**/valid_count/

*.tab
*.rds
*.Rds
*.RData
*.parquet

# -----------------------------

# Conda/runtime payloads

# -----------------------------

envs/.conda/
**/envs/.conda/
miniconda3/
.conda/
.cache/

# Keep Conda environment specification files.

!envs/*.yaml
!envs/*.yml

# -----------------------------

# Python and R runtime artifacts

# -----------------------------

**pycache**/
**/**pycache**/
*.pyc
*.pyo

.Rhistory
.RData
.Rproj.user/
.Rcache/
*.Rcheck/

# -----------------------------

# Local editor and OS artifacts

# -----------------------------

.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# -----------------------------

# Backup and obsolete files

# -----------------------------

*.bak
archive/
archives/
backup/
backups/
old/
deprecated/
*archive*
*backup*
*deprecated*

# -----------------------------

# Data directory policy

# -----------------------------

# Raw and bulky data remain on HPC.

data/

# -----------------------------


# -----------------------------

# Large packaged artifacts

# -----------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz

# -----------------------------

# Secrets and local credentials

# -----------------------------

.secrets/
.ssh/
*.pem
*.key
.env
.env.*

# -----------------------------
# Local home-directory artifacts accidentally copied or created locally
# -----------------------------
.Rprofile
.TinyTeX/
.bash_history
.bash_logout
.bashrc
.condarc
.config/
.codex/
.cursor/
.gh_env
.gitconfig
.ipython/
.java/
.jupyter/
.lesshst
.ncbi/
.pki/
.profile
.vscode-R/
.wget-hsts

# Markdown files require explicit force-add.
*.md
*.mds

# Markdown files require explicit force-add.
*.md
*.mds

