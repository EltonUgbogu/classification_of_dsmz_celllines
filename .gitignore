# =========================================================
# classification_of_dsmz_celllines/.rsyncignore
# Repo-specific policy for sync from jarvis -> local repo
#
# Keep:
# - workflow source code
# - config
# - scripts
# - lightweight curated text/tabular summaries
#
# Exclude:
# - raw sequencing/alignment files
# - STAR internals and runtime output
# - FASTQC packaged outputs
# - per-sample count exports / count matrices
# - references, indexes, caches, environments, bulky artifacts
# =========================================================

# -----------------------------
# Snakemake runtime internals
# -----------------------------
.snakemake/
**/.snakemake/
**/.snakemake/conda/
**/.snakemake/conda-*/
**/.snakemake/shadow/
**/.snakemake/tmp*/
**/.snakemake/log/
**/.snakemake/metadata/

# -----------------------------
# Raw sequencing / alignment files
# -----------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.sra

pipeline/data/**/fastq/
pipeline/data/**/bam/
pipeline/data/**/sra/
pipeline/data/**/tmp/

# -----------------------------
# Reference / index assets
# -----------------------------
*.fa
*.fasta
*.fna
*.gtf
*.gtf.gz

pipeline/data/reference/gencode_v44/
pipeline/data/reference/**/GRCh38.primary_assembly.genome.fa
pipeline/data/reference/star_*/
pipeline/data/HISAT2/genome/
pipeline/data/HISAT2/genome/grch38/
Trimmomatic-0.39/
HISAT2/genome/

# -----------------------------
# R / Python / environment artifacts
# -----------------------------
.Rhistory
.RData
.Rproj.user/
.Rcache/
*.Rcheck/
*.rds
*.Rds
*.bak

__pycache__/
*.pyc
*.pyo

miniconda3/
**/envs/.conda/
*.dist-info/
*.egg-info/

# -----------------------------
# Generated bulky artifacts
# -----------------------------
*.parquet
*.zip
*.tar.gz

benchmarks/
bin/
tmp/
illumina/
snap/
actions-runner/

# -----------------------------
# pipeline/data results policy
# Keep curated summaries, exclude runtime/intermediate clutter
# -----------------------------

# FASTQC archives and folders
pipeline/data/**/results/fastqc/
pipeline/data/**/results/fastqc/**

# STAR output trees
pipeline/data/**/results/star/
pipeline/data/**/results/star/**

# Extra hard-block STAR internals anywhere under pipeline/data
pipeline/data/**/*_STARtmp/
pipeline/data/**/*_STARtmp/**
pipeline/data/**/*_STARgenome/
pipeline/data/**/*_STARgenome/**
pipeline/data/**/*_STARpass1/
pipeline/data/**/*_STARpass1/**

# Count exports / matrices
pipeline/data/**/count_data/
pipeline/data/**/count_data/**
pipeline/data/**/valid_count/
pipeline/data/**/valid_count/**
pipeline/data/**/*.tab

# STAR logs and splice junction tables
pipeline/data/**/*.Log.out
pipeline/data/**/*.Log.progress.out
pipeline/data/**/*.Log.final.out
pipeline/data/**/*.SJ.out.tab

# Scheduler/runtime logs anywhere under pipeline
pipeline/**/*.out
pipeline/**/*.err

# TARGET payload / manifest JSONs
pipeline/data/nbl/target_nbl/manifests/*.json
pipeline/data/nbl/target_nbl/metadata/payload*.json

# -----------------------------
# Local-user / editor noise
# -----------------------------
.DS_Store
.vscode/
.idea/
*~
*.swp
*.tmp
.TinyTeX/

.codex/
jarvis_pipeline_data

.cache/
.conda/
.config/
.cursor/
.ipython/
.java/
.jupyter/
.ncbi/
.pki/
.secrets/
.ssh/
.vscode-R/

.Rprofile
.bash_history
.bash_logout
.bashrc
.condarc
.gh_env
.gitconfig
.lesshst
.profile
.wget-hsts

# -----------------------------
# Explicitly keep lightweight outputs
# -----------------------------
!*.txt
!*.tsv
!*.csv