# Snakemake runtime (huge)
.snakemake/
**/.snakemake/

# FASTQC artifacts
**/results/fastqc/
**/results/fastqc/**

# STAR runtime / intermediate outputs
**/results/star/
**/results/star/**
**/*_STARtmp/
**/*_STARtmp/**
**/*_STARgenome/
**/*_STARgenome/**
**/*_STARpass1/
**/*_STARpass1/**

# STAR logs and splice junction outputs
*.Log.out
*.Log.progress.out
*.Log.final.out
*.SJ.out.tab

# Count matrices / per-sample count exports
count_data/
**/count_data/
**/valid_count/
**/valid_count/**
*.tab

# Big / generated directories inside pipeline
logs/
*_family.soft.gz
data/reference/gencode_v44/
data/reference/**/GRCh38.primary_assembly.genome.fa
data/reference/star_*/
pipeline/data/reference/gencode_v44/
pipeline/data/reference/**/GRCh38.primary_assembly.genome.fa
pipeline/data/reference/star_*/
*.fa
*.fasta
*.fna
data/nbl/target_nbl/manifests/*.json
data/nbl/target_nbl/metadata/payload*.json
pipeline/data/nbl/target_nbl/manifests/*.json
pipeline/data/nbl/target_nbl/metadata/payload*.json

# Exclude generated conda payloads, but keep env spec files
envs/.conda/
**/envs/.conda/

# Large sequencing/alignment artifacts — directories first
**/fastq/
**/bam/
**/sra/
**/tmp/

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.sra
*.cram

