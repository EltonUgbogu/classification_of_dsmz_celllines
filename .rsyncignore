# Git policy for classification_of_dsmz_celllines

#

# Track source code, configuration, environment specifications, selected

# curated figures, and selected lightweight release files.

#

# Exclude raw data, reference indexes, generated intermediates, runtime

# state, local editor files, credentials, and bulky outputs.

# -----------------------------------------------------------------------------

# Markdown policy

# -----------------------------------------------------------------------------

# Markdown files are excluded by default and require explicit force-add.

# The top-level README remains tracked because it is already versioned.

*.md
*.mds
!README.md

# -----------------------------------------------------------------------------

# Snakemake runtime state

# -----------------------------------------------------------------------------

.snakemake/
**/.snakemake/

# -----------------------------------------------------------------------------

# Logs, scheduler output, benchmarks, and temporary files

# -----------------------------------------------------------------------------

logs/
benchmarks/
tmp/
**/tmp/
*.out
*.err
*.log

# -----------------------------------------------------------------------------

# Raw sequencing and alignment artifacts

# -----------------------------------------------------------------------------

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.sam
*.cram
*.crai
*.sra

# -----------------------------------------------------------------------------

# Reference genomes, indexes, and large annotations

# -----------------------------------------------------------------------------

*.fa
*.fasta
*.fna
*.gtf
*.gtf.gz
*.gff
*.gff3
*.gff.gz
*.gff3.gz

data/reference/
data/HISAT2/genome/
HISAT2/genome/
reference_data/

# -----------------------------------------------------------------------------

# Count matrices and large analysis objects

# -----------------------------------------------------------------------------

count_data/
**/count_data/
valid_count/
**/valid_count/

*.tab
*.rds
*.Rds
*.RData
*.parquet

# -----------------------------------------------------------------------------

# Conda and local runtime payloads

# -----------------------------------------------------------------------------

envs/.conda/
**/envs/.conda/
miniconda3/
.conda/
.cache/

# Keep Conda environment specifications.

!envs/*.yaml
!envs/*.yml

# -----------------------------------------------------------------------------

# Python and R runtime artifacts

# -----------------------------------------------------------------------------

**pycache**/
**/**pycache**/
*.pyc
*.pyo

.Rhistory
.Rproj.user/
.Rcache/
*.Rcheck/

# -----------------------------------------------------------------------------

# Local editor and operating-system artifacts

# -----------------------------------------------------------------------------

.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# -----------------------------------------------------------------------------

# Local home-directory artifacts accidentally copied into the repository

# -----------------------------------------------------------------------------

.Rprofile
.TinyTeX/
.bash_history
.bash_logout
.bashrc
.condarc
.config/
.codex/
.cursor/
.gh_env
.gitconfig
.ipython/
.java/
.jupyter/
.lesshst
.ncbi/
.pki/
.profile
.vscode-R/
.wget-hsts

# -----------------------------------------------------------------------------

# Local AI-agent working directories

# -----------------------------------------------------------------------------

.claude/
.codex_remote_edits/

# -----------------------------------------------------------------------------

# Backup, archive, and obsolete files

# -----------------------------------------------------------------------------

*.bak
archive/
archives/
backup/
backups/
old/
deprecated/
*archive*
*backup*
*deprecated*

# -----------------------------------------------------------------------------

# Data directory policy

# -----------------------------------------------------------------------------

# Raw and bulky data are excluded by default. Small curated metadata should be

# stored outside data/, preferably under resources/, metadata/, config/, or

# supplementary_data/.

data/

# -----------------------------------------------------------------------------

# Results directory policy

# -----------------------------------------------------------------------------

# Full generated results are excluded by default.

results/

# -----------------------------------------------------------------------------

# Figure policy

# -----------------------------------------------------------------------------

# Selected curated figures may be tracked. Bulk diagnostic plot trees should

# remain under ignored results directories.

!figures/
!figures/**

# -----------------------------------------------------------------------------

# Large packaged artifacts

# -----------------------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z

# -----------------------------------------------------------------------------

# Secrets and local credentials

# -----------------------------------------------------------------------------

.secrets/
.ssh/
*.pem
*.key
.env
.env.*
