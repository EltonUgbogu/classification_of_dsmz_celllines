__pycache__/
*.pyc
.Rhistory
.RData
*.rds
*.Rds
*.bak

# Reports / artifacts
*.pdf
*.html
*.parquet
*.png
*.jpg
*.jpeg

# Annotations (too big for GitHub)
*.gtf
*.gtf.gz

# Keep text/tabular files
!*.txt
!*.tsv
!*.csv
