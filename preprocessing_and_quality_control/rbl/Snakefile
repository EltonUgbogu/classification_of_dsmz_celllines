rule rbl_batch_effect_quantification:
    """PERMANOVA + betadisper and paired before/after PCA over three feature spaces.

    Reads the joint VST matrices; never writes one. Every file that can move a
    number -- matrices, coldata, pinned GTF, the shared module, this script and
    this Snakefile -- is a declared input and is checksummed into the provenance
    record.
    """
    input:
        joint_vst_pre_bc_rds = BATCH_OUTPUT["joint_vst_pre_bc_rds"],
        joint_vst_post_bc_rds = BATCH_OUTPUT["joint_vst_post_bc_rds"],
        tumour_vst_pre_bc_rds = BATCH_OUTPUT["tumour_vst_rds"],
        tumour_vst_post_bc_rds = BATCH_OUTPUT["tumour_vst_post_bc_rds"],
        dsmz_vst_pre_bc_collapsed_cellline_rds = BATCH_OUTPUT["dsmz_vst_pre_bc_collapsed_cellline_rds"],
        dsmz_vst_post_bc_collapsed_cellline_rds = BATCH_OUTPUT["dsmz_vst_post_bc_collapsed_cellline_rds"],
        retained_tumour_ids_tsv = RBL_PURITY_OUTPUTS["retained_samples"],
        coldata_tsv = BATCH_OUTPUT["coldata_tsv"],
        gene_annotation_gtf = GENE_ANNOTATION_GTF,
        shared_figure_module = SHARED_FIGURE_MODULE,
        quantification_script = BATCH_EFFECT_SCRIPT,
        snakefile = f"{WORKFLOW_DIR}/Snakefile",
    output:
        **BATCH_EFFECT_OUTPUTS,
    params:
        cohort = "RBL",
        repo_root = PIPELINE_DIR,
        master_seed = int(
            BATCH_CONFIG.get(
                "permutation_master_seed", BATCH_CONFIG.get("random_seed", 42)
            )
        ),
        qc_top_genes = int(BATCH_CONFIG.get("qc_top_variable_genes", 3000)),
        permanova_permutations = int(BATCH_CONFIG.get("permanova_permutations", 9999)),
        primary_predictor = BATCH_CONFIG.get("batch_effect_primary_predictor", "dataset"),
        # Column holding the tumour study/source label, used for the
        # tumour-only tumour_source model (DSMZ profiles excluded).
        tumour_source_column = BATCH_CONFIG.get("tumour_source_column", "cohort"),
        tumour_label = BATCH_CONFIG.get("tumour_label", "RBL_TUMOUR"),
        dsmz_label = BATCH_CONFIG.get("dsmz_label", "DSMZ_RBL"),
        expected_tumours = EXPECTED_RETAINED_TUMOURS,
        expected_collapsed_dsmz = int(config.get("expected_dsmz_biological_profiles", 9)),
        final_matrix_validation_path = FINAL_VALIDATION["report"],
        include_tumour_source_analysis = False,
        gene_annotation_release = BATCH_CONFIG.get(
            "gene_annotation_release", "GENCODE v44 (basic, GRCh38)"
        ),
        gene_annotation_source = BATCH_CONFIG.get(
            "gene_annotation_source",
            "ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_44/gencode.v44.basic.annotation.gtf.gz",
        ),
        snakemake_version = SNAKEMAKE_VERSION,
        snakemake_command = (
            "snakemake --snakefile preprocessing_and_quality_control/rbl/Snakefile "
            "--cores 8 --use-conda --conda-frontend conda "
            "--conda-prefix .snakemake_conda_envs rbl_batch_effect_quantification"
        ),
    threads:
        1
    resources:
        mem_mb=48000
    log:
        f"{BATCH_OUTPUT_DIR}/rbl_batch_effect_quantification.log"
    conda:
        "batch_corr_and_normalisation/envs/r_rbl_preprocess.yaml"
    script:
        BATCH_EFFECT_SCRIPT


rule validate_rbl_purity_filtered_joint_outputs:
    input:
        purity_scores = RBL_PURITY_OUTPUTS["purity_scores"],
        retained_samples = RBL_PURITY_OUTPUTS["retained_samples"],
        excluded_samples = RBL_PURITY_OUTPUTS["excluded_samples"],
        retained_raw_tumour_counts = RBL_PURITY_OUTPUTS["retained_raw_tumour_counts"],
        purity_validation = RBL_PURITY_OUTPUTS["validation_ok"],
        dsmz_counts = BATCH_OUTPUT["dsmz_counts_rds"],
        merged_counts_raw = BATCH_OUTPUT["merged_counts_rds"],
        merged_counts_batch_corrected = BATCH_OUTPUT["batch_corrected_counts_rds"],
        joint_vst_pre_bc = BATCH_OUTPUT["joint_vst_pre_bc_rds"],
        joint_vst_post_bc = BATCH_OUTPUT["joint_vst_post_bc_rds"],
        tumour_vst_post_bc = BATCH_OUTPUT["tumour_vst_post_bc_rds"],
        dsmz_vst_post_bc = BATCH_OUTPUT["dsmz_vst_post_bc_rds"],
        collapsed_dsmz = BATCH_OUTPUT["dsmz_vst_post_bc_collapsed_cellline_rds"],
        coldata = BATCH_OUTPUT["coldata_tsv"],
        figure_purity = RBL_PURITY_OUTPUTS["purity_distribution_and_scores"],
        figure_retention = RBL_PURITY_OUTPUTS["sample_retention"],
        figure_pca_pre = BATCH_OUTPUT["pca_pre_pdf"],
        figure_pca_post = BATCH_OUTPUT["pca_post_pdf"],
        figure_tumour_vst = BATCH_OUTPUT["tumour_qc_pdf"],
        figure_dsmz_vst = BATCH_OUTPUT["dsmz_qc_pdf"],
        figure_tumour_dispersion = BATCH_OUTPUT["tumour_dispersion_pdf"],
        figure_dsmz_dispersion = BATCH_OUTPUT["dsmz_dispersion_pdf"],
    output:
        validation_report = FINAL_VALIDATION["report"],
        final_matrix_manifest = FINAL_VALIDATION["manifest"],
        validation_ok = FINAL_VALIDATION["ok"],
        validation_log = FINAL_VALIDATION["log"],
    params:
        cohort = "RBL",
        expected_tumours = EXPECTED_RETAINED_TUMOURS,
        expected_dsmz = EXPECTED_DSMZ_PROFILES,
        expected_collapsed_dsmz = int(config.get("expected_dsmz_biological_profiles", 9)),
        final_relative_path = str(
            Path(BATCH_OUTPUT["joint_vst_post_bc_rds"]).resolve().relative_to(REPO_ROOT)
        ),
    resources:
        mem_mb = 32000
    conda:
        "batch_corr_and_normalisation/envs/r_rbl_preprocess.yaml"
    script:
        FINAL_VALIDATION_SCRIPT

# ------------------------------------------------------------------------------
# MultiQC: per-project aggregation of QC and alignment metrics
# ------------------------------------------------------------------------------
# Bioinformatics intent:
#   MultiQC consolidates FastQC, STAR, and Picard outputs into a single report.
def multiqc_inputs_for_project(project):
    samples = ALL_SAMPLES_BY_PROJECT.get(project, [])

    # FastQC zip archives contain the raw statistics MultiQC parses.
    fq = [f"{DATA_ROOT}/{project}/results/fastqc/{r['sample_read']}_fastqc.zip"
          for r in ALL_FASTQC_READS if r["project"] == project]

    # STAR alignment outputs: BAMs for completeness and Log.final.out for summary metrics.
    star = (
        [f"{DATA_ROOT}/{project}/results/star/{s}.Aligned.sortedByCoord.out.bam" for s in samples] +
        [f"{DATA_ROOT}/{project}/results/star/{s}.Log.final.out" for s in samples]
    )

    # Picard metrics and insert size histogram PDFs.
    metrics = ["validate_samfile", "alignment_summary_metrics",
               "quality_yield_metrics", "insert_size_metrics"]
    pic = ([f"{DATA_ROOT}/{project}/results/picard/{s}_{m}.txt" for s in samples for m in metrics] +
           [f"{DATA_ROOT}/{project}/results/picard/{s}_insert_size_histogram.pdf" for s in samples])

    return fq + star + pic

rule multiqc:
    input:
        lambda wc: multiqc_inputs_for_project(wc.project)
    output:
        html = f"{DATA_ROOT}/{{project}}/results/multiqc/multiqc_report.html"
    params:
        # Reports are written into a dedicated directory for the project.
        outdir = lambda wc: f"{DATA_ROOT}/{wc.project}/results/multiqc",
        indir  = lambda wc: f"{DATA_ROOT}/{wc.project}/results"
    log:   f"{DATA_ROOT}/{{project}}/logs/multiqc.log"
    conda: f"{ENV_DIR}/multiqc.yaml"
    threads: 2
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}

        # MultiQC scans the results directory and generates an integrated HTML report.
        # The report summarises QC across all samples within the project.
        multiqc {params.indir} -o {params.outdir} -n multiqc_report.html > {log} 2>&1
    """


# ------------------------------------------------------------------------------
# Rule: clean stale STAR temporary directories (opt-in)
# ------------------------------------------------------------------------------
# Run explicitly when needed:  snakemake clean_star_tmp --cores 1
# Never runs automatically; avoids accidental deletion during normal DAG evaluation.
rule clean_star_tmp:
    run:
        import glob as _glob, shutil
        for project_id in PROJECTS:
            pattern = f"{DATA_ROOT}/{project_id}/results/star/tmp_*"
            for tmp_dir in sorted(_glob.glob(pattern)):
                if os.path.isdir(tmp_dir):
                    print(f"[CLEAN] Removing: {tmp_dir}")
                    shutil.rmtree(tmp_dir, ignore_errors=True)
        print("[CLEAN] Done.")
