FINAL_VALIDATION = {
    "report": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.tsv",
    "manifest": f"{BATCH_OUTPUT_DIR}/final_matrix_manifest.tsv",
    "ok": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.ok",
    "log": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.log",
}

# ------------------------------------------------------------------------------
# Final pipeline outputs
# ------------------------------------------------------------------------------
# This target definition ensures that successful completion implies:
# - all samples were QC-checked
# - all samples were aligned and indexed
# - gene-level counts were collected
# - alignment QC metrics were generated
# - MultiQC reports were built per project
# - all per-sample counts merged into a single count matrix
# Read-level QC targets exist only when FASTQs were discovered. In the
# count-only mode this cohort actually runs in, STAR_COUNTS and MULTIQC_HTML
# still enumerate every registered sample, so requesting them from the default
# target made a bare `snakemake -s rbl/Snakefile` abort with a
# MissingInputException on picard_validate_samfile even though every
# count-based product was complete and up to date. NBL already guards its
# default target this way; RBL now matches, and `rbl_full_pipeline` remains the
# explicit opt-in for the read-level workflow.
READ_LEVEL_TARGETS = (
    STAR_BAMS
    + STAR_BAIS
    + STAR_COUNTS
    + PICARD_TXT
    + PICARD_HIST
    + FASTQC_HTML
    + MULTIQC_HTML
) if FASTQ_RUNS else []

