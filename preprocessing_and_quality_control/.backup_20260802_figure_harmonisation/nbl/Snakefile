# ------------------------------------------------------------------------------
# Downstream NBL orchestration: gene ID map, count validation, tumour purity
# ------------------------------------------------------------------------------

rule build_nbl_ensembl_to_hgnc_map:
    input:
        gtf = GTF
    output:
        NBL_ENSEMBL_TO_HGNC
    log:
        f"{DATA_ROOT}/count_data/nbl_ensembl_to_hgnc.log"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname "{output}")" "$(dirname "{log}")"

        awk '
        BEGIN {{ FS = OFS = "\t"; print "Ensembl_ID", "HGNC_Symbol" }}
        $3 == "gene" {{
            gene_id = ""
            gene_name = ""
            n = split($9, attrs, ";")
            for (i = 1; i <= n; i++) {{
                attr = attrs[i]
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", attr)
                if (attr ~ /^gene_id "/) {{
                    gene_id = attr
                    sub(/^gene_id "/, "", gene_id)
                    sub(/"$/, "", gene_id)
                    sub(/\.[0-9]+$/, "", gene_id)
                }} else if (attr ~ /^gene_name "/) {{
                    gene_name = attr
                    sub(/^gene_name "/, "", gene_name)
                    sub(/"$/, "", gene_name)
                }}
            }}
            if (gene_id != "" && gene_name != "" && !seen[gene_id]++) {{
                print gene_id, gene_name
            }}
        }}
        ' "{input.gtf}" > "{output}.tmp" 2> "{log}"

        rows=$(awk 'END {{ print NR - 1 }}' "{output}.tmp")
        if [ "$rows" -le 0 ]; then
            echo "[ERROR] No gene mappings were extracted from {input.gtf}" >> "{log}"
            rm -f "{output}.tmp"
            exit 1
        fi

        mv "{output}.tmp" "{output}"
        echo "[OK] Wrote $rows Ensembl-to-HGNC mappings to {output}" >> "{log}"
        """

rule verify_final_nbl_count_matrix:
