#!/usr/bin/env snakemake
# =============================================================================
# RNA-seq pipeline for paired-end public datasets
# 
#
# Bioinformatics goal:
#   The workflow performs read-level QC, alignment to a reference genome,
#   extraction of gene-level counts, alignment QC metrics, and project-level
#   summarisation reports. Outputs are suitable for further analyses such as
#   differential expression, sample QC, and cohort comparison.
#
# Intent:
#   - Validate that the input data are truly paired-end before analysis.
#   - Ensure sample identity is derived from observed files, not assumed metadata.
#   - Produce a consistent, auditable set of alignment and QC artefacts per sample.
# ==============================================================================

import os
import glob
from pathlib import Path
from snakemake.exceptions import WorkflowError

WORKFLOW_ROOT = Path(workflow.basedir).resolve()
REPO_ROOT = WORKFLOW_ROOT.parents[1]
WORKFLOW_DIR = str(WORKFLOW_ROOT)
PIPELINE_DIR = str(REPO_ROOT)

def repo_config_path(value):
    """Resolve a relative cohort-config path against the repository root."""
    path = Path(str(value)).expanduser()
    return str(path if path.is_absolute() else REPO_ROOT / path)

def workflow_config_path(value):
    """Resolve a relative workflow-config path against this Snakefile directory."""
    path = Path(str(value)).expanduser()
    return str(path if path.is_absolute() else (WORKFLOW_ROOT / path).resolve())

# ------------------------------------------------------------------------------
# Paths and study identifiers
# ------------------------------------------------------------------------------
# A configuration file is used to hold stable reference and tool paths.
# This prevents hard-coding genome resources and improves reproducibility.
configfile: str(WORKFLOW_ROOT / "config" / "config.yaml")

# data_root is controlled by config/config.yaml and resolved relative to this
# workflow directory to avoid accidental SLURM environment-variable leakage.
DATA_ROOT = workflow_config_path(config.get("data_root", "../../data/nbl"))
PROJECTS = config.get("projects", ["GSE189367", "SRP409177"])
ENV_DIR = repo_config_path(config.get("env_dir") or "preprocessing_and_quality_control/envs")
INPUT_MODE = str(config.get("input_mode", "fastq")).strip().lower()
VALID_INPUT_MODES = {"existing_counts", "fastq"}
if INPUT_MODE not in VALID_INPUT_MODES:
    raise ValueError(
        f"Unsupported input_mode={INPUT_MODE!r}; expected one of "
        + ", ".join(sorted(VALID_INPUT_MODES))
    )
USING_EXISTING_COUNTS = INPUT_MODE == "existing_counts"

# ------------------------------------------------------------------------------
# Reference resources and tool paths
# ------------------------------------------------------------------------------
# REF_INDEX: STAR genome index directory (built from the reference FASTA + annotation)
# GTF: gene annotation used by aligner/counting tools and further interpretation
# REF_FASTA: reference genome FASTA (required for alignment QC checks)
# THREADS: compute threads; defaults to 12 if not specified in config
_genome   = config.get("genome", {})
REF_INDEX = repo_config_path(_genome.get("star_index", "")) if _genome.get("star_index") else ""
GTF       = repo_config_path(_genome.get("gtf", "")) if _genome.get("gtf") else ""  # retained; not used in alignment rules
REF_FASTA = repo_config_path(_genome.get("fasta", "")) if _genome.get("fasta") else ""
THREADS   = config.get("threads", 12)

# Validate required keys with a clear message before any KeyError can surface.
required_resources = {"genome.gtf": GTF}
if not USING_EXISTING_COUNTS:
    required_resources.update({
        "genome.star_index": REF_INDEX,
        "genome.fasta": REF_FASTA,
    })
missing_required = {k: v for k, v in required_resources.items() if not v}
if missing_required:
    raise ValueError(
        "Missing required configuration values: "
        + ", ".join(missing_required)
        + ". Provide local paths in preprocessing_and_quality_control/config/config.yaml."
    )

# ------------------------------------------------------------------------------
# Sample discovery: paired-end validation by filesystem scanning
# ------------------------------------------------------------------------------
# This section implements a robust sample registration strategy:
# - It scans each project's fastq/ directory for read 1 files.
# - It validates the existence of the matching read 2 file.
# - It registers only samples that are confirmed as paired-end.
#
# Bioinformatics rationale:
#   Public repositories and downloads can contain incomplete pairs or naming
#   inconsistencies. Enforcing paired-end integrity prevents alignment failures
#   and avoids silent sample dropouts later in analysis.
SAMPLES = {}
ALL_SAMPLES_BY_PROJECT = {}

for project_id in PROJECTS:
    fastq_dir = f"{DATA_ROOT}/{project_id}/fastq"
    if not os.path.exists(fastq_dir):
        # Projects without FASTQ data are skipped to avoid hard pipeline failure.
        print(f"[SKIP] No fastq directory: {fastq_dir}")
        continue

    # STAR requires correct pairing; this script assumes filenames use _1/_2 suffixing.
    r1_pattern = f"{fastq_dir}/*_1.fastq.gz"
    r1_files = sorted(glob.glob(r1_pattern))  # sorted for deterministic sample order

    paired_count = 0
    for r1_path in r1_files:
        # A paired-end sample is only accepted if the expected read 2 exists.
        r2_path = r1_path.replace("_1.fastq.gz", "_2.fastq.gz")

        if os.path.exists(r2_path):
            # Sample IDs are derived from SRR-style filenames, typical for SRA downloads.
            basename = os.path.basename(r1_path)
            srr = basename.replace("_1.fastq.gz", "")

            # A per-sample record stores read paths and project provenance.
            # Project provenance is important for tracking batch effects across studies.
            sample_info = {
                "sample": srr,
                "r1": r1_path,
                "r2": r2_path,
                "project": project_id
            }
            SAMPLES[(project_id, srr)] = sample_info
            ALL_SAMPLES_BY_PROJECT.setdefault(project_id, []).append(srr)
            paired_count += 1
        else:
            # Incomplete pairs are excluded because they can bias QC summaries and
            # disrupt consistent further matrices.
            print(f"[WARN] Missing R2 (skipping): {os.path.basename(r1_path)}")

    print(f"[SUCCESS] {project_id}: Found {paired_count} real paired-end samples")

# ------------------------------------------------------------------------------
# Global run list construction and validation
# ------------------------------------------------------------------------------
# ALL_RUNS is a concrete list of (project, sample) pairs that actually exist.
# This avoids accidental sample cross-pairing across projects and ensures
# targets are created only for valid samples.
ALL_RUNS = [(p, s) for p in PROJECTS for s in ALL_SAMPLES_BY_PROJECT.get(p, [])]

if not ALL_RUNS:
    if USING_EXISTING_COUNTS:
        print(
            "[COUNT-ONLY] No paired-end FASTQs were discovered. "
            "Downstream rules will use the configured existing count matrix."
        )
    else:
        print(
            "[WARN] No paired-end FASTQs were discovered. Alignment and "
            "count-generation targets will fail if requested."
        )
else:
    # Reporting sample counts supports auditability and quick verification
    # against expected cohort sizes from GEO/SRA metadata.
    print(f"\n[FINAL] TOTAL PAIRED-END SAMPLES: {len(ALL_RUNS)}")
    for p in PROJECTS:
        n = len(ALL_SAMPLES_BY_PROJECT.get(p, []))
        print(f"[SUMMARY] {p}: {n} paired-end samples")
    for p, s in ALL_RUNS[:10]:
        print(f"  → {p}/{s}")
    if len(ALL_RUNS) > 10:
        print(f"  ... and {len(ALL_RUNS)-10} more")

# Note: STAR temp directory cleanup has been moved to rule clean_star_tmp
# (defined at the bottom of this file) so it runs only when explicitly
# requested and never silently during DAG building or dry-run.

# ------------------------------------------------------------------------------
# FastQC planning: one QC job per FASTQ file (R1 and R2 separately)
# ------------------------------------------------------------------------------
# FastQC is applied to each read file to evaluate:
# - base quality score profiles
# - adapter contamination signals
# - sequence duplication and overrepresented sequences
# - GC content distribution
#
# Treating R1 and R2 separately is important because read quality often differs
# between mates in paired-end sequencing.
def get_fastqc_reads():
    reads = []
    seen = set()
    for (proj, sample), info in SAMPLES.items():
        for read, path in [("1", info["r1"]), ("2", info["r2"])]:
            read_id = os.path.basename(path).replace(".fastq.gz", "")
            key = (proj, read_id)
            if key not in seen:
                seen.add(key)
                reads.append({"project": proj, "sample_read": read_id, "path": path})
    return reads

ALL_FASTQC_READS = get_fastqc_reads()

# ------------------------------------------------------------------------------
# Input resolver functions
# ------------------------------------------------------------------------------
# These functions map a project/sample label to the correct FASTQ paths.
# They also provide explicit error messages if a sample is requested under
# the wrong project, which helps diagnose naming collisions across studies.
def get_r1(wc):
    key = (wc.project, wc.sample)
    if key not in SAMPLES:
        candidates = sorted({p for (p, s) in SAMPLES.keys() if s == wc.sample})
        raise ValueError(
            f"[INPUT] Sample {wc.sample} is not registered under project {wc.project}. "
            f"It exists under: {candidates or 'NONE'}."
        )
    return SAMPLES[key]["r1"]

def get_r2(wc):
    key = (wc.project, wc.sample)
    if key not in SAMPLES:
        candidates = sorted({p for (p, s) in SAMPLES.keys() if s == wc.sample})
        raise ValueError(
            f"[INPUT] Sample {wc.sample} is not registered under project {wc.project}. "
            f"Exists under: {candidates or 'NONE'}."
        )
    return SAMPLES[key]["r2"]

# ------------------------------------------------------------------------------
# Concrete target file lists
# ------------------------------------------------------------------------------
# Targets are enumerated explicitly from ALL_RUNS to guarantee that each
# sample produces only its own outputs and is never cross-associated with
# another project's samples.
STAR_BAMS   = [f"{DATA_ROOT}/{p}/results/star/{s}.Aligned.sortedByCoord.out.bam"       for p, s in ALL_RUNS]
STAR_BAIS   = [f"{DATA_ROOT}/{p}/results/star/{s}.Aligned.sortedByCoord.out.bam.bai"   for p, s in ALL_RUNS]

# STAR gene count output is separated into a dedicated directory to make it
# easier to build expression matrices later.
STAR_COUNTS = [f"{DATA_ROOT}/{p}/results/star/valid_count/{s}.tab"                      for p, s in ALL_RUNS]

# Picard provides complementary alignment-level QC metrics beyond STAR logs:
# - ValidateSamFile detects structural BAM issues.
# - CollectAlignmentSummaryMetrics reports mapping and pairing statistics.
# - CollectQualityYieldMetrics summarises base-level yield and quality.
# - CollectInsertSizeMetrics estimates the library insert size distribution, a key
#   property in paired-end RNA-seq.
PICARD_TXT  = [f"{DATA_ROOT}/{p}/results/picard/{s}_{m}.txt"
               for p, s in ALL_RUNS for m in ["validate_samfile", "alignment_summary_metrics",
                                             "quality_yield_metrics", "insert_size_metrics"]]
PICARD_HIST = [f"{DATA_ROOT}/{p}/results/picard/{s}_insert_size_histogram.pdf"          for p, s in ALL_RUNS]

# FastQC HTML summaries are used for per-read QC review and for aggregation.
FASTQC_HTML = [f"{DATA_ROOT}/{r['project']}/results/fastqc/{r['sample_read']}_fastqc.html"
               for r in ALL_FASTQC_READS]

# MultiQC creates a per-project report integrating FastQC, STAR, and Picard metrics.
# Only projects that have discovered samples are included — avoids requesting
# MultiQC reports for projects whose fastq/ directories do not yet exist.
DISCOVERED_PROJECTS = [p for p in PROJECTS if p in ALL_SAMPLES_BY_PROJECT]
MULTIQC_HTML = [f"{DATA_ROOT}/{p}/results/multiqc/multiqc_report.html" for p in DISCOVERED_PROJECTS]

# Count-space inputs. In existing_counts mode these paths are external,
# immutable inputs configured in config/config.yaml. The separate rebuild paths
# prevent Snakemake from treating them as outputs of FASTQ-based rules.
COUNT_INPUT_CONFIG = config.get("count_inputs", {})
COUNT_MATRIX = repo_config_path(
    COUNT_INPUT_CONFIG.get("matrix", "data/nbl/count_data/nbl_tumour_count.rds")
)
COUNT_META = repo_config_path(
    COUNT_INPUT_CONFIG.get("metadata", "data/nbl/count_data/nbl_tumour_sample_metadata.csv")
)
COUNT_GENES = repo_config_path(
    COUNT_INPUT_CONFIG.get("genes", "data/nbl/count_data/nbl_tumour_gene_list_hgnc.txt")
)

if USING_EXISTING_COUNTS:
    REBUILT_COUNT_DIR = f"{DATA_ROOT}/count_data/rebuilt_from_fastq"
    GENERATED_COUNT_MATRIX = f"{REBUILT_COUNT_DIR}/nbl_tumour_count.rds"
    GENERATED_COUNT_META = f"{REBUILT_COUNT_DIR}/nbl_tumour_sample_metadata.csv"
    GENERATED_COUNT_GENES = f"{REBUILT_COUNT_DIR}/nbl_tumour_gene_list_hgnc.txt"
else:
    GENERATED_COUNT_MATRIX = COUNT_MATRIX
    GENERATED_COUNT_META = COUNT_META
    GENERATED_COUNT_GENES = COUNT_GENES

# Count matrix outputs produced by merge_target_nbl_counts.R (TARGET-NBL)
TARGET_NBL_DIR    = f"{DATA_ROOT}/target_nbl"
TARGET_MATRIX     = f"{TARGET_NBL_DIR}/merged/target_nbl_count.rds"
TARGET_META       = f"{TARGET_NBL_DIR}/merged/target_nbl_sample_metadata.csv"
TARGET_GENES      = f"{TARGET_NBL_DIR}/merged/target_nbl_gene_list.txt"

# Downstream NBL analysis settings
EXPECTED_SAMPLES = config.get("expected_samples", {})

EXPECTED_NBL_SAMPLES = int(EXPECTED_SAMPLES.get("total", 273))

EXPECTED_COHORT_SAMPLES = {
    "TARGET_NBL": int(EXPECTED_SAMPLES.get("TARGET_NBL", 162)),
    "SRP409177": int(EXPECTED_SAMPLES.get("SRP409177", 47)),
    "GSE189367": int(EXPECTED_SAMPLES.get("GSE189367", 64)),
}

PURITY_THRESHOLD = float(config.get("purity_threshold", 0.7))
PURITY_LABEL = f"{PURITY_THRESHOLD:.1f}"
EXPECTED_RETAINED_TUMOURS = int(config.get("expected_retained_tumour_samples", 235))
EXPECTED_DSMZ_PROFILES = int(config.get("expected_dsmz_profiles", 18))

NBL_ENSEMBL_TO_HGNC = f"{DATA_ROOT}/count_data/nbl_ensembl_to_hgnc.tsv"
NBL_COUNT_VERIFY = f"{DATA_ROOT}/count_data/nbl_count_matrix_verified_{EXPECTED_NBL_SAMPLES}.ok"
PURITY_GENE_MAP = repo_config_path(config.get("gene_map_tsv", "resources/ensembl_to_symbol.tsv"))
VERIFIED_PURITY_SCORES = repo_config_path(config["verified_purity_scores"])
VERIFIED_PURITY_SCRIPT = repo_config_path(config["verified_purity_script"])
VERIFIED_PURITY_LOG = repo_config_path(config["verified_purity_log"])

NBL_PURITY_DIR = repo_config_path(
    config.get(
        "purity_output_dir",
        "data/nbl/results/tumour_purity_before_batch_correction",
    )
)

SHARED_PURITY_SCRIPT = repo_config_path(
    "preprocessing_and_quality_control/scripts/R/raw_tumour_purity_analysis.R"
)
FINAL_VALIDATION_SCRIPT = repo_config_path(
    "preprocessing_and_quality_control/scripts/R/validate_purity_filtered_joint_outputs.R"
)
PURITY_ENV = repo_config_path("preprocessing_and_quality_control/envs/tcga-r-env.yaml")

NBL_PURITY_OUTPUTS = {
    "eligible_samples": f"{NBL_PURITY_DIR}/eligible_tumour_samples.tsv",
    "purity_scoring_expression": f"{NBL_PURITY_DIR}/tumour_only_purity_scoring_expression.rds",
    "purity_scores": f"{NBL_PURITY_DIR}/purity_scores.csv",
    "retained_samples": f"{NBL_PURITY_DIR}/retained_samples.tsv",
    "excluded_samples": f"{NBL_PURITY_DIR}/excluded_samples.tsv",
    "retained_raw_tumour_counts": f"{NBL_PURITY_DIR}/retained_raw_tumour_counts.rds",
    "purity_diagnostics": f"{NBL_PURITY_DIR}/purity_diagnostics.pdf",
    "sample_retention": f"{NBL_PURITY_DIR}/sample_retention_by_cohort.pdf",
    "provenance": f"{NBL_PURITY_DIR}/purity_provenance.tsv",
    "validation_report": f"{NBL_PURITY_DIR}/purity_stage_validation.tsv",
    "validation_ok": f"{NBL_PURITY_DIR}/purity_stage_validation.ok",
    "execution_log": f"{NBL_PURITY_DIR}/tumour_purity_analysis.log",
}

# Batch correction consumes only the raw tumour columns retained by the
# upstream tumour-only purity rule.
BATCH_CONFIG = config.get("batch_corr_and_normalisation", {})
BATCH_ENABLED = bool(BATCH_CONFIG.get("enabled", True))
BATCH_OUTPUT_DIR = repo_config_path(
    BATCH_CONFIG.get(
        "output_dir",
        "data/nbl/results/batch_corr_and_normalisation/purity_filtered_preprocess",
    )
)
if not BATCH_CONFIG.get("dsmz_rds"):
    raise WorkflowError(
        "batch_corr_and_normalisation.dsmz_rds must explicitly name the "
        "validated NBL-specific DSMZ raw-count input"
    )
BATCH_DSMZ_RDS = repo_config_path(BATCH_CONFIG["dsmz_rds"])
BATCH_DSMZ_META = repo_config_path(
    BATCH_CONFIG.get("dsmz_meta_csv", "data/dsmz/DSMZ_metadata.csv")
)
BATCH_MODULE_DIR = f"{WORKFLOW_DIR}/batch_corr_and_normalisation"
BATCH_SCRIPT = f"{BATCH_MODULE_DIR}/scripts/R/nbl_preprocess_snakemake.R"
BATCH_ENV = f"{BATCH_MODULE_DIR}/envs/r_nbl_preprocess.yaml"

SHARED_FIGURE_MODULE = repo_config_path(
    "preprocessing_and_quality_control/scripts/R/batch_effect_and_embedding_figures.R"
)
# Cohort-agnostic batch-effect quantification driver, shared with BRCA and RBL.
BATCH_EFFECT_SCRIPT = repo_config_path(
    "preprocessing_and_quality_control/scripts/R/batch_effect_quantification.R"
)

try:
    from snakemake import __version__ as SNAKEMAKE_VERSION
except Exception:  # pragma: no cover - recorded as unknown rather than failing
    SNAKEMAKE_VERSION = "unknown"
# Reused in-repo annotation already pinned for this cohort's STAR step.
GENE_ANNOTATION_GTF = repo_config_path(
    BATCH_CONFIG.get(
        "gene_annotation_gtf",
        "data/reference/gencode_v44/gencode.v44.basic.annotation.gtf",
    )
)

BATCH_OUTPUTS = {
    "tumour_counts_rds": f"{BATCH_OUTPUT_DIR}/tumour_counts.rds",
    "dsmz_counts_rds": f"{BATCH_OUTPUT_DIR}/dsmz_nbl_counts.rds",
    "merged_counts_rds": f"{BATCH_OUTPUT_DIR}/merged_counts_raw.rds",
    "coldata_tsv": f"{BATCH_OUTPUT_DIR}/coldata.tsv",
    "batch_corrected_counts_rds": f"{BATCH_OUTPUT_DIR}/merged_counts_batch_corrected.rds",
    "tumour_vst_rds": f"{BATCH_OUTPUT_DIR}/tumour_vst_pre_bc.rds",
    "dsmz_vst_rds": f"{BATCH_OUTPUT_DIR}/dsmz_vst_pre_bc.rds",
    "joint_vst_pre_bc_rds": f"{BATCH_OUTPUT_DIR}/joint_vst_pre_bc.rds",
    "joint_vst_post_bc_rds": f"{BATCH_OUTPUT_DIR}/joint_vst_purity_filtered_post_bc.rds",
    "tumour_vst_post_bc_rds": f"{BATCH_OUTPUT_DIR}/tumour_vst_purity_filtered_post_bc.rds",
    "dsmz_vst_post_bc_rds": f"{BATCH_OUTPUT_DIR}/dsmz_vst_purity_filtered_post_bc.rds",
    "pca_pre_pdf": f"{BATCH_OUTPUT_DIR}/pca_pre_BC.pdf",
    "pca_post_pdf": f"{BATCH_OUTPUT_DIR}/pca_post_BC.pdf",
    "umap_pre_pdf": f"{BATCH_OUTPUT_DIR}/umap_pre_BC.pdf",
    "umap_post_pdf": f"{BATCH_OUTPUT_DIR}/umap_post_BC.pdf",
    "tumour_qc_pdf": f"{BATCH_OUTPUT_DIR}/qc_tumour_vst.pdf",
    "dsmz_qc_pdf": f"{BATCH_OUTPUT_DIR}/qc_dsmz_vst.pdf",
    "tumour_dispersion_pdf": f"{BATCH_OUTPUT_DIR}/qc_tumour_dispersion.pdf",
    "dsmz_dispersion_pdf": f"{BATCH_OUTPUT_DIR}/qc_dsmz_dispersion.pdf",
    "provenance_tsv": f"{BATCH_OUTPUT_DIR}/batch_normalisation_provenance.tsv",
}

# Derived batch-effect statistics and figures. Their own rule, so they can be
# deleted and rebuilt without regenerating a count or VST matrix.
BATCH_EFFECT_OUTPUTS = {
    "pca_before_after_top3000_pdf": f"{BATCH_OUTPUT_DIR}/pca_before_after_BC_top3000.pdf",
    "pca_before_after_protein_coding_pdf": f"{BATCH_OUTPUT_DIR}/pca_before_after_BC_protein_coding.pdf",
    "pca_before_after_full_expression_pdf": f"{BATCH_OUTPUT_DIR}/pca_before_after_BC_full_expression.pdf",
    "batch_effect_tsv": f"{BATCH_OUTPUT_DIR}/batch_effect_quantification.tsv",
    "batch_effect_provenance_tsv": f"{BATCH_OUTPUT_DIR}/batch_effect_quantification_provenance.tsv",
    "batch_effect_run_metadata_tsv": f"{BATCH_OUTPUT_DIR}/batch_effect_run_metadata.tsv",
    "protein_coding_ids_tsv": f"{BATCH_OUTPUT_DIR}/protein_coding_gene_ids.tsv",
    "feature_manifest_top3000_tsv": f"{BATCH_OUTPUT_DIR}/feature_manifest_top3000.tsv",
    "feature_manifest_protein_coding_tsv": f"{BATCH_OUTPUT_DIR}/feature_manifest_protein_coding.tsv",
    "feature_manifest_full_expression_tsv": f"{BATCH_OUTPUT_DIR}/feature_manifest_full_expression.tsv",
}

FINAL_VALIDATION = {
    "report": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.tsv",
    "manifest": f"{BATCH_OUTPUT_DIR}/final_matrix_manifest.tsv",
    "ok": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.ok",
    "log": f"{BATCH_OUTPUT_DIR}/final_matrix_validation.log",
}

PROTECTED_ACTIVE_VST = f"{DATA_ROOT}/nbl_vst_joint.rds"
if PROTECTED_ACTIVE_VST in BATCH_OUTPUTS.values():
    raise ValueError(
        "Batch output configuration would overwrite the protected active NBL VST: "
        + PROTECTED_ACTIVE_VST
    )

COUNT_BASED_OUTPUTS = list(NBL_PURITY_OUTPUTS.values()) + (
    list(BATCH_OUTPUTS.values())
    + list(BATCH_EFFECT_OUTPUTS.values())
    + list(FINAL_VALIDATION.values())
    if BATCH_ENABLED else []
)

# ------------------------------------------------------------------------------
# Final pipeline outputs
# ------------------------------------------------------------------------------
# In existing_counts mode, the default target is intentionally downstream-only:
# it verifies the configured count object, runs purity filtering, and then runs
# batch correction/normalisation. It never requests FASTQ or alignment outputs.
rule all:
    input:
        COUNT_BASED_OUTPUTS if USING_EXISTING_COUNTS else (
            STAR_BAMS
            + STAR_BAIS
            + STAR_COUNTS
            + PICARD_TXT
            + PICARD_HIST
            + FASTQC_HTML
            + MULTIQC_HTML
            + [COUNT_MATRIX, COUNT_META, COUNT_GENES]
            + [TARGET_MATRIX, TARGET_META, TARGET_GENES]
            + [NBL_ENSEMBL_TO_HGNC, NBL_COUNT_VERIFY]
            + list(NBL_PURITY_OUTPUTS.values())
            + list(BATCH_OUTPUTS.values())
            + list(BATCH_EFFECT_OUTPUTS.values())
            + list(FINAL_VALIDATION.values())
        )

rule nbl_count_based_preprocessing:
    input:
        COUNT_BASED_OUTPUTS

def require_paired_fastq_outputs(wildcards):
    if not ALL_RUNS:
        raise WorkflowError(
            "nbl_full_pipeline requires paired FASTQs, but none were discovered. "
            "Use nbl_count_based_preprocessing with input_mode: existing_counts."
        )
    return STAR_COUNTS

# Full read-level orchestration remains opt-in. Its FASTQ guard is evaluated
# only when this target is requested, so it cannot block downstream count-based
# targets during Snakefile parsing.
rule nbl_full_pipeline:
    input:
        fastq_guard = require_paired_fastq_outputs,
        bams = STAR_BAMS,
        bais = STAR_BAIS,
        counts = STAR_COUNTS,
        picard_txt = PICARD_TXT,
        picard_hist = PICARD_HIST,
        fastqc = FASTQC_HTML,
        multiqc = MULTIQC_HTML,
        matrix = GENERATED_COUNT_MATRIX,
        metadata = GENERATED_COUNT_META,
        genes = GENERATED_COUNT_GENES,
        target_matrix = TARGET_MATRIX,
        target_metadata = TARGET_META,
        target_genes = TARGET_GENES,
        gene_map = NBL_ENSEMBL_TO_HGNC,
        count_verification = NBL_COUNT_VERIFY,
        purity = list(NBL_PURITY_OUTPUTS.values()),
        batch = list(BATCH_OUTPUTS.values()),
        batch_effect = list(BATCH_EFFECT_OUTPUTS.values()),
        validation = list(FINAL_VALIDATION.values()),

# ------------------------------------------------------------------------------
# Rule: FastQC on each FASTQ file
# ------------------------------------------------------------------------------

rule fastqc:
    input:
        lambda wc: next(
            (r["path"] for r in ALL_FASTQC_READS
             if r["project"] == wc.project and r["sample_read"] == wc.sample_read),
            None  # fallback avoids StopIteration; Snakemake will report missing input clearly
        )
    output:
        # FastQC produces both an HTML report and a zipped directory of raw results.
        html = f"{DATA_ROOT}/{{project}}/results/fastqc/{{sample_read}}_fastqc.html",
        zip  = f"{DATA_ROOT}/{{project}}/results/fastqc/{{sample_read}}_fastqc.zip",
    log:     f"{DATA_ROOT}/{{project}}/logs/fastqc/{{sample_read}}.log"
    conda:   f"{ENV_DIR}/fastqc.yaml"
    threads: 2
    shell:
        r"""
        mkdir -p "$(dirname {output.html})" "$(dirname {log})"
        fastqc --threads {threads} --outdir "$(dirname {output.html})" {input} > {log} 2>&1
        """

# ------------------------------------------------------------------------------
# Rule: STAR alignment with two-pass mode and gene-level counting
# ------------------------------------------------------------------------------
# Bioinformatics intent:
#   - Align paired-end RNA-seq reads to a reference genome with STAR.
#   - Use two-pass mode to improve splice junction detection in RNA-seq.
#   - Produce a coordinate-sorted BAM for further QC 
#   - Produce gene-level counts suitable for DESeq2/edgeR-style workflows.
#
# Note on quantMode GeneCounts:
#   STAR generates a per-gene count table; further scripts typically select
#   the appropriate strandedness column based on library prep inference.
#
# Storage note:
#   This BAM-producing rule is retained for full alignment and BAM-based QC
#   workflows, including Picard metrics and optional genome-browser inspection.
#   Count-matrix generation should prefer star_counts_only below so STAR gene
#   count tables are produced without unnecessary BAM/SAM storage.
rule star_2pass:
    input:
        index = REF_INDEX,
        r1 = get_r1,
        r2 = get_r2
    output:
        bam    = f"{DATA_ROOT}/{{project}}/results/star/{{sample}}.Aligned.sortedByCoord.out.bam",
        bai    = f"{DATA_ROOT}/{{project}}/results/star/{{sample}}.Aligned.sortedByCoord.out.bam.bai",
        counts = f"{DATA_ROOT}/{{project}}/results/star/valid_count/{{sample}}.tab",
        logf   = f"{DATA_ROOT}/{{project}}/results/star/{{sample}}.Log.final.out",
    log:
        f"{DATA_ROOT}/{{project}}/logs/star/{{sample}}.log"
    benchmark:
        # Benchmarking captures runtime and resource usage; this supports auditability
        # and helps scale the workflow to larger cohorts.
        f"{DATA_ROOT}/{{project}}/logs/benchmarks/star/{{sample}}.tsv"
    conda:
        f"{ENV_DIR}/star.yaml"
    threads: THREADS
    resources:
        # Memory allocation is important for STAR sorting and large transcriptomes.
        mem_mb = 42000
    params:
        # Prefix is used so STAR writes all its output files into the sample folder.
        prefix = lambda wc: f"{DATA_ROOT}/{wc.project}/results/star/{wc.sample}."
    shell:
        r"""
        set -euo pipefail

        # Ensure output and log directories exist before starting alignment.
        mkdir -p "$(dirname "{output.bam}")" "$(dirname "{output.counts}")" "$(dirname "{log}")"

        # STAR alignment:
        # - BAM output is sorted by genomic coordinate for further processing.
        # - Two-pass mode improves detection of splice junctions across reads.
        # - GeneCounts produces a simple per-gene count table.
        STAR --genomeDir "{input.index}" \
             --readFilesIn "{input.r1}" "{input.r2}" \
             --readFilesCommand zcat \
             --outFileNamePrefix "{params.prefix}" \
             --outSAMtype BAM SortedByCoordinate \
             --quantMode GeneCounts \
             --twopassMode Basic \
             --runThreadN {threads} \
             --limitBAMsortRAM 32000000000 \
             > "{log}" 2>&1

        # Indexing enables fast random access for QC and visual inspection in genome browsers.
        samtools index "{output.bam}"

        # The STAR gene count table is moved into a dedicated counts directory
        # to simplify further matrix assembly.
        mv -f "{params.prefix}ReadsPerGene.out.tab" "{output.counts}"

        # STAR writes Log.final.out automatically using the chosen prefix; the
        # expected location is already tracked via output.logf.
        """

# ------------------------------------------------------------------------------
# Rule: STAR count-only mode for storage-conscious count-matrix generation
# ------------------------------------------------------------------------------
# Bioinformatics intent:
#   Produce STAR GeneCounts and Log.final.out without writing BAM/SAM output.
#   This rule is the preferred producer for valid_count/*.tab when the requested
#   target is the NBL tumour count matrix. Full BAM retention remains available
#   through star_2pass for alignment QC workflows.
#
# Count-generation note:
#   Count-matrix generation and count-only QC should rely on STAR count tables
#   and Log.final.out files. BAM, BAI, and SAM files are intentionally not
#   produced by this rule.
rule star_counts_only:
    input:
        index = REF_INDEX,
        r1 = get_r1,
        r2 = get_r2
    output:
        counts = f"{DATA_ROOT}/{{project}}/results/star/valid_count/{{sample}}.tab",
        logf   = f"{DATA_ROOT}/{{project}}/results/star/{{sample}}.Log.final.out",
    log:
        f"{DATA_ROOT}/{{project}}/logs/star_counts_only/{{sample}}.log"
    conda:
        f"{ENV_DIR}/star.yaml"
    threads: THREADS
    resources:
        # STAR still needs the reference index and splice-junction discovery
        # memory, but no BAM sort memory is required in count-only mode.
        mem_mb = 42000
    params:
        # The prefix places STAR logs next to the full-alignment STAR outputs,
        # while the count table is moved into valid_count/ for matrix assembly.
        prefix = lambda wc: f"{DATA_ROOT}/{wc.project}/results/star/{wc.sample}."
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname "{output.logf}")" "$(dirname "{output.counts}")" "$(dirname "{log}")"

        STAR --genomeDir "{input.index}" \
             --readFilesIn "{input.r1}" "{input.r2}" \
             --readFilesCommand zcat \
             --outFileNamePrefix "{params.prefix}" \
             --outSAMtype None \
             --quantMode GeneCounts \
             --twopassMode Basic \
             --runThreadN {threads} \
             > "{log}" 2>&1

        test -s "{params.prefix}ReadsPerGene.out.tab"
        mv -f "{params.prefix}ReadsPerGene.out.tab" "{output.counts}"
        test -s "{output.counts}"
        test -s "{output.logf}"
        """

# STAR count tables are intentionally ambiguous with star_2pass outputs. Prefer
# the count-only rule whenever a requested target only needs valid_count/*.tab
# and STAR logs; explicit BAM/Picard targets still select star_2pass.
ruleorder: star_counts_only > star_2pass

# ------------------------------------------------------------------------------
# Picard QC rules: alignment integrity and library metrics
# ------------------------------------------------------------------------------
# These steps provide additional QC metrics that complement STAR logs and FastQC.
# They are commonly used to detect:
# - BAM structural issues (ValidateSamFile)
# - mapping and pairing statistics (AlignmentSummaryMetrics)
# - yield and read quality summaries (QualityYieldMetrics)
# - insert size distributions, indicating library prep consistency (InsertSizeMetrics)

rule picard_validate_samfile:
    input:
        bam = rules.star_2pass.output.bam,
        ref = REF_FASTA
    output:
        f"{DATA_ROOT}/{{project}}/results/picard/{{sample}}_validate_samfile.txt"
    log:
        f"{DATA_ROOT}/{{project}}/logs/picard/{{sample}}_validate_samfile.log"
    conda:
        f"{ENV_DIR}/picard.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {output})" "$(dirname {log})"
        # ValidateSamFile exits non-zero for WARNING-level findings, not just errors.
        # Capture the exit code explicitly so findings are logged without aborting the rule.
        set +e
        picard ValidateSamFile \
            I={input.bam} \
            O={output} \
            MODE=SUMMARY \
            REFERENCE_SEQUENCE={input.ref} \
            > {log} 2>&1
        PICARD_EXIT=$?
        set -e
        if [ $PICARD_EXIT -ne 0 ]; then
            echo "[WARN] ValidateSamFile exit=$PICARD_EXIT — review {output} for findings" >> {log}
        fi
        """

rule picard_alignment_summary_metrics:
    input:
        bam = rules.star_2pass.output.bam,
        ref = REF_FASTA
    output:
        f"{DATA_ROOT}/{{project}}/results/picard/{{sample}}_alignment_summary_metrics.txt"
    log:
        f"{DATA_ROOT}/{{project}}/logs/picard/{{sample}}_alignment_summary_metrics.log"
    conda:
        f"{ENV_DIR}/picard.yaml"
    shell:
        r"""
        mkdir -p "$(dirname {output})" "$(dirname {log})"
        picard CollectAlignmentSummaryMetrics \
            R={input.ref} \
            I={input.bam} \
            O={output} \
            > {log} 2>&1
        """

rule picard_quality_yield_metrics:
    input:
        bam = rules.star_2pass.output.bam
    output:
        f"{DATA_ROOT}/{{project}}/results/picard/{{sample}}_quality_yield_metrics.txt"
