    log:
        f"{DATA_ROOT}/count_data/merge_star_counts.log"
    conda:
        f"{ENV_DIR}/r-base.yaml"
    shell:
        r"""
        mkdir -p "$(dirname "{output.matrix}")"
        ROOT_DIR={DATA_ROOT} COHORTS="{params.cohorts}" Rscript {WORKFLOW_DIR}/scripts/merge_star_counts.R > {log} 2>&1
        """

