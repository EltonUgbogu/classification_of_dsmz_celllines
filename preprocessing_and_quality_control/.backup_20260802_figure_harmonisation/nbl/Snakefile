            M=0.5 \
            > {log} 2>&1
        """

# ------------------------------------------------------------------------------
# Rule: merge per-sample STAR count tables into a single count matrix
# ------------------------------------------------------------------------------
# Reads all valid_count/{sample}.tab files across all FASTQ-backed GEO projects
# (GSE189367 and SRP409177), then loads the pre-built TARGET-NBL matrix and
# combines both into one genes x samples count matrix via merge_star_counts.R.
# STAR count tables are produced by star_counts_only for this target; BAM/SAM
# files should not be generated for the count-only stage.
