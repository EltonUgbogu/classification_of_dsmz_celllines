        expected_gse189367 = EXPECTED_COHORT_SAMPLES["GSE189367"]
    log:
        f"{DATA_ROOT}/count_data/nbl_count_matrix_verified_{EXPECTED_NBL_SAMPLES}.log"
    conda:
        f"{ENV_DIR}/r-base.yaml"
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname "{output}")" "$(dirname "{log}")"

        Rscript "{input.script}" \
            --matrix "{input.matrix}" \
            --metadata "{input.meta}" \
            --output "{output}" \
            --expected-total "{params.expected_total}" \
            --expected-target "{params.expected_target}" \
            --expected-srp409177 "{params.expected_srp409177}" \
            --expected-gse189367 "{params.expected_gse189367}" \
            > "{log}" 2>&1
        """

