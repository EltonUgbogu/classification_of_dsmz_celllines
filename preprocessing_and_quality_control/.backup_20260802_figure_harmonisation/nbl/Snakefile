        figure_retention = NBL_PURITY_OUTPUTS["sample_retention"],
        figure_pca_pre = BATCH_OUTPUTS["pca_pre_pdf"],
        figure_pca_post = BATCH_OUTPUTS["pca_post_pdf"],
        figure_tumour_vst = BATCH_OUTPUTS["tumour_qc_pdf"],
        figure_dsmz_vst = BATCH_OUTPUTS["dsmz_qc_pdf"],
        figure_tumour_dispersion = BATCH_OUTPUTS["tumour_dispersion_pdf"],
        figure_dsmz_dispersion = BATCH_OUTPUTS["dsmz_dispersion_pdf"],
    output:
        validation_report = FINAL_VALIDATION["report"],
        final_matrix_manifest = FINAL_VALIDATION["manifest"],
        validation_ok = FINAL_VALIDATION["ok"],
        validation_log = FINAL_VALIDATION["log"],
    params:
        cohort = "NBL",
        expected_tumours = EXPECTED_RETAINED_TUMOURS,
        expected_dsmz = EXPECTED_DSMZ_PROFILES,
        expected_collapsed_dsmz = 0,
        final_relative_path = str(
            Path(BATCH_OUTPUTS["joint_vst_post_bc_rds"]).resolve().relative_to(REPO_ROOT)
        ),
    resources:
        mem_mb = 32000
    conda:
        BATCH_ENV
    script:
        FINAL_VALIDATION_SCRIPT

# ------------------------------------------------------------------------------
# MultiQC: per-project aggregation of QC and alignment metrics
# ------------------------------------------------------------------------------
# Bioinformatics intent:
#   MultiQC consolidates FastQC, STAR, and Picard outputs into a single report.
def multiqc_inputs_for_project(project):
    samples = ALL_SAMPLES_BY_PROJECT.get(project, [])

    # FastQC zip archives contain the raw statistics MultiQC parses.
    fq = [f"{DATA_ROOT}/{project}/results/fastqc/{r['sample_read']}_fastqc.zip"
          for r in ALL_FASTQC_READS if r["project"] == project]

    # STAR alignment outputs: BAMs for completeness and Log.final.out for summary metrics.
    star = (
        [f"{DATA_ROOT}/{project}/results/star/{s}.Aligned.sortedByCoord.out.bam" for s in samples] +
        [f"{DATA_ROOT}/{project}/results/star/{s}.Log.final.out" for s in samples]
    )

    # Picard metrics and insert size histogram PDFs.
    metrics = ["validate_samfile", "alignment_summary_metrics",
               "quality_yield_metrics", "insert_size_metrics"]
    pic = ([f"{DATA_ROOT}/{project}/results/picard/{s}_{m}.txt" for s in samples for m in metrics] +
           [f"{DATA_ROOT}/{project}/results/picard/{s}_insert_size_histogram.pdf" for s in samples])

    return fq + star + pic

rule multiqc:
    input:
        lambda wc: multiqc_inputs_for_project(wc.project)
    output:
        html = f"{DATA_ROOT}/{{project}}/results/multiqc/multiqc_report.html"
    params:
        # Reports are written into a dedicated directory for the project.
        outdir = lambda wc: f"{DATA_ROOT}/{wc.project}/results/multiqc",
        indir  = lambda wc: f"{DATA_ROOT}/{wc.project}/results"
    log:   f"{DATA_ROOT}/{{project}}/logs/multiqc.log"
    conda: f"{ENV_DIR}/multiqc.yaml"
    threads: 2
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.outdir}

        # MultiQC scans the results directory and generates an integrated HTML report.
        # The report summarises QC across all samples within the project.
        multiqc {params.indir} -o {params.outdir} -n multiqc_report.html > {log} 2>&1
    """

# ------------------------------------------------------------------------------
# Rule: clean stale STAR temporary directories (opt-in)
# ------------------------------------------------------------------------------
# Run explicitly when needed:  snakemake clean_star_tmp --cores 1
# Never runs automatically; avoids accidental deletion during normal DAG evaluation.
rule clean_star_tmp:
    run:
        import glob as _glob, shutil
        for project_id in PROJECTS:
            pattern = f"{DATA_ROOT}/{project_id}/results/star/tmp_*"
            for tmp_dir in sorted(_glob.glob(pattern)):
                if os.path.isdir(tmp_dir):
                    print(f"[CLEAN] Removing: {tmp_dir}")
                    shutil.rmtree(tmp_dir, ignore_errors=True)
        print("[CLEAN] Done.")
