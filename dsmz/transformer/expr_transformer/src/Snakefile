"""
Expression Transformer Snakemake Workflow
==========================================

GPU-only workflow for Masked Gene Modeling on expression data.

This Snakefile auto-detects paths and works across different repository layouts:
- HPC: /work/ugbogu/expr_transformer with config/config.yaml
- Local: .../dsmz/transformer/expr_transformer with config.yaml at root

No hardcoded paths - everything computed dynamically from Snakefile location.
"""

from pathlib import Path
import sys

# ============================================================================
# Auto-detect repository root and config location
# ============================================================================

# Snakefile is in: <repo_root>/src/Snakefile
# So repo_root is one level up from workflow.basedir
SNAKEFILE_DIR = Path(workflow.basedir)  # .../src/
REPO_ROOT = SNAKEFILE_DIR.parent        # .../expr_transformer/

# Try to find config.yaml in two possible locations
CONFIG_LOCATIONS = [
    REPO_ROOT / "config.yaml",         # Local layout
    REPO_ROOT / "config" / "config.yaml",  # HPC layout
]

CONFIG_FILE = None
for cfg in CONFIG_LOCATIONS:
    if cfg.exists():
        CONFIG_FILE = cfg
        break

if CONFIG_FILE is None:
    sys.stderr.write(f"ERROR: config.yaml not found in any of:\n")
    for loc in CONFIG_LOCATIONS:
        sys.stderr.write(f"  - {loc}\n")
    sys.exit(1)

configfile: str(CONFIG_FILE)

# ============================================================================
# Path resolution
# ============================================================================

# If config specifies project_root, use it; otherwise use detected REPO_ROOT
if "project_root" in config:
    PROJECT_ROOT = Path(config["project_root"]).expanduser().resolve()
else:
    PROJECT_ROOT = REPO_ROOT

# Set working directory to project root
workdir: str(PROJECT_ROOT)


def as_abs(path: str) -> str:
    """Convert relative paths to absolute, relative to PROJECT_ROOT."""
    p = Path(path)
    return str(p if p.is_absolute() else PROJECT_ROOT / p)


# ============================================================================
# Script paths - computed from REPO_ROOT, NOT hardcoded
# ============================================================================

# Scripts are in src/ directory
SRC_DIR = REPO_ROOT / "src"

CHECK_SCRIPT = str(SRC_DIR / "check_gene_order.py")
TRAIN_SCRIPT = str(SRC_DIR / config["train"]["script"]) if "/" not in config["train"]["script"] else as_abs(config["train"]["script"])
EXPORT_SCRIPT = str(SRC_DIR / config["export"]["script"]) if "/" not in config["export"]["script"] else as_abs(config["export"]["script"])

# ============================================================================
# Output directories
# ============================================================================

CKPT_DIR = as_abs(config["paths"]["ckpt_dir"])
EMB_DIR = as_abs(config["paths"]["emb_dir"])
LOGS_DIR = as_abs(config["paths"]["logs_dir"])
BENCH_DIR = as_abs(config["paths"]["benchmarks_dir"])
RESULTS_DIR = PROJECT_ROOT / "results"

# ============================================================================
# Dataset configuration
# ============================================================================

DATASETS = list(config["datasets"].keys())
EPOCHS = int(config["train"]["epochs"])


def ds_npz(ds: str) -> str:
    """Get absolute path to dataset NPZ file."""
    return as_abs(config["datasets"][ds]["npz"])


def ds_meta(ds: str) -> str:
    """Get absolute path to dataset metadata JSON."""
    return as_abs(config["datasets"][ds]["meta"])


def ckpt_prefix(ds: str) -> str:
    """Get checkpoint prefix for dataset."""
    return config["datasets"][ds].get("ckpt_prefix", ds)


def ckpt_path(ds: str) -> str:
    """Get absolute path to checkpoint file."""
    return str(Path(CKPT_DIR) / f"{ckpt_prefix(ds)}_ep{EPOCHS:02d}.pt")


def emb_path(ds: str) -> str:
    """Get absolute path to embeddings TSV file."""
    return str(Path(EMB_DIR) / f"{ds}_embeddings.tsv")


# ============================================================================
# Rules
# ============================================================================

rule all:
    input:
        [emb_path(ds) for ds in DATASETS],
        [ckpt_path(ds) for ds in DATASETS],


rule check_gene_order:
    """Verify gene ordering matches between NPZ and metadata."""
    input:
        npz=lambda wc: ds_npz(wc.ds),
        meta=lambda wc: ds_meta(wc.ds),
    output:
        stamp=lambda wc: str(RESULTS_DIR / wc.ds / "gene_order.ok"),
    log:
        lambda wc: str(Path(LOGS_DIR) / f"check_gene_order_{wc.ds}.log"),
    conda:
        "../envs/exprtf.yml",
    resources:
        mem_mb=2000,
        runtime=5,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname {output.stamp})" "$(dirname {log})"
        python {CHECK_SCRIPT} --npz {input.npz} --meta {input.meta} > {log} 2>&1
        echo "OK" > {output.stamp}
        '''


rule train_mgm:
    """Train Masked Gene Model with Transformer architecture (GPU-only)."""
    input:
        ok=lambda wc: str(RESULTS_DIR / wc.ds / "gene_order.ok"),
        npz=lambda wc: ds_npz(wc.ds),
        meta=lambda wc: ds_meta(wc.ds),
    output:
        ckpt=lambda wc: ckpt_path(wc.ds),
    log:
        lambda wc: str(Path(LOGS_DIR) / f"train_{wc.ds}.log"),
    benchmark:
        lambda wc: str(Path(BENCH_DIR) / f"train_{wc.ds}.tsv"),
    params:
        ckpt_prefix=lambda wc: ckpt_prefix(wc.ds),
        ds=lambda wc: wc.ds,
        batch_size=lambda wc: config["train"]["batch_size"],
        log_every=lambda wc: config["train"]["log_every"],
    conda:
        "../envs/exprtf.yml",
    resources:
        gpu=1,
        cpus=4,
        mem_mb=32000,
        runtime=720,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{CKPT_DIR}" "$(dirname {log})" "$(dirname {benchmark})"
        mkdir -p "{RESULTS_DIR}/{params.ds}"

        nvidia-smi >> {log} 2>&1

        python {TRAIN_SCRIPT} \
          --npz {input.npz} \
          --meta {input.meta} \
          --ckpt-dir {CKPT_DIR} \
          --ckpt-prefix {params.ckpt_prefix} \
          --epochs {EPOCHS} \
          --batch-size {params.batch_size} \
          --log-every {params.log_every} >> {log} 2>&1

        if [ ! -f {output.ckpt} ]; then
          echo "ERROR: expected checkpoint {output.ckpt} not found" >> {log}
          ls -lah {CKPT_DIR} >> {log} 2>&1 || true
          exit 2
        fi
        '''


rule export_embeddings:
    """Export sample embeddings from trained checkpoint (GPU-only)."""
    input:
        ckpt=lambda wc: ckpt_path(wc.ds),
        npz=lambda wc: ds_npz(wc.ds),
        meta=lambda wc: ds_meta(wc.ds),
    output:
        tsv=lambda wc: emb_path(wc.ds),
    log:
        lambda wc: str(Path(LOGS_DIR) / f"export_{wc.ds}.log"),
    benchmark:
        lambda wc: str(Path(BENCH_DIR) / f"export_{wc.ds}.tsv"),
    params:
        batch_size=lambda wc: config["export"]["batch_size"],
    conda:
        "../envs/exprtf.yml",
    resources:
        gpu=1,
        cpus=2,
        mem_mb=16000,
        runtime=120,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{EMB_DIR}" "$(dirname {log})" "$(dirname {benchmark})"

        nvidia-smi >> {log} 2>&1

        python {EXPORT_SCRIPT} \
          --npz {input.npz} \
          --meta {input.meta} \
          --ckpt {input.ckpt} \
          --out {output.tsv} \
          --batch-size {params.batch_size} >> {log} 2>&1
        '''
