"""
Expression Transformer Snakemake Workflow
==========================================
# Snakefile for the Expression Transformer project
"""

from pathlib import Path

# ============================================================================
# Auto-detect repository root
# ============================================================================

# Snakefile is in: <repo_root>/src/Snakefile
# So repo_root is one level up from workflow.basedir
SNAKEFILE_DIR = Path(workflow.basedir)  # .../src/
REPO_ROOT = SNAKEFILE_DIR.parent        # .../expr_transformer/

# Standard config location: config/config.yaml (absolute path for robustness)
configfile: str(REPO_ROOT / "config" / "config.yaml")

# ============================================================================
# Path resolution
# ============================================================================

# If config specifies project_root, use it; otherwise use detected REPO_ROOT
if "project_root" in config:
    PROJECT_ROOT = Path(config["project_root"]).expanduser().resolve()
else:
    PROJECT_ROOT = REPO_ROOT

# Set working directory to project root
workdir: str(PROJECT_ROOT)


def as_abs(path: str) -> str:
    """Convert relative paths to absolute, relative to PROJECT_ROOT."""
    p = Path(path)
    return str(p if p.is_absolute() else PROJECT_ROOT / p)


# ============================================================================
# Script paths - computed from REPO_ROOT, NOT hardcoded
# ============================================================================

# Scripts are in src/ directory
SRC_DIR = REPO_ROOT / "src"

CHECK_SCRIPT = str(SRC_DIR / "check_gene_order.py")
PREP_SCRIPT = str(SRC_DIR / "prep_rds_to_npz.py")
TRAIN_SCRIPT = str(SRC_DIR / config["train"]["script"]) if "/" not in config["train"]["script"] else as_abs(config["train"]["script"])
EXPORT_SCRIPT = str(SRC_DIR / config["export"]["script"]) if "/" not in config["export"]["script"] else as_abs(config["export"]["script"])

# ============================================================================
# Output directories
# ============================================================================

CKPT_DIR = as_abs(config["paths"]["ckpt_dir"])
EMB_DIR = as_abs(config["paths"]["emb_dir"])
LOGS_DIR = as_abs(config["paths"]["logs_dir"])
BENCH_DIR = as_abs(config["paths"]["benchmarks_dir"])
RESULTS_DIR = PROJECT_ROOT / "results"

# ============================================================================
# Dataset configuration
# ============================================================================

CANCERS = config["cancers"]
EPOCHS = int(config["train"]["epochs"])

# Cancers that have RDS sources for prep_npz rule
PREP_CANCERS = [c for c in CANCERS if "rds" in config["datasets"][c]]


def ckpt_prefix(cancer: str) -> str:
    """Get checkpoint prefix for cancer (used in params, not outputs)."""
    return config["datasets"][cancer].get("ckpt_prefix", f"exprtf_{cancer}")


def prefix_to_cancer(prefix: str) -> str:
    """Reverse lookup: find cancer from checkpoint prefix."""
    for cancer in CANCERS:
        if ckpt_prefix(cancer) == prefix:
            return cancer
    raise ValueError(f"No cancer found for prefix: {prefix}")


# Output patterns (must be plain strings with wildcards for Snakemake 5.10)
# Use {prefix} wildcard to match actual checkpoint prefixes (e.g., exprtf_brca_hvg500)
CKPT_OUT = str(Path(CKPT_DIR) / f"{{prefix}}_ep{EPOCHS:02d}.pt")
EMB_OUT = str(Path(EMB_DIR) / "{prefix}_embeddings.tsv")
# Data files use {cancer} wildcard
NPZ_OUT = str(Path(PROJECT_ROOT) / "data" / "{cancer}" / "joint.npz")
META_OUT = str(Path(PROJECT_ROOT) / "data" / "{cancer}" / "joint.meta.json")
OK_STAMP = str(Path(RESULTS_DIR) / "{cancer}" / "gene_order.ok")


# ============================================================================
# Rules
# ============================================================================

rule all:
    input:
        # Use expand with prefix from config for each cancer
        expand(EMB_OUT, prefix=[ckpt_prefix(c) for c in CANCERS]),
        expand(CKPT_OUT, prefix=[ckpt_prefix(c) for c in CANCERS]),


rule prep_npz:
    """Convert RDS to NPZ and metadata JSON (only for cancers with rds: in config)."""
    input:
        rds=lambda wc: (
            as_abs(config["datasets"][wc.cancer]["rds"])
            if "rds" in config["datasets"][wc.cancer] and config["datasets"][wc.cancer]["rds"]
            else None
        ),
    output:
        npz=NPZ_OUT,
        meta=META_OUT,
    log:
        str(Path(LOGS_DIR) / "prep_{cancer}.log"),
    threads: 1
    resources:
        mem_mb=8000,
        runtime=30,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname {output.npz})" "$(dirname {output.meta})" "$(dirname {log})"

        # Verify RDS path exists (should be set in config for this cancer)
        if [ -z "{input.rds}" ] || [ "{input.rds}" = "None" ] || [ ! -f "{input.rds}" ]; then
          echo "ERROR: RDS file not found or not configured for cancer {wildcards.cancer}" >> {log}
          echo "Add 'rds: path/to/file.rds' to config['datasets']['{wildcards.cancer}']" >> {log}
          exit 1
        fi

        /work/ugbogu/.conda/envs/exprtf/bin/python {PREP_SCRIPT} \
          --rds {input.rds} \
          --npz {output.npz} \
          --meta {output.meta} \
          --cancer {wildcards.cancer} >> {log} 2>&1
        '''


rule check_gene_order:
    """Verify gene ordering matches between NPZ and metadata."""
    input:
        npz=NPZ_OUT,
        meta=META_OUT,
    output:
        stamp=OK_STAMP,
    log:
        str(Path(LOGS_DIR) / "check_gene_order_{cancer}.log"),
    threads: 1
    resources:
        mem_mb=2000,
        runtime=5,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "$(dirname {output.stamp})" "$(dirname {log})"

        # Use existing exprtf env directly
        /work/ugbogu/.conda/envs/exprtf/bin/python {CHECK_SCRIPT} \
          --npz {input.npz} \
          --meta {input.meta} >> {log} 2>&1

        echo "OK" > {output.stamp}
        '''


rule train_mgm:
    """Train Masked Gene Model with Transformer architecture (GPU-only)."""
    input:
        ok=lambda wc: OK_STAMP.replace("{cancer}", prefix_to_cancer(wc.prefix)),
        npz=lambda wc: NPZ_OUT.replace("{cancer}", prefix_to_cancer(wc.prefix)),
        meta=lambda wc: META_OUT.replace("{cancer}", prefix_to_cancer(wc.prefix)),
    output:
        ckpt=CKPT_OUT,
    log:
        str(Path(LOGS_DIR) / "train_{prefix}.log"),
    benchmark:
        str(Path(BENCH_DIR) / "train_{prefix}.tsv"),
    params:
        cancer=lambda wc: prefix_to_cancer(wc.prefix),
        ckpt_prefix=lambda wc: wc.prefix,
        batch_size=config["train"]["batch_size"],
        log_every=config["train"]["log_every"],
    threads: 4
    resources:
        gpu=1,
        mem_mb=32000,
        runtime=720,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{CKPT_DIR}" "{BENCH_DIR}" "$(dirname {log})"
        mkdir -p "{RESULTS_DIR}/{params.cancer}"

        nvidia-smi >> {log} 2>&1

        /work/ugbogu/.conda/envs/exprtf/bin/python {TRAIN_SCRIPT} \
          --npz {input.npz} \
          --meta {input.meta} \
          --ckpt-dir {CKPT_DIR} \
          --ckpt-prefix {params.ckpt_prefix} \
          --epochs {EPOCHS} \
          --batch-size {params.batch_size} \
          --log-every {params.log_every} >> {log} 2>&1

        # Verify checkpoint was created (training script uses --ckpt-prefix to create the file)
        if [ ! -f {output.ckpt} ]; then
          echo "ERROR: expected checkpoint {output.ckpt} not found" >> {log}
          ls -lah {CKPT_DIR} >> {log} 2>&1 || true
          exit 2
        fi
        '''


rule export_embeddings:
    """Export sample embeddings from trained checkpoint (GPU-only)."""
    input:
        ckpt=CKPT_OUT,
        npz=lambda wc: NPZ_OUT.replace("{cancer}", prefix_to_cancer(wc.prefix)),
        meta=lambda wc: META_OUT.replace("{cancer}", prefix_to_cancer(wc.prefix)),
    output:
        tsv=EMB_OUT,
    log:
        str(Path(LOGS_DIR) / "export_{prefix}.log"),
    benchmark:
        str(Path(BENCH_DIR) / "export_{prefix}.tsv"),
    params:
        cancer=lambda wc: prefix_to_cancer(wc.prefix),
        batch_size=config["export"]["batch_size"],
    threads: 2
    resources:
        gpu=1,
        mem_mb=16000,
        runtime=60,
    shell:
        r'''
        set -euo pipefail
        mkdir -p "{EMB_DIR}" "{BENCH_DIR}" "$(dirname {log})"

        nvidia-smi >> {log} 2>&1

        /work/ugbogu/.conda/envs/exprtf/bin/python {EXPORT_SCRIPT} \
          --npz {input.npz} \
          --meta {input.meta} \
          --ckpt {input.ckpt} \
          --out {output.tsv} \
          --batch-size {params.batch_size} \
          --device cuda >> {log} 2>&1
        '''
