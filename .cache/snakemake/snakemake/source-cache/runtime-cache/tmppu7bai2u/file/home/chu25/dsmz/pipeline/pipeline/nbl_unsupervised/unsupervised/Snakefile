        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_kmeans_cell_tumour.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/kmeans_cell_tumour.R --cell_rds {input.cell} --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --cell_label CELL --tumour_label TUMOUR --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule agnostic_all_directions:
    input:
        expand(os.path.join(AGN_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_DIRECTIONS, kind=HC_KINDS),
        expand(os.path.join(AGN_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=AGN_EUC_DIRECTIONS, kind=KM_KINDS)

# STEP 2: Consensus Clustering

CONS_ROOT = os.path.join(UNSUP, "consensus")
CONS_KM_KINDS = ["ccp_kmeans_expr_cell_tumour", "ccp_kmeans_pca_cell_tumour", "ccp_kmeans_expr_cell", "ccp_kmeans_pca_cell", "ccp_kmeans_expr_tumour", "ccp_kmeans_pca_tumour"]
CONS_HC_KINDS = ["ccp_hc_expr_cell_tumour", "ccp_hc_pca_cell_tumour", "ccp_hc_expr_cell", "ccp_hc_pca_cell", "ccp_hc_expr_tumour", "ccp_hc_pca_tumour"]

def cons_outdir(direction, kind):
    return os.path.join(CONS_ROOT, direction, kind)

def kind_to_mode(kind):
    return "pca" if "_pca_" in kind else "expr"

def kind_to_alg(kind):
    return "hc" if kind.startswith("ccp_hc_") else "km"

rule consensus_ccp_cell_tumour:
    input:
        config = "config/config.yaml",
        hvg_list = cfgpath("features", "hvg_final_gene_list")
    output:
        cluster_rds = os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds")
    params:
        outdir = lambda wc: cons_outdir(wc.direction, wc.kind),
        mode = lambda wc: kind_to_mode(wc.kind),
        alg = lambda wc: kind_to_alg(wc.kind)
    log: "logs/consensus_ccp_{direction}_{kind}.log"
    wildcard_constraints:
        direction=CONS_DIRECTION_PATTERN,
        kind="ccp_kmeans_expr_cell_tumour|ccp_hc_expr_cell_tumour|ccp_kmeans_pca_cell_tumour|ccp_hc_pca_cell_tumour|ccp_kmeans_expr_cell|ccp_hc_expr_cell|ccp_kmeans_pca_cell|ccp_hc_pca_cell|ccp_kmeans_expr_tumour|ccp_hc_expr_tumour|ccp_kmeans_pca_tumour|ccp_hc_pca_tumour"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/consensus_ccp_cell_tumour.R --config {input.config} --direction {wildcards.direction} --kind {wildcards.kind} --mode {params.mode} --alg {params.alg} --outdir {params.outdir} --cluster_rds {output.cluster_rds} > {log} 2>&1
        '''

rule consensus_all_directions:
    input:
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_DIRECTIONS, kind=CONS_HC_KINDS),
        expand(os.path.join(CONS_ROOT, "{direction}", "{kind}", "{kind}_clusters_optimal.rds"), direction=CONS_EUC_DIRECTIONS, kind=CONS_KM_KINDS)

# STEP 3: Tumour Neighbourhood Analysis
# Note: NBL uses HVG only - PAM50 is not applicable to NBL

TUMOUR_NH_ROOT = os.path.join(UNSUP, "tumour_neighbourhoods")
# PAM50 paths commented out for NBL
# TUMOUR_NH_EXPR_PAM50 = cfgpath("paths", "tumour_nh_expr_pam50")
TUMOUR_NH_EXPR_HVG = cfgpath("paths", "tumour_nh_expr_hvg")
# TUMOUR_NH_MAP_RDS_PAM50 = os.path.join(os.path.dirname(TUMOUR_NH_EXPR_PAM50), "cell_line_to_original_sample_id_pam50.rds")
TUMOUR_NH_MAP_RDS_HVG = os.path.join(os.path.dirname(TUMOUR_NH_EXPR_HVG), "cell_line_to_original_sample_id_hvg.rds")

# PAM50 rule commented out for NBL - NBL does not use PAM50
# rule build_tumour_neighbourhood_input_pam50:
#     # Note: PAM50 is not applicable to NBL - NBL primarily uses HVG
#     input:
#         tcga_pam50 = cfgpath("paths", "tcga_brca_pam50_expr") if "tcga_brca_pam50_expr" in cfg["paths"] else cfgpath("paths", "tcga_pam50_expr"),
#         dsmz_pam50 = cfgpath("paths", "dsmz_bcc_pam50_expr") if "dsmz_bcc_pam50_expr" in cfg["paths"] else cfgpath("paths", "dsmz_pam50_expr"),
#         dsmz_meta = cfgpath("paths", "dsmz_meta_csv")
#     output:
#         expr_rds = TUMOUR_NH_EXPR_PAM50,
#         map_rds = TUMOUR_NH_MAP_RDS_PAM50
#     log: "logs/build_tumour_neighbourhood_input_pam50.log"
#     shell:
#         r'''
#         mkdir -p $(dirname {output.expr_rds})
#         Rscript scripts/build_dsmz_tcga_pam50matrix.R --config config/config.yaml > {log} 2>&1
#         '''

rule build_tumour_neighbourhood_input_hvg:
    input:
        vst_joint = VST_JOINT,
        hvg_list = cfgpath("features", "hvg_final_gene_list"),
        dsmz_meta = cfgpath("paths", "dsmz_meta_csv")
    output:
        expr_rds = TUMOUR_NH_EXPR_HVG,
        map_rds = TUMOUR_NH_MAP_RDS_HVG
    log: "logs/build_tumour_neighbourhood_input_hvg.log"
    shell:
        r'''
        mkdir -p $(dirname {output.expr_rds})
        Rscript scripts/build_dsmz_tcga_hvgmatrix.R --config config/config.yaml > {log} 2>&1
        '''

rule tumour_neighbourhoods_hc_any:
    # Note: NBL uses HVG only - PAM50 directions are not used
    input:
        expr_rds = TUMOUR_NH_EXPR_HVG,  # NBL uses HVG only
        map_rds = TUMOUR_NH_MAP_RDS_HVG  # NBL uses HVG only
    output:
        outdir = directory(os.path.join(TUMOUR_NH_ROOT, "{direction}")),
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done"))
    log: "logs/tumour_neighbourhoods_hc_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {output.outdir}
        Rscript scripts/comp_tumour_neighbourhoods.R --config config/config.yaml --direction {wildcards.direction} > {log} 2>&1
        test $(find {output.outdir} -maxdepth 2 -type f -name "Top_m_long_*.csv" | wc -l) -gt 0 || (echo "ERROR: No Top_m_long_*.csv" >&2 && exit 1)
        touch {output.done}
        '''

rule tumour_neighbourhoods_km_any:
    input:
        done = os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_done")
    output:
        done = touch(os.path.join(TUMOUR_NH_ROOT, "{direction}", ".tumour_neighbourhoods_km_done"))
    log: "logs/tumour_neighbourhoods_km_{direction}.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        Rscript scripts/comp_tumour_neighbourhoods.R --config config/config.yaml --direction {wildcards.direction} > {log} 2>&1
        touch {output.done}
        '''

def pcons_inputs(wc):
    d = wc.direction
    outs = [os.path.join(TUMOUR_NH_ROOT, d, ".tumour_neighbourhoods_done")]
    if d.endswith("_euc"):
        outs.append(os.path.join(TUMOUR_NH_ROOT, d, ".tumour_neighbourhoods_km_done"))
    return outs

rule tumour_neighbourhood_p_consensus:
    input:
        pcons_inputs
    output:
        consensus_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.rds"),
        consensus_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.tsv")
    log: "logs/tumour_neighbourhood_p_consensus_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.consensus_rds})
        Rscript scripts/tumour_neighbourhood_p_consensus.R --config config/config.yaml --direction {wildcards.direction} > {log} 2>&1
        '''

# STEP 4: DSMZ-DSMZ Similarity Graph

rule dsmz_dsmz_similarity_graph:
    input:
        consensus_rds = rules.tumour_neighbourhood_p_consensus.output.consensus_rds
    output:
        sim_mat_rds = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_matrix_{direction}.rds"),
        sim_pairs_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_pairs_{direction}.tsv"),
        edges_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
        nodes_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_summary_{direction}.tsv"),
        nodes_annot = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_annotations_{direction}.tsv"),
        comm_summary = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_community_summary_{direction}.tsv"),
        comm_table = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_Louvain_vs_Leiden_community_table_{direction}.tsv"),
        hist_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_similarity_histogram_{direction}.pdf"),
        scatter_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_p_consensus_cell_scatter_{direction}.pdf"),
        comm_heatmap = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_Louvain_vs_Leiden_heatmap_{direction}.pdf"),
        graph_leiden = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Leiden_{direction}.pdf"),
        graph_louvain = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Louvain_{direction}.pdf"),
        graph_minimal = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_minimal_{direction}.pdf")
    log: "logs/dsmz_dsmz_similarity_graph_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.sim_mat_rds})
        Rscript scripts/compute_dsmz_dsmz_similarity.R --config config/config.yaml --direction {wildcards.direction} > {log} 2>&1
        '''

# STEP 5: Cross-Direction Summary

P_CONS_ALL_DIR = os.path.join(TUMOUR_NH_ROOT, "final_consensus_all")

rule summarize_p_consensus_all:
    input:
        consensus_rds = expand(os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Final_consensus_tumour_neighbourhoods_{direction}.rds"), direction=AGN_DIRECTIONS),
        cfg = "config/config.yaml"
    output:
        dir_summary = os.path.join(P_CONS_ALL_DIR, "p_consensus_direction_summary.tsv"),
        cell_dir_summary = os.path.join(P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.tsv"),
        winner_map = os.path.join(P_CONS_ALL_DIR, "p_consensus_winner_map_per_cell_line.tsv"),
        winners_max_p = os.path.join(P_CONS_ALL_DIR, "p_consensus_winners_by_max_p.tsv"),
        winners_frac = os.path.join(P_CONS_ALL_DIR, "p_consensus_winners_by_frac_ge_thr.tsv"),
        ranked_best = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_ranked.tsv"),
        long_tbl = os.path.join(P_CONS_ALL_DIR, "p_consensus_cellline_direction_summary.long.tsv"),
        composite_weights = os.path.join(P_CONS_ALL_DIR, "p_consensus_composite_weights.tsv"),
        top_fraction = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_fraction.tsv"),
        top_score = os.path.join(P_CONS_ALL_DIR, "p_consensus_best_cell_lines_top_score.tsv"),
        fig_pdf = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_direction_comparison.pdf"),
        fig_scree = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_scree.pdf"),
        fig_weights = os.path.join(P_CONS_ALL_DIR, "Fig_p_consensus_composite_PCA_weights.pdf")
    params:
        threshold = lambda wc: config.get("tumour_neighbourhoods", {}).get("p_consensus_threshold", 0.7)
    log: "logs/summarize_p_consensus_all.log"
    shell:
        r'''
        mkdir -p {P_CONS_ALL_DIR}
        Rscript scripts/summarize_p_consensus_all.R --config {input.cfg} --threshold {params.threshold} > {log} 2>&1
        '''

# STEP 6: QC and Integration UMAP
# KEY FIX: map_rds now direction-aware (PAM50 vs HVG)

rule tumour_neighbourhood_qc_umap:
    # Note: NBL uses HVG only - PAM50 directions are not used
    input:
        consensus_rds = rules.tumour_neighbourhood_p_consensus.output.consensus_rds,
        expr_rds = TUMOUR_NH_EXPR_HVG,  # NBL uses HVG only
        map_rds = TUMOUR_NH_MAP_RDS_HVG,  # NBL uses HVG only
        cfg_file = "config/config.yaml"
    output:
        qc_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Neighbourhood_QC_summary_{direction}.tsv"),
        umap_pdf = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_tumour_cell_integration_UMAP_{direction}.pdf"),
        umap_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "UMAP_tumour_cell_coords_{direction}.tsv")
    log: "logs/tumour_neighbourhood_qc_umap_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.qc_tsv})
        Rscript scripts/tumour_neighbourhood_qc_umap.R \
          --config {input.cfg_file} --direction {wildcards.direction} \
          --consensus_rds {input.consensus_rds} --expr_rds {input.expr_rds} --map_rds {input.map_rds} \
          --qc_tsv {output.qc_tsv} --umap_pdf {output.umap_pdf} --umap_tsv {output.umap_tsv} > {log} 2>&1
        '''

# DEFAULT TARGET

rule all:
    input:
        # PRESTEP: Feature Selection
        rules.feature_selection_unsupervised.output.scores,
        rules.feature_selection_unsupervised.output.hvg_list,

        # STEP 1: Agnostic Clustering
        rules.agnostic_all_directions.input,

        # STEP 2: Consensus Clustering
        rules.consensus_all_directions.input,

        # STEP 3: Tumour Neighbourhood Consensus
        expand(rules.tumour_neighbourhood_p_consensus.output.consensus_rds, direction=AGN_DIRECTIONS),
        expand(rules.tumour_neighbourhood_p_consensus.output.consensus_tsv, direction=AGN_DIRECTIONS),

        # STEP 4: DSMZ-DSMZ Similarity Graphs (all outputs)
        expand(rules.dsmz_dsmz_similarity_graph.output.sim_mat_rds,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.sim_pairs_tsv, direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.edges_tsv,     direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.nodes_tsv,     direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.nodes_annot,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_summary,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_table,    direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.hist_pdf,      direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.scatter_pdf,   direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.comm_heatmap,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_leiden,  direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_louvain, direction=AGN_DIRECTIONS),
        expand(rules.dsmz_dsmz_similarity_graph.output.graph_minimal, direction=AGN_DIRECTIONS),

        # STEP 5: Cross-Direction Summary
        rules.summarize_p_consensus_all.output,

        # STEP 6: QC and Integration UMAP
        expand(os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Neighbourhood_QC_summary_{direction}.tsv"), direction=AGN_DIRECTIONS),
        expand(os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_tumour_cell_integration_UMAP_{direction}.pdf"), direction=AGN_DIRECTIONS),
        expand(os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "UMAP_tumour_cell_coords_{direction}.tsv"), direction=AGN_DIRECTIONS)
