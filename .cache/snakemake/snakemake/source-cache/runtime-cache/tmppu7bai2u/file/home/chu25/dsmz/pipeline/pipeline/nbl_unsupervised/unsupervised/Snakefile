#!/usr/bin/env snakemake

# Unsupervised Clustering and Tumour Neighbourhood Analysis Pipeline
# This pipeline is for NBL (neuroblastoma) analysis
# Note: PAM50 is a placeholder for selected gene sets; NBL primarily uses HVG
# Fixed: Separate map_rds files for PAM50 and HVG directions

import os
import re
from snakemake.shell import shell

configfile: "config/config.yaml"

BASE = os.path.abspath(workflow.basedir)

def abspath(p):
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(BASE, p))

def cfgpath(*keys):
    d = cfg
    for k in keys:
        d = d[k]
    return abspath(d)

shell.prefix("set -euo pipefail; source $HOME/miniconda3/etc/profile.d/conda.sh; conda activate tcga-r-env; ")

cfg = config

UNSUP = cfgpath("paths", "unsup_root")
VST_JOINT = cfgpath("paths", "vst_joint_rds")
CELL_VST = cfgpath("paths", "cell_vst_rds")
TUMOUR_VST = cfgpath("paths", "tumour_vst_rds")

# PRESTEP: Build joint VST (if needed) and Feature Selection

rule build_vst_joint_nbl:
    input:
        cell = CELL_VST,
        tumour = TUMOUR_VST
    output:
        joint = VST_JOINT
    log: "logs/build_vst_joint_nbl.log"
    shell:
        r'''
        mkdir -p $(dirname {output.joint})
        Rscript scripts/build_vst_joint_from_cell_tumour.R \
          --cell_rds {input.cell} --tumour_rds {input.tumour} --out_rds {output.joint} > {log} 2>&1
        '''

# PRESTEP: Feature Selection

rule feature_selection_unsupervised:
    input:
        vst = VST_JOINT,  # Depends on build_vst_joint_nbl if VST_JOINT doesn't exist
        cfg_file = "config/config.yaml"
    output:
        scores = cfgpath("features", "hvg_joint_scores_tsv"),
        hvg_list = cfgpath("features", "hvg_final_gene_list")
    log: "logs/feature_selection_unsupervised.log"
    shell:
        r'''
        mkdir -p $(dirname {output.scores}) $(dirname {output.hvg_list})
        Rscript scripts/feature_selection_unsupervised.R --config {input.cfg_file} --vst_rds {input.vst} > {log} 2>&1
        '''

# STEP 1 Config
AGN_ROOT = abspath(cfg["paths"].get("agnostic_cluster_root", os.path.join(UNSUP, "agnostic_clustering")))
AGN_BASE_FUN = abspath(cfg["paths"].get("agnostic_base_functions_dir", cfg["paths"].get("base_functions_dir", os.path.join(UNSUP, "base_functions"))))

AGN_CFG = cfg.get("agnostic_clustering", {})
AGN_N_PCS = AGN_CFG.get("n_pcs", 20)
AGN_MAX_K_HC = AGN_CFG.get("max_k_hc", 8)
AGN_KMIN = AGN_CFG.get("k_min", 2)
AGN_KMAX = AGN_CFG.get("k_max", 8)
AGN_SEED = AGN_CFG.get("seed", 42)

AGN_DIRECTIONS = cfg.get("tumour_neighbourhoods", {}).get("directions", ["hvg_euc", "hvg_corr"])
AGN_DIRECTION_PATTERN = "|".join(map(re.escape, AGN_DIRECTIONS))
AGN_EUC_DIRECTIONS = [d for d in AGN_DIRECTIONS if d.endswith("_euc")]
AGN_EUC_PATTERN = "|".join(map(re.escape, AGN_EUC_DIRECTIONS)) if AGN_EUC_DIRECTIONS else r"a^"

CONS_DIRECTIONS = cfg.get("tumour_neighbourhoods", {}).get("directions", AGN_DIRECTIONS)
CONS_DIRECTION_PATTERN = "|".join(map(re.escape, CONS_DIRECTIONS))
CONS_EUC_DIRECTIONS = [d for d in CONS_DIRECTIONS if d.endswith("_euc")]
CONS_EUC_PATTERN = "|".join(map(re.escape, CONS_EUC_DIRECTIONS)) if CONS_EUC_DIRECTIONS else r"a^"

PAM50_DIRS = [d for d in AGN_DIRECTIONS if d.startswith("pam50")]
HVG_DIRS = [d for d in AGN_DIRECTIONS if not d.startswith("pam50")]

HC_KINDS = ["pca_hc_cell", "pca_hc_tumour", "pca_hc_cell_tumour", "hc_cell", "hc_tumour", "hc_cell_tumour"]
KM_KINDS = ["pca_kmeans_cell", "pca_kmeans_tumour", "pca_kmeans_cell_tumour", "kmeans_cell", "kmeans_tumour", "kmeans_cell_tumour"]

def dir_to_feature(direction):
    return "pam50" if direction.startswith("pam50") else "hvg"

def dir_to_dist(direction):
    return "correlation" if direction.endswith("corr") else "euclidean"

def dir_to_gene_list(direction):
    return cfgpath("features", "pam50_ensembl_gene_list" if dir_to_feature(direction) == "pam50" else "hvg_final_gene_list")

def dir_to_geneset(direction):
    return "PAM50" if direction.startswith("pam50") else "HVG500"

def agn_outdir_dir(direction, kind):
    return os.path.join(AGN_ROOT, direction, kind)

# STEP 1 Rules

rule build_agnostic_mats:
    input:
        cell = CELL_VST,
        tumour = TUMOUR_VST,
        genes = lambda wc: dir_to_gene_list(wc.direction)
    output:
        cell_filt = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour_filt = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    log: "logs/build_agnostic_mats_{direction}.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p $(dirname {output.cell_filt}) $(dirname {output.tumour_filt})
        Rscript scripts/build_agnostic_direction_mats.R --cell_rds {input.cell} --tumour_rds {input.tumour} --genes {input.genes} --out_cell {output.cell_filt} --out_tumour {output.tumour_filt} > {log} 2>&1
        '''

rule pca_hc_cell:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_hc_cell", "pca_hc_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_hc_cell.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_hc_tumour:
    input:
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_hc_tumour", "pca_hc_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_hc_tumour.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_tumour.R --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --label TUMOUR --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_hc_cell_tumour:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_hc_cell_tumour", "pca_hc_cell_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_hc_cell_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_hc_cell_tumour.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_cell_tumour.R --cell_rds {input.cell} --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --cell_label CELL --tumour_label TUMOUR --n_pcs {params.n_pcs} --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_kmeans_cell:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_kmeans_cell", "pca_kmeans_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_kmeans_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_kmeans_cell.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_kmeans_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --n_pcs {params.n_pcs} --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_kmeans_tumour:
    input:
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_kmeans_tumour", "pca_kmeans_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_kmeans_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_kmeans_tumour.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_kmeans_tumour.R --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --label TUMOUR --n_pcs {params.n_pcs} --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule pca_kmeans_cell_tumour:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "pca_kmeans_cell_tumour", "pca_kmeans_cell_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "pca_kmeans_cell_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs = AGN_N_PCS,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_pca_kmeans_cell_tumour.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_kmeans_cell_tumour.R --cell_rds {input.cell} --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --cell_label CELL --tumour_label TUMOUR --n_pcs {params.n_pcs} --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule hc_cell:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "hc_cell", "hc_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "hc_cell"),
        base_dir = AGN_BASE_FUN,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_hc_cell.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/hc_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule hc_tumour:
    input:
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "hc_tumour", "hc_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "hc_tumour"),
        base_dir = AGN_BASE_FUN,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_hc_tumour.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/hc_tumour.R --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --label TUMOUR --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule hc_cell_tumour:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "hc_cell_tumour", "hc_cell_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "hc_cell_tumour"),
        base_dir = AGN_BASE_FUN,
        max_k = AGN_MAX_K_HC,
        dist = lambda wc: dir_to_dist(wc.direction),
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_hc_cell_tumour.log"
    wildcard_constraints:
        direction=AGN_DIRECTION_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/hc_cell_tumour.R --cell_rds {input.cell} --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --cell_label CELL --tumour_label TUMOUR --max_k {params.max_k} --dist_method {params.dist} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule kmeans_cell:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "kmeans_cell", "kmeans_cell_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "kmeans_cell"),
        base_dir = AGN_BASE_FUN,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_kmeans_cell.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/kmeans_cell.R --cell_rds {input.cell} --outdir {params.outdir} --base_dir {params.base_dir} --label CELL --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule kmeans_tumour:
    input:
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "kmeans_tumour", "kmeans_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "kmeans_tumour"),
        base_dir = AGN_BASE_FUN,
        kmin = AGN_KMIN,
        kmax = AGN_KMAX,
        seed = AGN_SEED
    log: "logs/agnostic_{direction}_kmeans_tumour.log"
    wildcard_constraints:
        direction=AGN_EUC_PATTERN
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/kmeans_tumour.R --tumour_rds {input.tumour} --outdir {params.outdir} --base_dir {params.base_dir} --label TUMOUR --k_min {params.kmin} --k_max {params.kmax} --seed {params.seed} --cluster_rds {output.clusters} > {log} 2>&1
        '''

rule kmeans_cell_tumour:
    input:
        cell = os.path.join(AGN_ROOT, "{direction}", "inputs", "cell_expr.rds"),
        tumour = os.path.join(AGN_ROOT, "{direction}", "inputs", "tumour_expr.rds")
    output:
        clusters = os.path.join(AGN_ROOT, "{direction}", "kmeans_cell_tumour", "kmeans_cell_tumour_clusters_optimal.rds")
    params:
        outdir = lambda wc: agn_outdir_dir(wc.direction, "kmeans_cell_tumour"),
