        seed     = AGN_SEED
    log:
        "logs/agnostic_hc_tumour.log"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/hc_tumour.R \
          --tumour_rds {input.tumour} \
          --outdir {params.outdir} \
          --base_dir {params.base_dir} \
          --label TUMOUR \
          --max_k {params.max_k} \
          --dist_method {params.dist} \
          --seed {params.seed} \
          --cluster_rds {output.clusters} \
          > {log} 2>&1
        '''

rule hc_cell_tumour:
    input:
        cell   = CELL_VST,
        tumour = TUMOUR_VST
    output:
        clusters = agn_cluster_rds("hc_cell_tumour")
    params:
        outdir      = agn_outdir("hc_cell_tumour"),
        base_dir    = AGN_BASE_FUN,
        max_k       = AGN_MAX_K_HC,
        dist        = AGN_DIST,
        seed        = AGN_SEED,
        cell_label   = "CELL",
        tumour_label = "TUMOUR"
    log:
        "logs/agnostic_hc_cell_tumour.log"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/hc_cell_tumour.R \
          --cell_rds {input.cell} \
          --tumour_rds {input.tumour} \
          --outdir {params.outdir} \
          --base_dir {params.base_dir} \
          --cell_label {params.cell_label} \
          --tumour_label {params.tumour_label} \
