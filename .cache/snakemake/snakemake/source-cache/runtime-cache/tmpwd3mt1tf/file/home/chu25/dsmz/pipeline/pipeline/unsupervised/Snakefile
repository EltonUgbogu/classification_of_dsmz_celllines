import os
import yaml
from snakemake.shell import shell

configfile: "config/config.yaml"

# All shell commands run inside tcga-r-env
shell.prefix(
    "source $HOME/miniconda3/etc/profile.d/conda.sh; "
    "conda activate tcga-r-env; "
)

cfg = config

UNSUP = cfg["paths"]["unsup_root"]
VST_JOINT = cfg["paths"]["vst_joint_rds"]

# ─────────────────────────────────────────────────────────────
# Agnostic 12-way clustering: globals
# ─────────────────────────────────────────────────────────────

# VST + batch-corrected matrices for CELL lines and TUMOURs
CELL_VST   = cfg["paths"]["cell_vst_rds"]
TUMOUR_VST = cfg["paths"]["tumour_vst_rds"]

# Where to put agnostic clustering results
AGN_ROOT = cfg["paths"].get(
    "agnostic_cluster_root",
    os.path.join(UNSUP, "agnostic_clustering")
)

# Base_functions directory for the agnostic clustering scripts
AGN_BASE_FUN = cfg["paths"].get(
    "agnostic_base_functions_dir",
    cfg["paths"].get("base_functions_dir", os.path.join(UNSUP, "base_functions"))
)

# Clustering hyperparameters for the 12-way agnostic clustering
AGN_CFG = cfg.get("agnostic_clustering", {})
AGN_N_PCS     = AGN_CFG.get("n_pcs", 20)
AGN_MAX_K_HC  = AGN_CFG.get("max_k_hc", 8)
AGN_KMIN      = AGN_CFG.get("k_min", 2)
AGN_KMAX      = AGN_CFG.get("k_max", 8)
AGN_DIST      = AGN_CFG.get("dist_method", "euclidean")
AGN_SEED      = AGN_CFG.get("seed", 42)

# 12 agnostic clustering variants:
# PCA/raw × HC/k-means × cell/tumour/integrated
AGN_KINDS = [
    "pca_hc_cell",
    "pca_hc_tumour",
    "pca_hc_cell_tumour",
    "pca_kmeans_cell",
    "pca_kmeans_tumour",
    "pca_kmeans_cell_tumour",
    "hc_cell",
    "hc_tumour",
    "hc_cell_tumour",
    "kmeans_cell",
    "kmeans_tumour",
    "kmeans_cell_tumour",
]

def agn_outdir(kind):
    """Output directory for a given agnostic clustering kind."""
    return os.path.join(AGN_ROOT, kind)

def agn_cluster_rds(kind):
    """Canonical RDS output (cluster object) for each agnostic clustering."""
    return os.path.join(agn_outdir(kind), f"{kind}_clusters_optimal.rds")

AGN_CLUSTER_FILES = [agn_cluster_rds(k) for k in AGN_KINDS]

# Tumour neighbourhood paths (used in rule all, so must be defined early)
TUMOUR_NH_ROOT  = os.path.join(UNSUP, "tumour_neighbourhoods")
TUMOUR_NH_INPUT = cfg["paths"]["tumour_nh_input_root"]

# 4 combos we want
COMBOS = [
    ("pam50", "euclidean"),
    ("pam50", "correlation"),
    ("hvg",   "euclidean"),
    ("hvg",   "correlation"),
]

# Method definitions for method-aware evaluation/overlays
METHODS = ["pam50_corr", "pam50_euc", "hvg_corr", "hvg_euc"]

# 4 main directions in TCGA space (for tumour neighbourhoods)
DIRECTIONS = ["pam50_euc", "pam50_corr", "hvg_euc", "hvg_corr"]

# Gene sets for tumour neighbourhoods (kept for backward compatibility if needed)
GENESETS = ["PAM50", "HVG500"]

def dir_to_geneset(direction):
    """Extract gene set from direction: pam50_* -> PAM50, hvg_* -> HVG500"""
    return "PAM50" if direction.startswith("pam50") else "HVG500"

def dir_to_distance(direction):
    """Extract distance from direction: *_euc -> euclidean, *_corr -> correlation"""
    return "euclidean" if direction.endswith("euc") else "correlation"

def cluster_prefix(method):
    """
    Map method → clustering prefix used for metrics filenames.
    """
    if method == "pam50_corr":
        return "BRCA_TCGA_PAM50_CORR"
    elif method == "pam50_euc":
        return "BRCA_TCGA_PAM50_EUC"
    elif method == "hvg_corr":
        return "BRCA_TCGA_HVG_CORR"
    elif method == "hvg_euc":
        return "BRCA_TCGA_HVG_EUC"
    else:
        raise ValueError(f"Unknown method: {method}")

def overlay_prefix(method):
    """
    Map method → overlay prefix used for UMAP PDFs.
    """
    if method == "pam50_corr":
        return "BRCA_TCGA-DSMZ_PAM50_CORR"
    elif method == "pam50_euc":
        return "BRCA_TCGA-DSMZ_PAM50_EUC"
    elif method == "hvg_corr":
        return "BRCA_TCGA-DSMZ_HVG_CORR"
    elif method == "hvg_euc":
        return "BRCA_TCGA-DSMZ_HVG_EUC"
    else:
        raise ValueError(f"Unknown method: {method}")

def combo_outdir(feature, dist):
    return os.path.join(UNSUP, f"{feature}_{dist}")

# ----------------------------------------------------------------------
# 1) HVG feature selection (TCGA+DSMZ VST → scores + HVG list)
# ----------------------------------------------------------------------
rule feature_selection_unsupervised:
    input:
        vst = VST_JOINT,
        cfg_file = "config/config.yaml"
    output:
        scores = cfg["features"]["hvg_joint_scores_tsv"],
        hvg_list = cfg["features"]["hvg_final_gene_list"]
    log:
        "logs/feature_selection_unsupervised.log"
    shell:
        r'''
        Rscript scripts/feature_selection_unsupervised.R \
          --config {input.cfg_file} \
          --vst_rds {input.vst} \
          > {log} 2>&1
        '''

# ----------------------------------------------------------------------
# 2) 4 clustering combos (euclidean/correlation × pam50/hvg)
# ----------------------------------------------------------------------
rule clustering_combo:
    input:
        cfg_file = "config/config.yaml",
        # For pam50, we use the PAM50 list; for hvg, the HVG list from feature selection
        genes = lambda wildcards: (
            cfg["features"]["hvg_final_gene_list"]
            if wildcards.feature_set == "hvg"
            else cfg["features"]["pam50_gene_list"]
        )
    output:
        # No lambda here – use a wildcard pattern instead
        summary = os.path.join(UNSUP, "{feature_set}_{distance}", "DONE.txt")
    params:
        # Also as a wildcard pattern – Snakemake will substitute feature_set & distance
        outdir = os.path.join(UNSUP, "{feature_set}_{distance}")
    log:
        # Again, no lambda: use a wildcard pattern
        "logs/clustering_{feature_set}_{distance}.log"
    wildcard_constraints:
        feature_set = "pam50|hvg",
        distance    = "euclidean|correlation"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/clustering_driver.R \
          --config {input.cfg_file} \
          --feature_set {wildcards.feature_set} \
          --distance {wildcards.distance} \
          --outdir {params.outdir} \
          > {log} 2>&1
        touch {output.summary}
        '''

# ----------------------------------------------------------------------
# 3) Tumour neighbourhoods (DSMZ vs TCGA) across 10 clustering methods
#     - uses comp_tumour_neighbourhoods.R
#     - outputs Top_m_long_*.csv for each method
# ----------------------------------------------------------------------
rule build_tumour_neighbourhood_input_pam50:
    """
    Build integrated DSMZ+TCGA PAM50 matrix + cell_line→original_id mapping
    for tumour neighbourhood analysis.
    """
    input:
        tcga_pam50 = cfg["paths"].get(
            "tcga_brca_pam50_expr",
            cfg["paths"]["tcga_pam50_expr"]
        ),
        dsmz_pam50 = cfg["paths"].get(
            "dsmz_bcc_pam50_expr",
            cfg["paths"]["dsmz_pam50_expr"]
        ),
        dsmz_meta  = cfg["paths"]["dsmz_meta_csv"]
    output:
        expr_rds = cfg["paths"]["tumour_nh_expr_pam50"],
        map_rds  = cfg["paths"]["tumour_nh_map_rds"]
    log:
        "logs/build_tumour_neighbourhood_input_pam50.log"
    shell:
        r'''
        Rscript scripts/build_dsmz_tcga_pam50matrix.R \
          --config config/config.yaml \
          > {log} 2>&1
        '''

rule build_tumour_neighbourhood_input_hvg:
    """
    Build integrated DSMZ+TCGA HVG500 matrix + cell_line→original_id mapping
    for tumour neighbourhood analysis.
    """
    input:
        vst_joint = VST_JOINT,
        hvg_list  = cfg["features"]["hvg_final_gene_list"],
        dsmz_meta = cfg["paths"]["dsmz_meta_csv"],
        # ensure mapping exists (can be from pam50 rule)
        map_rds   = cfg["paths"]["tumour_nh_map_rds"]
    output:
        expr_rds = cfg["paths"]["tumour_nh_expr_hvg"]
    log:
        "logs/build_tumour_neighbourhood_input_hvg.log"
    shell:
        r'''
        Rscript scripts/build_dsmz_tcga_hvgmatrix.R \
          --config config/config.yaml \
          > {log} 2>&1
        '''

rule tumour_neighbourhoods:
    """
    Compute tumour neighbourhoods for a given direction
    (PAM50/HVG500 × EUC/CORR).
    Uses the *same* 10 clustering methods but different embedding matrices.
    """
    input:
        # pick expression matrix based on direction
        expr_rds = lambda wc: (
            cfg["paths"]["tumour_nh_expr_pam50"]
            if dir_to_geneset(wc.direction) == "PAM50"
            else cfg["paths"]["tumour_nh_expr_hvg"]
        ),
        map_rds  = cfg["paths"]["tumour_nh_map_rds"]
    output:
        hc_pam50_dyn = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "HC_PAM50_dynamic",
            "Top_m_long_HC_PAM50_dynamic.csv"
        ),
        hc_pam50_opt = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "HC_PAM50_optimal",
            "Top_m_long_HC_PAM50_optimal.csv"
        ),
        hc_pca_dyn   = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "HC_PCA_dynamic",
            "Top_m_long_HC_PCA_dynamic.csv"
        ),
        hc_pca_opt   = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "HC_PCA_optimal",
            "Top_m_long_HC_PCA_optimal.csv"
        ),
        km_pam50     = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "km_PAM50",
            "Top_m_long_km_PAM50.csv"
        ),
        km_pca       = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "km_PCA",
            "Top_m_long_km_PCA.csv"
        ),
        cons_hc_pam50 = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "consensus_HC_PAM50",
            "Top_m_long_consensus_HC_PAM50.csv"
        ),
        cons_km_pam50 = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "consensus_kmeans_PAM50",
            "Top_m_long_consensus_kmeans_PAM50.csv"
        ),
        cons_hc_pca   = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "consensus_HC_PCA",
            "Top_m_long_consensus_HC_PCA.csv"
        ),
        cons_km_pca   = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "consensus_kmeans_PCA",
            "Top_m_long_consensus_kmeans_PCA.csv"
        )
    log:
        "logs/tumour_neighbourhoods_{direction}.log"
    wildcard_constraints:
        direction = "pam50_euc|pam50_corr|hvg_euc|hvg_corr"
    shell:
        r'''
        Rscript scripts/comp_tumour_neighbourhoods.R \
          --config config/config.yaml \
          --direction {wildcards.direction} \
          > {log} 2>&1
        '''

# ----------------------------------------------------------------------
# 4) Consensus over tumour neighbourhoods
#     - uses compute_p_consensus.R
#     - p_consensus(c, t) across the 10 methods
# ----------------------------------------------------------------------
rule tumour_neighbourhood_p_consensus:
    input:
        rules.tumour_neighbourhoods.output  # all 10 Top_m_long_*.csv for {direction}
    output:
        consensus_rds = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "final_consensus",
            "Final_consensus_tumour_neighbourhoods_{direction}.rds"
        ),
        consensus_csv = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "final_consensus",
            "Final_consensus_tumour_neighbourhoods_{direction}.csv"
        )
    log:
        "logs/tumour_neighbourhood_p_consensus_{direction}.log"
    wildcard_constraints:
        direction = "pam50_euc|pam50_corr|hvg_euc|hvg_corr"
    shell:
        r'''
        Rscript scripts/tumour_neighbourhood_p_consensus.R \
          --config config/config.yaml \
          --direction {wildcards.direction} \
          > {log} 2>&1
        '''

# ----------------------------------------------------------------------
# 5) DSMZ–DSMZ similarity graph from p_consensus
#     - uses compute_dsmz_dsmz_similarity.R
#     - produces similarity matrix + graph outputs
# ----------------------------------------------------------------------
rule dsmz_dsmz_similarity_graph:
    input:
        consensus_rds = os.path.join(
            TUMOUR_NH_ROOT, "{direction}", "final_consensus",
            "Final_consensus_tumour_neighbourhoods_{direction}.rds"
        )
    output:
        sim_mat_rds   = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_matrix_{direction}.rds"),
        sim_pairs_tsv = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_similarity_pairs_{direction}.tsv"),
        edges_tsv     = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_edges_{direction}.tsv"),
        nodes_tsv     = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_summary_{direction}.tsv"),
        nodes_annot   = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_node_annotations_{direction}.tsv"),
        comm_summary  = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_graph_community_summary_{direction}.tsv"),
        comm_table    = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "DSMZ_DSMZ_Louvain_vs_Leiden_community_table_{direction}.tsv"),
        hist_pdf      = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_similarity_histogram_{direction}.pdf"),
        scatter_pdf   = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_p_consensus_cell_scatter_{direction}.pdf"),
        comm_heatmap  = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_Louvain_vs_Leiden_heatmap_{direction}.pdf"),
        graph_leiden  = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Leiden_{direction}.pdf"),
        graph_louvain = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_Louvain_{direction}.pdf"),
        graph_minimal = os.path.join(TUMOUR_NH_ROOT, "{direction}", "final_consensus", "Fig_DSMZ_DSMZ_graph_minimal_{direction}.pdf")
    log:
        "logs/dsmz_dsmz_similarity_graph_{direction}.log"
    wildcard_constraints:
        direction = "pam50_euc|pam50_corr|hvg_euc|hvg_corr"
    shell:
        r'''
        Rscript scripts/compute_dsmz_dsmz_similarity.R \
          --config config/config.yaml \
          --direction {wildcards.direction} \
          > {log} 2>&1
        '''

# ----------------------------------------------------------------------
# 6) 12-way agnostic clustering (PCA/raw × HC/k-means × cell/tumour/integrated)
#     These call the refactored scripts:
#       scripts/pca_hc_cell.R
#       scripts/pca_hc_tumour.R
#       scripts/pca_hc_cell_tumour.R
#       scripts/pca_kmeans_cell.R
#       scripts/pca_kmeans_tumour.R
#       scripts/pca_kmeans_cell_tumour.R
#       scripts/hc_cell.R
#       scripts/hc_tumour.R
#       scripts/hc_cell_tumour.R
#       scripts/kmeans_cell.R
#       scripts/kmeans_tumour.R
#       scripts/kmeans_cell_tumour.R
# ----------------------------------------------------------------------

# ---- PCA + HC ----

rule pca_hc_cell:
    input:
        cell = CELL_VST
    output:
        clusters = agn_cluster_rds("pca_hc_cell")
    params:
        outdir   = agn_outdir("pca_hc_cell"),
        base_dir = AGN_BASE_FUN,
        n_pcs    = AGN_N_PCS,
        max_k    = AGN_MAX_K_HC,
        dist     = AGN_DIST,
        seed     = AGN_SEED
    log:
        "logs/agnostic_pca_hc_cell.log"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_cell.R \
          --cell_rds {input.cell} \
          --outdir {params.outdir} \
          --base_dir {params.base_dir} \
          --label CELL \
          --n_pcs {params.n_pcs} \
          --max_k {params.max_k} \
          --dist_method {params.dist} \
          --seed {params.seed} \
          --cluster_rds {output.clusters} \
          > {log} 2>&1
        '''

rule pca_hc_tumour:
    input:
        tumour = TUMOUR_VST
    output:
        clusters = agn_cluster_rds("pca_hc_tumour")
    params:
        outdir   = agn_outdir("pca_hc_tumour"),
        base_dir = AGN_BASE_FUN,
        n_pcs    = AGN_N_PCS,
        max_k    = AGN_MAX_K_HC,
        dist     = AGN_DIST,
        seed     = AGN_SEED
    log:
        "logs/agnostic_pca_hc_tumour.log"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_tumour.R \
          --tumour_rds {input.tumour} \
          --outdir {params.outdir} \
          --base_dir {params.base_dir} \
          --label TUMOUR \
          --n_pcs {params.n_pcs} \
          --max_k {params.max_k} \
          --dist_method {params.dist} \
          --seed {params.seed} \
          --cluster_rds {output.clusters} \
          > {log} 2>&1
        '''

rule pca_hc_cell_tumour:
    input:
        cell   = CELL_VST,
        tumour = TUMOUR_VST
    output:
        clusters = agn_cluster_rds("pca_hc_cell_tumour")
    params:
        outdir      = agn_outdir("pca_hc_cell_tumour"),
        base_dir    = AGN_BASE_FUN,
        n_pcs       = AGN_N_PCS,
        max_k       = AGN_MAX_K_HC,
        dist        = AGN_DIST,
        seed        = AGN_SEED,
        cell_label   = "CELL",
        tumour_label = "TUMOUR"
    log:
        "logs/agnostic_pca_hc_cell_tumour.log"
    shell:
        r'''
        mkdir -p {params.outdir}
        Rscript scripts/pca_hc_cell_tumour.R \
          --cell_rds {input.cell} \
          --tumour_rds {input.tumour} \
          --outdir {params.outdir} \
          --base_dir {params.base_dir} \
          --cell_label {params.cell_label} \
          --tumour_label {params.tumour_label} \
          --n_pcs {params.n_pcs} \
          --max_k {params.max_k} \
          --dist_method {params.dist} \
          --seed {params.seed} \
          --cluster_rds {output.clusters} \
          > {log} 2>&1
        '''

