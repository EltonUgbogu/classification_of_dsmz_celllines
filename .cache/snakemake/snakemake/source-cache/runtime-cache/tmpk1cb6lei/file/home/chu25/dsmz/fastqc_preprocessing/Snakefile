#!/usr/bin/env snakemake
# =============================================================================
# RNA-seq preprocessing pipeline (paired-end) — merged from dsmz/others Snakefiles
#
# Scientific scope:
#   - Read-level QC using FastQC
#   - Splice-aware alignment using STAR (2-pass) + GeneCounts
#   - Alignment-level QC using Picard metrics
#   - Cohort-level QC aggregation using MultiQC
#
# Primary inputs:
#   - config/samples.tsv  (sample, r1, r2; r1/r2 may be comma-separated for multi-lane)
#   - config/config.yaml  (STAR index, reference FASTA, Picard jar, threads)
#
# Output layout (all under data/dsmz for consistency):
#   FastQC:  /home/chu25/data/dsmz/fastqc/valid_fastqc/
#   STAR:    /home/chu25/data/dsmz/star/  (BAM, BAI, Log) + .../count_data/ (ReadsPerGene.out.tab)
#   Picard:  /home/chu25/data/dsmz/picard/
#   MultiQC: /home/chu25/data/dsmz/multiqc/
# Logs remain under this workflow dir: logs/
# =============================================================================

import os
import pandas as pd

# -----------------------------------------------------------------------------
# Output directories (all DSMZ outputs under data/dsmz)
# -----------------------------------------------------------------------------
DATA_ROOT = "/home/chu25/data/dsmz"
STAR_ROOT = DATA_ROOT + "/star"
FASTQC_DIR = DATA_ROOT + "/fastqc/valid_fastqc"
STAR_COUNT_DIR = STAR_ROOT + "/count_data"

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
configfile: "config/config.yaml"

THREADS    = int(config.get("threads", 12))
STAR_INDEX = config["genome"]["star_index"]
REF_FASTA  = config["genome"]["fasta"]
GTF        = config["genome"].get("gtf", "")
PICARD_JAR = os.path.expanduser(config.get("tools", {}).get("picard_jar", "~/tools/picard/picard.jar"))

# -----------------------------------------------------------------------------
# Sample sheet (paired-end; supports multi-lane)
# -----------------------------------------------------------------------------
SAMPLES_PATH = os.path.join(workflow.basedir, "config", "samples.tsv")
SAMPLES_DF = pd.read_csv(SAMPLES_PATH, sep="\t")
if not {"sample", "r1", "r2"}.issubset(set(SAMPLES_DF.columns)):
    raise ValueError("config/samples.tsv must contain columns: sample, r1, r2")

SAMPLES = dict(sorted(SAMPLES_DF.set_index("sample").T.to_dict().items()))
SAMPLE_IDS = list(SAMPLES.keys())

# -----------------------------------------------------------------------------
# Helpers: parse lanes, validate existence, produce STAR-ready strings
# -----------------------------------------------------------------------------
def _split_csv_paths(x):
    return [p.strip() for p in str(x).split(",") if p.strip()]

def _require_files_exist(sample, paths, label):
    missing = [p for p in paths if not os.path.exists(p)]
    if missing:
        raise FileNotFoundError(
            f"[INPUT] Missing {label} FASTQ file(s) for sample '{sample}':\n  " + "\n  ".join(missing)
        )

def get_r1_star(wc):
    r1_list = _split_csv_paths(SAMPLES[wc.sample]["r1"])
    _require_files_exist(wc.sample, r1_list, "R1")
    return ",".join(r1_list)

def get_r2_star(wc):
    r2_list = _split_csv_paths(SAMPLES[wc.sample]["r2"])
    _require_files_exist(wc.sample, r2_list, "R2")
    return ",".join(r2_list)

def get_all_fastqs(wc):
    r1_list = _split_csv_paths(SAMPLES[wc.sample]["r1"])
    r2_list = _split_csv_paths(SAMPLES[wc.sample]["r2"])
    _require_files_exist(wc.sample, r1_list, "R1")
    _require_files_exist(wc.sample, r2_list, "R2")
    return r1_list + r2_list

# -----------------------------------------------------------------------------
# Final targets
# -----------------------------------------------------------------------------
rule all:
    input:
        # STAR alignment + indexing + counts (data/dsmz/star/ and .../star/count_data/)
        expand(STAR_ROOT + "/{sample}.Aligned.sortedByCoord.out.bam", sample=SAMPLE_IDS),
        expand(STAR_ROOT + "/{sample}.Aligned.sortedByCoord.out.bam.bai", sample=SAMPLE_IDS),
        expand(STAR_COUNT_DIR + "/{sample}.ReadsPerGene.out.tab", sample=SAMPLE_IDS),
        expand(STAR_ROOT + "/{sample}.Log.final.out", sample=SAMPLE_IDS),
        # FastQC completion markers (data/dsmz/fastqc/)
        expand(DATA_ROOT + "/fastqc/{sample}.fastqc.done", sample=SAMPLE_IDS),
        # Picard metrics
        expand(DATA_ROOT + "/picard/{sample}_validate_samfile.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_alignment_summary_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_quality_yield_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_insert_size_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_insert_size_histogram.pdf", sample=SAMPLE_IDS),
        # MultiQC
        DATA_ROOT + "/multiqc/multiqc_report.html"

# -----------------------------------------------------------------------------
# FastQC
# -----------------------------------------------------------------------------
rule fastqc:
    input:
        fq = get_all_fastqs
    output:
        done = DATA_ROOT + "/fastqc/{sample}.fastqc.done"
    log:
        "logs/fastqc/{sample}.log"
    params:
        fastqc_dir = FASTQC_DIR,
        data_root = DATA_ROOT
    conda:
        "../envs/fastqc.yaml"
    threads: 2
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.fastqc_dir} {params.data_root}/fastqc logs/fastqc

        fastqc --threads {threads} --outdir {params.fastqc_dir} {input.fq} > {log} 2>&1

        touch {output.done}
        """

# -----------------------------------------------------------------------------
# STAR 2-pass alignment + GeneCounts
# -----------------------------------------------------------------------------
rule star_2pass:
    input:
        index = STAR_INDEX,
        r1 = get_r1_star,
        r2 = get_r2_star,
        fq_done = DATA_ROOT + "/fastqc/{sample}.fastqc.done"
    output:
        bam    = STAR_ROOT + "/{sample}.Aligned.sortedByCoord.out.bam",
        bai    = STAR_ROOT + "/{sample}.Aligned.sortedByCoord.out.bam.bai",
        counts = STAR_COUNT_DIR + "/{sample}.ReadsPerGene.out.tab",
        logf   = STAR_ROOT + "/{sample}.Log.final.out"
    log:
        "logs/star/{sample}.log"
    benchmark:
        "logs/benchmarks/star/{sample}.tsv"
    conda:
        "envs/star.yaml"
    threads: THREADS
    resources:
        mem_mb = 42000
    params:
        prefix = lambda wc: STAR_ROOT + "/" + wc.sample + ".",
        star_root = STAR_ROOT,
        star_count_dir = STAR_COUNT_DIR
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.star_root} {params.star_count_dir} logs/star logs/benchmarks/star

        STAR --genomeDir "{input.index}" \
             --readFilesIn "{input.r1}" "{input.r2}" \
             --readFilesCommand zcat \
             --outFileNamePrefix "{params.prefix}" \
             --outSAMtype BAM SortedByCoordinate \
             --quantMode GeneCounts \
             --twopassMode Basic \
             --runThreadN {threads} \
             --limitBAMsortRAM 32000000000 \
             > "{log}" 2>&1

        samtools index "{output.bam}"

        mv -f "{params.prefix}ReadsPerGene.out.tab" "{output.counts}"
        """

# -----------------------------------------------------------------------------
# Picard QC (alignment-level metrics)
# -----------------------------------------------------------------------------
rule picard_validate_samfile:
    input:
        bam = rules.star_2pass.output.bam,
        ref = REF_FASTA
    output:
        DATA_ROOT + "/picard/{sample}_validate_samfile.txt"
    log:
        "logs/picard/{sample}_validate_samfile.log"
    conda:
        "../envs/picard.yaml"
    params:
        jar = PICARD_JAR,
        data_root = DATA_ROOT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.data_root}/picard logs/picard
        java -Xmx8g -jar {params.jar} ValidateSamFile \
            I="{input.bam}" O="{output}" MODE=SUMMARY REFERENCE_SEQUENCE="{input.ref}" \
            > "{log}" 2>&1 || true
        """

rule picard_alignment_summary_metrics:
    input:
        bam = rules.star_2pass.output.bam,
        ref = REF_FASTA
    output:
        DATA_ROOT + "/picard/{sample}_alignment_summary_metrics.txt"
    log:
        "logs/picard/{sample}_alignment_summary_metrics.log"
    conda:
        "../envs/picard.yaml"
    params:
        jar = PICARD_JAR,
        data_root = DATA_ROOT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.data_root}/picard logs/picard
        java -jar {params.jar} CollectAlignmentSummaryMetrics \
            R="{input.ref}" I="{input.bam}" O="{output}" > "{log}" 2>&1
        """

rule picard_quality_yield_metrics:
    input:
        bam = rules.star_2pass.output.bam
    output:
        DATA_ROOT + "/picard/{sample}_quality_yield_metrics.txt"
    log:
        "logs/picard/{sample}_quality_yield_metrics.log"
    conda:
        "../envs/picard.yaml"
    params:
        jar = PICARD_JAR,
        data_root = DATA_ROOT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.data_root}/picard logs/picard
        java -jar {params.jar} CollectQualityYieldMetrics \
            I="{input.bam}" O="{output}" > "{log}" 2>&1
        """

rule picard_insert_size_metrics:
    input:
        bam = rules.star_2pass.output.bam,
        ref = REF_FASTA
    output:
        metrics = DATA_ROOT + "/picard/{sample}_insert_size_metrics.txt",
        hist    = DATA_ROOT + "/picard/{sample}_insert_size_histogram.pdf"
    log:
        "logs/picard/{sample}_insert_size_metrics.log"
    conda:
        "../envs/picard.yaml"
    params:
        jar = PICARD_JAR,
        data_root = DATA_ROOT
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.data_root}/picard logs/picard
        java -jar {params.jar} CollectInsertSizeMetrics \
            I="{input.bam}" O="{output.metrics}" H="{output.hist}" \
            M=0.5 R="{input.ref}" VALIDATION_STRINGENCY=LENIENT > "{log}" 2>&1
        """

# -----------------------------------------------------------------------------
# MultiQC (aggregate FastQC + STAR + Picard)
# -----------------------------------------------------------------------------
rule multiqc:
    input:
        expand(DATA_ROOT + "/fastqc/{sample}.fastqc.done", sample=SAMPLE_IDS),
        expand(STAR_ROOT + "/{sample}.Log.final.out", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_insert_size_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_alignment_summary_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_quality_yield_metrics.txt", sample=SAMPLE_IDS),
        expand(DATA_ROOT + "/picard/{sample}_validate_samfile.txt", sample=SAMPLE_IDS)
    output:
        html = DATA_ROOT + "/multiqc/multiqc_report.html"
    log:
        "logs/multiqc/multiqc.log"
    params:
        data_root = DATA_ROOT
    conda:
        "../envs/multiqc.yaml"
    threads: 2
    shell:
        r"""
        set -euo pipefail
        mkdir -p {params.data_root}/multiqc logs/multiqc

        multiqc {params.data_root} -o {params.data_root}/multiqc -n multiqc_report.html > "{log}" 2>&1
        """
