        meta = os.path.join(
            UNSUP,
            "inductive_tcga",
            "consensusclustering",
            "km_tcga",
            "BRCA_TCGA_PAM50_km_best_k.tsv"
        )
    log:
        "logs/km_tcga_consensus.log"
    shell:
        r'''
        Rscript scripts/km_tcga_consensusclustering.R \
          > {log} 2>&1
        '''

